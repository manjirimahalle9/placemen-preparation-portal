    <!-- ==========================================
         BOTTOM BUTTONS
    =========================================== -->

    <div class="text-center mt-4 mb-5 bottom-buttons">


        <button
            onclick="completeTopic()"
            class="btn complete-btn btn-lg">

            ✅ Complete Today's Task

        </button>


        <a
            href="/aptitude"
            class="btn back-btn btn-lg ms-2">

            ⬅ Back to Aptitude

        </a>


    </div>


</div>


<!-- ==========================================
     BOOTSTRAP JAVASCRIPT
=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>


/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "162.5 units",

    2: "100 employees",

    3: "Year 3",

    4: "360 students",

    5: "25%",

    6: "100 employees",

    7: "₹30 lakh",

    8: "₹4,00,000",

    9: "80%",

    10: "200 people"

};


const explanations = {

    1:
        "Calculation: (120 + 150 + 180 + 200) ÷ 4 = 162.5 units.",

    2:
        "Calculation: 25% of 400 = (25 ÷ 100) × 400 = 100 employees.",

    3:
        "Year 3 has the highest production because 800 units is greater than 500 and 700 units.",

    4:
        "Calculation: 120 + 100 + 80 + 60 = 360 students.",

    5:
        "Increase = ₹50,000 - ₹40,000 = ₹10,000. Percentage increase = (10,000 ÷ 40,000) × 100 = 25%.",

    6:
        "Male : Female = 3 : 2. If 3 parts = 150, then 1 part = 50. Female = 2 × 50 = 100 employees.",

    7:
        "Average = (20 + 25 + 30 + 35 + 40) ÷ 5 = ₹30 lakh.",

    8:
        "40% of ₹10,00,000 = (40 ÷ 100) × 10,00,000 = ₹4,00,000.",

    9:
        "Increase = 90 - 50 = 40. Percentage increase = (40 ÷ 50) × 100 = 80%.",

    10:
        "Cricket + Football = 45% + 30% = 75%. Remaining = 25%. 25% of 800 = 200 people."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    const button =
        result.previousElementSibling;


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK QUESTION AS ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];


    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const buttons =
        document.querySelectorAll(
            ".submit-question"
        );


    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;


    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    /* ---------------------------------------------
       SHOW SCORE
    --------------------------------------------- */

    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    /* ---------------------------------------------
       SCORE MESSAGE
    --------------------------------------------- */

    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Data Interpretation skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing DI questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    /* ---------------------------------------------
       SCROLL TO SCORE
    --------------------------------------------- */

    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    const topic =
        "Data Interpretation";


    /* ---------------------------------------------
       ALREADY COMPLETED TODAY
    --------------------------------------------- */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTopics[topic] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE TO LOCAL STORAGE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Data Interpretation completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}


</script>


</body>

</html>
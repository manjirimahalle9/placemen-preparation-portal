    <!-- ==========================================
         TOPIC DEFINITIONS
    =========================================== -->

    <h4>

        📖 Topic Definitions

    </h4>


    <div class="accordion"
         id="diTopics">


        <!-- TABLE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#tableTopic">

                    1. Tables

                </button>

            </h2>


            <div
                id="tableTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Tables organize data into rows and columns,
                    making it easier to compare values.

                </div>

            </div>

        </div>


        <!-- BAR GRAPH -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#barTopic">

                    2. Bar Graph

                </button>

            </h2>


            <div
                id="barTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Bar graphs compare quantities using
                    rectangular bars of different heights.

                </div>

            </div>

        </div>


        <!-- PIE CHART -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#pieTopic">

                    3. Pie Chart

                </button>

            </h2>


            <div
                id="pieTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Pie charts display data as parts of a whole
                    using sectors of a circle.

                </div>

            </div>

        </div>


        <!-- LINE GRAPH -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#lineTopic">

                    4. Line Graph

                </button>

            </h2>


            <div
                id="lineTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Line graphs show trends and changes in

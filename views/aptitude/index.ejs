    <!-- =================================================
         HORIZONTAL SLIDER JAVASCRIPT
    ================================================= -->

    <script>

        const topicTrack =
            document.querySelector(".topic-track");


        const topicCards =
            document.querySelectorAll(".flip-card");


        const topicStream =
            document.querySelector(".topic-stream");


        let currentPosition = 0;


        /*
         * Card width = 260px
         * Gap = 18px
         * Total movement = 278px
         */

        function getCardStep() {

            const firstCard =
                topicCards[0];

            if (!firstCard) {
                return 278;
            }

            const cardStyle =
                window.getComputedStyle(firstCard);

            const cardWidth =
                firstCard.getBoundingClientRect().width;

            const gap =
                parseFloat(
                    window.getComputedStyle(topicTrack).gap
                ) || 18;

            return cardWidth + gap;
        }


        function moveTopics(direction) {

            if (!topicTrack || !topicStream) {
                return;
            }


            const visibleWidth =
                topicStream.clientWidth;


            const totalWidth =
                topicTrack.scrollWidth;


            const maxPosition =
                Math.max(
                    0,
                    totalWidth - visibleWidth
                );


            const cardStep =
                getCardStep();


            currentPosition +=
                direction * cardStep;


            if (currentPosition < 0) {

                currentPosition = 0;

            }


            if (currentPosition > maxPosition) {

                currentPosition =
                    maxPosition;

            }


            topicTrack.style.transform =
                `translateX(-${currentPosition}px)`;

        }


        /* =================================================
           MOUSE WHEEL HORIZONTAL MOVEMENT
        ================================================= */

        topicStream.addEventListener(
            "wheel",
            function(event) {

                if (
                    Math.abs(event.deltaY) >
                    Math.abs(event.deltaX)
                ) {

                    event.preventDefault();


                    moveTopics(
                        event.deltaY > 0
                            ? 1
                            : -1
                    );

                }

            },
            {
                passive: false
            }
        );


        /* =================================================
           TOUCH SWIPE SUPPORT
        ================================================= */

        let touchStartX = 0;

        let touchEndX = 0;


        topicStream.addEventListener(
            "touchstart",
            function(event) {

                touchStartX =
                    event.touches[0].clientX;

            },
            {
                passive: true
            }
        );


        topicStream.addEventListener(
            "touchend",
            function(event) {

                touchEndX =
                    event.changedTouches[0].clientX;


                const difference =
                    touchStartX - touchEndX;


                if (
                    Math.abs(difference) > 50
                ) {

                    if (difference > 0) {

                        moveTopics(1);

                    } else {

                        moveTopics(-1);

                    }

                }

            },
            {
                passive: true
            }
        );


        /* =================================================
           WINDOW RESIZE
        ================================================= */

        window.addEventListener(
            "resize",
            function() {

                if (!topicTrack || !topicStream) {
                    return;
                }


                const visibleWidth =
                    topicStream.clientWidth;


                const totalWidth =
                    topicTrack.scrollWidth;


                const maxPosition =
                    Math.max(
                        0,
                        totalWidth - visibleWidth
                    );


                if (
                    currentPosition >
                    maxPosition
                ) {

                    currentPosition =
                        maxPosition;

                    topicTrack.style.transform =
                        `translateX(-${currentPosition}px)`;

                }

            }
        );

    </script>



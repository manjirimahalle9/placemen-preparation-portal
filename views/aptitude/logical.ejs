    <script>


        /* =================================================
           SCORE VARIABLES
        ================================================= */

        let score = 0;

        let answeredQuestions = new Set();


        /* =================================================
           ANSWERS
        ================================================= */

        const answerText = {

            1: "C) 11",

            2: "B) 6",

            3: "C) 12",

            4: "B) 135",

            5: "C) 6",

            6: "B) 2",

            7: "D) 15",

            8: "C) 24",

            9: "C) 275",

            10: "B) 18 and 24"

        };


        /* =================================================
           EXPLANATIONS
        ================================================= */

        const explanations = {

            1:
                "11 is a prime number because it has exactly two factors: 1 and 11.",


            2:
                "Factors of 12 are 1, 2, 3, 4, 6, 12 and factors of 18 are 1, 2, 3, 6, 9, 18. The highest common factor is 6.",


            3:
                "Multiples of 4 are 4, 8, 12, 16... and multiples of 6 are 6, 12, 18... Therefore, the LCM is 12.",


            4:
                "For divisibility by 3, the sum of digits must be divisible by 3. 1 + 3 + 5 = 9, so 135 is divisible by 3.",


            5:
                "The factors of 12 are 1, 2, 3, 4, 6 and 12. Therefore, 12 has 6 factors.",


            6:
                "17 = 5 × 3 + 2. Therefore, the remainder is 2.",


            7:
                "15 is composite because it has more than two factors: 1, 3, 5 and 15.",


            8:
                "The multiples of 8 include 8, 16, 24... and multiples of 12 include 12, 24... Therefore, the LCM is 24.",


            9:
                "A number is divisible by 5 when its last digit is 0 or 5. 275 ends in 5, so it is divisible by 5.",


            10:
                "For 18 and 24, HCF = 6 and LCM = 72. Therefore, 18 and 24 satisfy both conditions."

        };


        /* =================================================
           CHECK INDIVIDUAL ANSWER
        ================================================= */

        function checkAnswer(questionNumber, correctAnswer) {


            const selected = document.querySelector(
                `input[name="q${questionNumber}"]:checked`
            );


            const result = document.getElementById(
                `result${questionNumber}`
            );


            /* ---------------------------------------------
               NO OPTION SELECTED
            --------------------------------------------- */

            if (!selected) {

                result.style.display = "block";

                result.className =
                    "answer-result wrong-result";

                result.innerHTML =
                    "⚠️ <strong>Please select an option first.</strong>";

                return;

            }


            /* ---------------------------------------------
               ALREADY ANSWERED
            --------------------------------------------- */

            if (answeredQuestions.has(questionNumber)) {

                result.style.display = "block";

                result.className =
                    "answer-result correct-result";

                result.innerHTML =
                    "ℹ️ <strong>This question has already been submitted.</strong>";

                return;

            }


            /* ---------------------------------------------
               MARK AS ANSWERED
            --------------------------------------------- */

            answeredQuestions.add(questionNumber);


            /* ---------------------------------------------
               CHECK CORRECT ANSWER
            --------------------------------------------- */

            if (selected.value === correctAnswer) {

                score++;

                result.style.display = "block";

                result.className =
                    "answer-result correct-result";

                result.innerHTML =

                    "✅ <strong>Correct Answer!</strong><br><br>" +

                    "Your answer: <strong>" +
                    answerText[questionNumber] +
                    "</strong><br><br>" +

                    "💡 " +
                    explanations[questionNumber];

            }


            /* ---------------------------------------------
               WRONG ANSWER
            --------------------------------------------- */

            else {

                result.style.display = "block";

                result.className =
                    "answer-result wrong-result";

                result.innerHTML =

                    "❌ <strong>Incorrect Answer!</strong><br><br>" +

                    "Your answer: <strong>" +
                    selected.parentElement.textContent.trim() +
                    "</strong><br><br>" +

                    "✅ Correct Answer: <strong>" +
                    answerText[questionNumber] +
                    "</strong><br><br>" +

                    "💡 " +
                    explanations[questionNumber];

            }


            /* ---------------------------------------------
               DISABLE OPTIONS
            --------------------------------------------- */

            const options = document.querySelectorAll(
                `input[name="q${questionNumber}"]`
            );


            options.forEach(function(option) {

                option.disabled = true;

                option.parentElement.classList.add(
                    "disabled-option"
                );

            });


            /* ---------------------------------------------
               DISABLE CURRENT BUTTON
            --------------------------------------------- */

            const currentCard =
                result.closest(".question-card");


            const currentButton =
                currentCard.querySelector(
                    ".submit-question"
                );


            currentButton.disabled = true;

            currentButton.innerText =
                "✓ Answer Submitted";

        }


        /* =================================================
           CALCULATE FINAL SCORE
        ================================================= */

        function calculateScore() {


            const finalScore =
                document.getElementById(
                    "finalScore"
                );


            const scoreText =
                document.getElementById(
                    "scoreText"
                );


            const scoreMessage =
                document.getElementById(
                    "scoreMessage"
                );


            const attempted =
                answeredQuestions.size;


            /* ---------------------------------------------
               SHOW SCORE
            --------------------------------------------- */

            finalScore.style.display = "block";


            scoreText.innerHTML =
                "Your Score: " +
                score +
                " / 10";


            /* ---------------------------------------------
               SCORE MESSAGE
            --------------------------------------------- */

            if (attempted === 0) {

                scoreMessage.innerHTML =
                    "⚠️ Please attempt the questions before checking your score.";

            }

            else if (attempted < 10) {

                scoreMessage.innerHTML =
                    "📝 You attempted " +
                    attempted +
                    " out of 10 questions. Attempt all questions for a complete test.";

            }

            else if (score === 10) {

                scoreMessage.innerHTML =
                    "🏆 Excellent! You got all 10 questions correct!";

            }

            else if (score >= 8) {

                scoreMessage.innerHTML =
                    "🌟 Great job! Your Number System skills are strong.";

            }

            else if (score >= 5) {

                scoreMessage.innerHTML =
                    "👍 Good attempt! Keep practicing Number System questions.";

            }

            else {

                scoreMessage.innerHTML =
                    "📚 Keep practicing. Review the explanations and try again.";

            }


            /* ---------------------------------------------
               SCROLL TO SCORE
            --------------------------------------------- */

            finalScore.scrollIntoView({

                behavior: "smooth",

                block: "center"

            });

        }


        /* =================================================
           COLLAPSIBLE TOPICS
        ================================================= */

        function toggleTopic(element) {


            const content =
                element.nextElementSibling;


            const isOpen =
                content.style.display === "block";


            /* ---------------------------------------------
               CLOSE ALL TOPICS
            --------------------------------------------- */

            document
                .querySelectorAll(".definition-content")
                .forEach(function(item) {

                    item.style.display = "none";

                });


            document
                .querySelectorAll(".topic-title")
                .forEach(function(item) {

                    item.classList.remove("active");

                });


            /* ---------------------------------------------
               OPEN SELECTED TOPIC
            --------------------------------------------- */

            if (!isOpen) {

                content.style.display = "block";

                element.classList.add("active");

            }

        }


        /* =================================================
           COMPLETE TOPIC
        ================================================= */

        function completeTopic() {


            const today =
                new Date().toDateString();


            let progress =
                JSON.parse(
                    localStorage.getItem(
                        "placementProgress"
                    )
                ) || {

                    streak: 0,

                    lastCompleted: "",

                    completedTopics: {}

                };


            const topic =
                "Number System";


            /* ---------------------------------------------
               ALREADY COMPLETED TODAY
            --------------------------------------------- */

            if (
                progress.completedTopics[topic]
                === today
            ) {

                alert(
                    "✅ You already completed this task today!"
                );

                return;

            }


            /* ---------------------------------------------
               SAVE COMPLETION
            --------------------------------------------- */

            progress.completedTopics[topic] =
                today;


            /* ---------------------------------------------
               UPDATE STREAK
            --------------------------------------------- */

            if (
                progress.lastCompleted
                !== today
            ) {

                progress.streak++;

                progress.lastCompleted =
                    today;

            }


            /* ---------------------------------------------
               SAVE LOCAL STORAGE
            --------------------------------------------- */

            localStorage.setItem(

                "placementProgress",

                JSON.stringify(progress)

            );


            /* ---------------------------------------------
               SUCCESS MESSAGE
            --------------------------------------------- */

            alert(

                "🎉 Number System completed!\n\n" +

                "🔥 Streak: " +

                progress.streak +

                " day(s)"

            );


            /* ---------------------------------------------
               DASHBOARD
            --------------------------------------------- */

            window.location.href =
                "/dashboard";

        }


    </script>


</body>

</html>

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>


/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "50",

    2: "20%",

    3: "80%",

    4: "₹23,000",

    5: "20%",

    6: "32%",

    7: "90%",

    8: "1,10,000",

    9: "25%",

    10: "₹800"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "Calculation: 25% of 200 = (25 ÷ 100) × 200 = 50.",


    2:
        "Increase = 120 - 100 = 20. Percentage increase = (20 ÷ 100) × 100 = 20%.",


    3:
        "Percentage = (80 ÷ 100) × 100 = 80%.",


    4:
        "15% of ₹20,000 = ₹3,000. New salary = ₹20,000 + ₹3,000 = ₹23,000.",


    5:
        "Decrease = ₹500 - ₹400 = ₹100. Percentage decrease = (100 ÷ 500) × 100 = 20%.",


    6:
        "Net increase = 20 + 10 + (20 × 10 ÷ 100) = 32%.",


    7:
        "Percentage = (450 ÷ 500) × 100 = 90%.",


    8:
        "10% of 1,00,000 = 10,000. New population = 1,00,000 + 10,000 = 1,10,000.",


    9:
        "Increase = ₹1,00,000 - ₹80,000 = ₹20,000. Percentage increase = (20,000 ÷ 80,000) × 100 = 25%.",


    10:
        "Discount = 20% of ₹1,000 = ₹200. Selling price = ₹1,000 - ₹200 = ₹800."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK QUESTION AS ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];


    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE CURRENT BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;


    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    /* ---------------------------------------------
       SHOW SCORE
    --------------------------------------------- */

    finalScore.style.display = "block";


    scoreText.innerHTML =

        "Your Score: " +

        score +

        " / 10";


    /* ---------------------------------------------
       SCORE MESSAGE
    --------------------------------------------- */

    if (score === 10) {

        scoreMessage.innerHTML =

            "🏆 Excellent! You got all 10 questions correct!";

    }


    else if (score >= 8) {

        scoreMessage.innerHTML =

            "🌟 Great job! Your Percentage skills are strong.";

    }


    else if (score >= 5) {

        scoreMessage.innerHTML =

            "👍 Good attempt! Keep practicing percentage questions.";

    }


    else {

        scoreMessage.innerHTML =

            "📚 Keep practicing. Review the explanations and try again.";

    }


    /* ---------------------------------------------
       SCROLL TO SCORE
    --------------------------------------------- */

    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    const topic =
        "Percentage";


    /* ---------------------------------------------
       ALREADY COMPLETED TODAY
    --------------------------------------------- */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTopics[topic] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE TO LOCAL STORAGE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Percentage completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}


</script>



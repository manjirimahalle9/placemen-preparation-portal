     BOOTSTRAP JAVASCRIPT
=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>


/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "₹100",

    2: "₹100",

    3: "20%",

    4: "15%",

    5: "₹800",

    6: "₹2,300",

    7: "₹1,500",

    8: "₹250",

    9: "20%",

    10: "₹1,440"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "Profit = SP − CP = ₹600 − ₹500 = ₹100.",


    2:
        "Loss = CP − SP = ₹1,000 − ₹900 = ₹100.",


    3:
        "Profit = ₹600 − ₹500 = ₹100. Profit % = (100 ÷ 500) × 100 = 20%.",


    4:
        "Loss = ₹800 − ₹680 = ₹120. Loss % = (120 ÷ 800) × 100 = 15%.",


    5:
        "Discount = 20% of ₹1,000 = ₹200. Selling Price = ₹1,000 − ₹200 = ₹800.",


    6:
        "Profit = 15% of ₹2,000 = ₹300. Selling Price = ₹2,000 + ₹300 = ₹2,300.",


    7:
        "A 20% loss means SP = 80% of CP. Therefore CP = ₹1,200 ÷ 0.80 = ₹1,500.",


    8:
        "Discount = 10% of ₹2,500 = (10 ÷ 100) × ₹2,500 = ₹250.",


    9:
        "Profit = ₹1,800 − ₹1,500 = ₹300. Profit % = (300 ÷ 1,500) × 100 = 20%.",


    10:
        "First discount: ₹2,000 × 80% = ₹1,600. Second discount: ₹1,600 × 90% = ₹1,440."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK QUESTION AS ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE CURRENT BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;


    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    /* ---------------------------------------------
       SHOW SCORE
    --------------------------------------------- */

    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    /* ---------------------------------------------
       SCORE MESSAGE
    --------------------------------------------- */

    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Profit and Loss skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Profit and Loss questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    /* ---------------------------------------------
       SCROLL TO SCORE
    --------------------------------------------- */

    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    const topic =
        "Profit and Loss";


    /* ---------------------------------------------
       ALREADY COMPLETED TODAY
    --------------------------------------------- */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTopics[topic] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE TO LOCAL STORAGE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Profit and Loss completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}


</script>



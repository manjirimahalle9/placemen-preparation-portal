    <!-- ==========================================
         TOPIC DEFINITIONS
    =========================================== -->

    <h4>

        📖 Topic Definitions

    </h4>


    <div class="accordion"
         id="profitLossTopics">


        <!-- COST PRICE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#cpTopic">

                    1. Cost Price (CP)

                </button>

            </h2>


            <div
                id="cpTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Cost Price (CP) is the price at which
                    an item is purchased.

                    <br><br>

                    <strong>Example:</strong>

                    If a shopkeeper buys an item for ₹500,
                    then CP = ₹500.

                </div>

            </div>

        </div>


        <!-- SELLING PRICE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#spTopic">

                    2. Selling Price (SP)

                </button>

            </h2>


            <div
                id="spTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Selling Price (SP) is the price at which
                    an item is sold to the customer.

                    <br><br>

                    <strong>Example:</strong>

                    If an item is sold for ₹600,
                    then SP = ₹600.

                </div>

            </div>

        </div>


        <!-- PROFIT -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#profitTopic">

                    3. Profit

                </button>

            </h2>


            <div
                id="profitTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Profit occurs when the Selling Price
                    is greater than the Cost Price.

                    <br><br>

                    <strong>Formula:</strong>

                    Profit = SP − CP

                    <br><br>

                    <strong>Profit Percentage:</strong>

                    Profit % = (Profit / CP) × 100

                </div>

            </div>

        </div>


        <!-- LOSS -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#lossTopic">

                    4. Loss

                </button>

            </h2>


            <div
                id="lossTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Loss occurs when the Selling Price
                    is less than the Cost Price.

                    <br><br>

                    <strong>Formula:</strong>

                    Loss = CP − SP

                    <br><br>

                    <strong>Loss Percentage:</strong>

                    Loss % = (Loss / CP) × 100

                </div>

            </div>

        </div>


        <!-- PROFIT PERCENTAGE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#profitPercentTopic">

                    5. Profit Percentage

                </button>

            </h2>


            <div
                id="profitPercentTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Profit percentage represents the profit
                    earned as a percentage of the Cost Price.

                    <br><br>

                    <strong>Formula:</strong>

                    Profit % =

                    (Profit / CP) × 100

                    <br><br>

                    <strong>Example:</strong>

                    CP = ₹500 and SP = ₹600.

                    Profit = ₹100.

                    Profit % = (100 / 500) × 100 = 20%.

                </div>

            </div>

        </div>


        <!-- LOSS PERCENTAGE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#lossPercentTopic">

                    6. Loss Percentage

                </button>

            </h2>


            <div
                id="lossPercentTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Loss percentage represents the loss
                    as a percentage of the Cost Price.

                    <br><br>

                    <strong>Formula:</strong>

                    Loss % =

                    (Loss / CP) × 100

                </div>

            </div>

        </div>


        <!-- DISCOUNT -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#discountTopic">

                    7. Discount

                </button>

            </h2>


            <div
                id="discountTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Discount is the reduction given on the
                    Marked Price of an item.

                    <br><br>

                    <strong>Formula:</strong>

                    Discount = Marked Price − Selling Price

                    <br><br>

                    <strong>Discount %:</strong>

                    Discount % =

                    (Discount / Marked Price) × 100

                </div>

            </div>

        </div>


        <!-- MARKED PRICE -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#markedPriceTopic">

                    8. Marked Price

                </button>

            </h2>


            <div
                id="markedPriceTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Marked Price (MP) is the price printed or
                    displayed on a product before applying a
                    discount.

                    <br><br>

                    <strong>Formula:</strong>

                    SP = MP − Discount

                </div>

            </div>

        </div>


        <!-- SUCCESSIVE DISCOUNT -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#successiveTopic">

                    9. Successive Discounts

                </button>

            </h2>


            <div
                id="successiveTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Successive discounts are two or more
                    discounts applied one after another.

                    <br><br>

                    <strong>Formula for two discounts:</strong>

                    Net Discount % =

                    A + B − (A × B / 100)

                    <br><br>

                    Example: 20% and 10% discounts.

                    Net Discount =

                    20 + 10 − (20 × 10 / 100)

                    = 28%.

                </div>

            </div>

        </div>


        <!-- OVERALL -->

        <div class="accordion-item">

            <h2 class="accordion-header">

                <button
                    class="accordion-button collapsed"
                    data-bs-toggle="collapse"
                    data-bs-target="#overallTopic">

                    10. Overall Profit and Loss

                </button>

            </h2>


            <div
                id="overallTopic"
                class="accordion-collapse collapse">

                <div class="accordion-body">

                    Overall profit or loss is calculated by
                    comparing the total Cost Price with the
                    total Selling Price.

                    <br><br>

                    <strong>Profit:</strong>

                    Total SP − Total CP

                    <br><br>

                    <strong>Loss:</strong>

                    Total CP − Total SP

                </div>

            </div>

        </div>


    </div>



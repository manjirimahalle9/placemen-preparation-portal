<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>


/* =====================================================
   SCORE VARIABLES
===================================================== */

let score = 0;

let answeredQuestions = new Set();


/* =====================================================
   ANSWERS
===================================================== */

const answerText = {

    1: "60",

    2: "₹100",

    3: "12",

    4: "60 km/h",

    5: "1/10",

    6: "₹1,000",

    7: "1/2",

    8: "25 years",

    9: "154 cm²",

    10: "25"

};


/* =====================================================
   EXPLANATIONS
===================================================== */

const explanations = {

    1:
        "25% of 240 = (25 ÷ 100) × 240 = 60.",


    2:
        "Profit = SP − CP = ₹600 − ₹500 = ₹100.",


    3:
        "The common factors of 24 and 36 show that the highest common factor is 12.",


    4:
        "Speed = Distance ÷ Time = 120 ÷ 2 = 60 km/h.",


    5:
        "If the complete work takes 10 days, work completed in one day = 1/10.",


    6:
        "SI = (P × R × T) ÷ 100 = (5000 × 10 × 2) ÷ 100 = ₹1,000.",


    7:
        "A fair coin has two equally likely outcomes: Head and Tail. Therefore P(Head) = 1/2.",


    8:
        "Future Age = Present Age + Number of Years = 20 + 5 = 25 years.",


    9:
        "Area = πr² = (22/7) × 7 × 7 = 154 cm².",


    10:
        "3² + 4² = 9 + 16 = 25."

};


/* =====================================================
   CHECK INDIVIDUAL ANSWER
===================================================== */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* NO OPTION */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ALREADY ANSWERED */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* MARK ANSWERED */

    answeredQuestions.add(questionNumber);


    /* CORRECT */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* WRONG */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            selected.parentElement.textContent.trim() +

            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* DISABLE OPTIONS */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* DISABLE BUTTON */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =====================================================
   CALCULATE SCORE
===================================================== */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display =
        "block";


    scoreText.innerHTML =

        "Your Score: " +

        score +

        " / 10";


    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Quantitative Aptitude skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Quantitative Aptitude questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the formulas and explanations.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =====================================================
   COMPLETE TODAY'S TASK
===================================================== */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    const topic =
        "Quantitative Aptitude";


    /* ALREADY COMPLETED */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* SAVE COMPLETION */

    progress.completedTopics[topic] =
        today;


    /* UPDATE STREAK */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* SAVE */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* MESSAGE */

    alert(

        "🎉 Quantitative Aptitude completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* DASHBOARD */

    window.location.href =
        "/dashboard";

}


</script>



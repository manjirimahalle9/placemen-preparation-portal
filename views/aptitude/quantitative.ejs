 <!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Quantitative Aptitude | PlacementX</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <style>

        /* =====================================================
           BODY
        ===================================================== */

        body {

            background: #050706 !important;

            color: white !important;

            min-height: 100vh;

        }


        .container {

            background: #050706;

            max-width: 1000px;

        }


        p,
        li,
        h2,
        h4,
        h5,
        strong {

            color: white;

        }


        /* =====================================================
           TITLE
        ===================================================== */

        .page-title {

            color: #00c49c !important;

            font-weight: 700;

        }


        hr {

            border-color: #008c70;

            opacity: 1;

        }


        /* =====================================================
           TOPICS LIST
        ===================================================== */

        .list-group-item {

            background: #050706 !important;

            color: white !important;

            border-color: #008c70 !important;

        }


        /* =====================================================
           SECTION TITLE
        ===================================================== */

        .section-title {

            color: #00c49c !important;

            font-weight: 700;

            margin-top: 35px;

            margin-bottom: 10px;

        }


        /* =====================================================
           FLIP CARD GRID
        ===================================================== */

        .definition-grid {

            display: grid;

            grid-template-columns:
                repeat(3, 1fr);

            gap: 20px;

            margin-top: 20px;

            perspective: 1200px;

        }


        /* =====================================================
           FLIP CARD
        ===================================================== */

        .flip-card {

            width: 100%;

            height: 250px;

            perspective: 1200px;

            cursor: pointer;

        }


        .flip-card-inner {

            position: relative;

            width: 100%;

            height: 100%;

            text-align: center;

            transition:
                transform 0.7s
                cubic-bezier(.4,.2,.2,1);

            transform-style: preserve-3d;

        }


        .flip-card:hover
        .flip-card-inner {

            transform: rotateY(180deg);

        }


        .flip-card-front,
        .flip-card-back {

            position: absolute;

            width: 100%;

            height: 100%;

            top: 0;

            left: 0;

            border: 1px solid #008c70;

            border-radius: 14px;

            padding: 25px;

            display: flex;

            flex-direction: column;

            justify-content: center;

            align-items: center;

            backface-visibility: hidden;

            -webkit-backface-visibility: hidden;

            box-shadow:
                0 0 15px
                rgba(0,140,112,0.12);

        }


        /* =====================================================
           FRONT
        ===================================================== */

        .flip-card-front {

            background:
                linear-gradient(
                    145deg,
                    #07100d,
                    #050706
                );

        }


        .flip-card-front h4 {

            color: #00c49c !important;

            font-weight: 700;

            margin-top: 10px;

        }


        .flip-card-front p {

            color: #b9c8c4 !important;

            font-size: 14px;

        }


        .flip-icon {

            font-size: 42px;

            margin-bottom: 5px;

        }


        /* =====================================================
           BACK
        ===================================================== */

        .flip-card-back {

            background:
                linear-gradient(
                    145deg,
                    #073d2f,
                    #071d17
                );

            transform: rotateY(180deg);

            text-align: left;

            align-items: flex-start;

        }


        .flip-card-back h5 {

            color: #00c49c !important;

            font-weight: 700;

            width: 100%;

            text-align: center;

            margin-bottom: 12px;

        }


        .flip-card-back p {

            color: white !important;

            font-size: 14px;

            line-height: 1.55;

            margin-bottom: 12px;

        }


        .flip-formula {

            width: 100%;

            padding: 10px;

            border-radius: 8px;

            background: #050706;

            border: 1px solid #00c49c;

            color: #00c49c;

            font-weight: 600;

            text-align: center;

            font-size: 13px;

        }


        /* =====================================================
           PRACTICE SECTION
        ===================================================== */

        .question-section {

            margin-top: 50px;

        }


        .question-section-title {

            color: #00c49c;

            font-size: 24px;

            font-weight: 700;

            margin-bottom: 20px;

        }


        .question-card {

            background: #050706 !important;

            color: white !important;

            border: 1px solid #008c70 !important;

            border-radius: 10px;

            padding: 20px;

            margin-bottom: 20px;

            box-shadow:
                0 0 12px
                rgba(0,140,112,0.10);

        }


        .question-card h5 {

            color: #00c49c !important;

            font-weight: 700;

            margin-bottom: 15px;

        }


        /* =====================================================
           OPTIONS
        ===================================================== */

        .option {

            display: block;

            background: #0a100e;

            color: white;

            border: 1px solid #285e51;

            border-radius: 8px;

            padding: 11px 15px;

            margin-bottom: 10px;

            cursor: pointer;

            transition: 0.25s;

        }


        .option:hover {

            background: #0d1c18;

            border-color: #00c49c;

        }


        .option input {

            margin-right: 10px;

            accent-color: #00c49c;

        }


        /* =====================================================
           SUBMIT QUESTION
        ===================================================== */

        .submit-question {

            background: #008c70;

            border: none;

            color: white;

            padding: 9px 20px;

            border-radius: 7px;

            font-weight: 600;

            cursor: pointer;

            margin-top: 5px;

        }


        .submit-question:hover {

            background: #00a886;

            color: white;

        }


        .submit-question:disabled {

            opacity: 0.6;

            cursor: not-allowed;

        }


        /* =====================================================
           ANSWER RESULT
        ===================================================== */

        .answer-result {

            display: none;

            margin-top: 15px;

            padding: 15px;

            border-radius: 8px;

            line-height: 1.7;

        }


        .correct-result {

            background: #073d2f;

            border: 1px solid #00c49c;

        }


        .wrong-result {

            background: #351414;

            border: 1px solid #dc3545;

        }


        /* =====================================================
           FINAL SCORE
        ===================================================== */

        #finalScore {

            display: none;

            background: #071d17;

            border: 2px solid #00c49c;

            border-radius: 12px;

            padding: 25px;

            margin-top: 30px;

            text-align: center;

        }


        #finalScore h3 {

            color: #00c49c !important;

        }


        #scoreText,
        #scoreMessage {

            color: white !important;

        }


        /* =====================================================
           PREPARATION ALERT
        ===================================================== */

        .alert-success {

            background: #050706 !important;

            color: white !important;

            border: 1px solid #008c70 !important;

        }


        .alert-success li {

            color: white !important;

        }


        /* =====================================================
           TABLE
        ===================================================== */

        .table {

            background: #050706 !important;

            color: white !important;

        }


        .table tbody tr,
        .table tbody td {

            background: #050706 !important;

            color: white !important;

            border-color: #008c70 !important;

        }


        .table-primary,
        .table-primary th {

            background: #008c70 !important;

            color: white !important;

        }


        /* =====================================================
           BOTTOM BUTTONS
        ===================================================== */

        .complete-btn {

            background: #198754;

            border: none;

            color: white;

        }


        .complete-btn:hover {

            background: #157347;

            color: white;

        }


        .back-btn {

            background: #008c70;

            border: none;

            color: white;

        }


        .back-btn:hover {

            background: #00a886;

            color: white;

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media (max-width: 900px) {

            .definition-grid {

                grid-template-columns:
                    repeat(2, 1fr);

            }

        }


        @media (max-width: 576px) {

            .container {

                padding-left: 15px;

                padding-right: 15px;

            }


            .definition-grid {

                grid-template-columns: 1fr;

            }


            .flip-card {

                height: 270px;

            }


            .question-card {

                padding: 16px;

            }


            .bottom-buttons a,
            .bottom-buttons button {

                width: 100%;

                margin: 5px 0 !important;

            }

        }

    </style>

</head>


<body>


<div class="container mt-5 mb-5">


    <!-- =================================================
         TITLE
    ================================================== -->

    <h2 class="text-center page-title">

        🧮 Quantitative Aptitude

    </h2>


    <hr>


    <!-- =================================================
         INTRODUCTION
    ================================================== -->

    <p>

        Quantitative Aptitude is an important section of
        placement examinations. It tests numerical ability,
        mathematical reasoning, calculation speed and
        problem-solving skills.

        The topics below cover the most commonly practiced
        quantitative aptitude concepts for placement exams.

    </p>


    <!-- =================================================
         TOPICS COVERED
    ================================================== -->

    <h4 class="mt-4">

        📚 Topics Covered

    </h4>


    <ul class="list-group mb-4">

        <li class="list-group-item">
            Number System
        </li>

        <li class="list-group-item">
            Percentage
        </li>

        <li class="list-group-item">
            Profit and Loss
        </li>

        <li class="list-group-item">
            Time and Work
        </li>

        <li class="list-group-item">
            Time, Speed and Distance
        </li>

        <li class="list-group-item">
            Simple Interest
        </li>

        <li class="list-group-item">
            Compound Interest
        </li>

        <li class="list-group-item">
            Data Interpretation
        </li>

        <li class="list-group-item">
            Probability
        </li>

        <li class="list-group-item">
            Permutation and Combination
        </li>

        <li class="list-group-item">
            Problems on Ages
        </li>

        <li class="list-group-item">
            Mixture and Allegation
        </li>

        <li class="list-group-item">
            Algebra
        </li>

        <li class="list-group-item">
            Geometry
        </li>

        <li class="list-group-item">
            Mensuration
        </li>

    </ul>


    <!-- =================================================
         FLIP CARD DEFINITIONS
    ================================================== -->

    <h4 class="section-title">

        📖 Important Topic Definitions

    </h4>


    <p class="text-muted mb-4">

        Hover over a card to see the definition and
        important formula.

    </p>


    <div class="definition-grid">


        <!-- NUMBER SYSTEM -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🔢
                    </div>

                    <h4>
                        Number System
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🔢 Number System
                    </h5>

                    <p>
                        Number System is the study of different
                        types of numbers such as natural numbers,
                        whole numbers, integers, rational numbers
                        and irrational numbers.
                    </p>

                    <div class="flip-formula">
                        Example: 2, 4, 6, 8
                    </div>

                </div>

            </div>

        </div>


        <!-- PERCENTAGE -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        💯
                    </div>

                    <h4>
                        Percentage
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        💯 Percentage
                    </h5>

                    <p>
                        Percentage represents a number or
                        quantity as a fraction of 100.
                    </p>

                    <div class="flip-formula">
                        Percentage = (Part / Total) × 100
                    </div>

                </div>

            </div>

        </div>


        <!-- PROFIT LOSS -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        💰
                    </div>

                    <h4>
                        Profit & Loss
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        💰 Profit & Loss
                    </h5>

                    <p>
                        Profit and Loss deals with the difference
                        between the Cost Price and Selling Price
                        of a product.
                    </p>

                    <div class="flip-formula">
                        Profit = SP − CP
                    </div>

                </div>

            </div>

        </div>


        <!-- TIME WORK -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        ⏱️
                    </div>

                    <h4>
                        Time & Work
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        ⏱️ Time & Work
                    </h5>

                    <p>
                        Time and Work problems determine how
                        much work can be completed in a given
                        amount of time.
                    </p>

                    <div class="flip-formula">
                        Work = Rate × Time
                    </div>

                </div>

            </div>

        </div>


        <!-- TIME SPEED DISTANCE -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🚆
                    </div>

                    <h4>
                        Time, Speed & Distance
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🚆 Time, Speed & Distance
                    </h5>

                    <p>
                        This topic deals with the relationship
                        between distance travelled, speed and
                        time taken.
                    </p>

                    <div class="flip-formula">
                        Speed = Distance / Time
                    </div>

                </div>

            </div>

        </div>


        <!-- SIMPLE INTEREST -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        💵
                    </div>

                    <h4>
                        Simple Interest
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        💵 Simple Interest
                    </h5>

                    <p>
                        Simple Interest is the interest calculated
                        only on the original principal amount.
                    </p>

                    <div class="flip-formula">
                        SI = (P × R × T) / 100
                    </div>

                </div>

            </div>

        </div>


        <!-- COMPOUND INTEREST -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        📈
                    </div>

                    <h4>
                        Compound Interest
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        📈 Compound Interest
                    </h5>

                    <p>
                        Compound Interest is calculated on the
                        principal as well as the accumulated
                        interest.
                    </p>

                    <div class="flip-formula">
                        A = P(1 + R/100)<sup>T</sup>
                    </div>

                </div>

            </div>

        </div>


        <!-- DATA INTERPRETATION -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        📊
                    </div>

                    <h4>
                        Data Interpretation
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        📊 Data Interpretation
                    </h5>

                    <p>
                        Data Interpretation involves analyzing
                        information presented through tables,
                        graphs and charts.
                    </p>

                    <div class="flip-formula">
                        Percentage = (Part / Total) × 100
                    </div>

                </div>

            </div>

        </div>


        <!-- PROBABILITY -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🎲
                    </div>

                    <h4>
                        Probability
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🎲 Probability
                    </h5>

                    <p>
                        Probability measures the likelihood
                        or chance of an event occurring.
                    </p>

                    <div class="flip-formula">
                        P(E) = Favorable / Total
                    </div>

                </div>

            </div>

        </div>


        <!-- PERMUTATION COMBINATION -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🔀
                    </div>

                    <h4>
                        Permutation & Combination
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🔀 Permutation & Combination
                    </h5>

                    <p>
                        Permutation deals with arrangements,
                        while combination deals with selections.
                    </p>

                    <div class="flip-formula">
                        nCr = n! / r!(n-r)!
                    </div>

                </div>

            </div>

        </div>


        <!-- AGES -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        👨‍👩‍👧
                    </div>

                    <h4>
                        Problems on Ages
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        👨‍👩‍👧 Problems on Ages
                    </h5>

                    <p>
                        Problems on Ages involve calculating
                        present, past and future ages using
                        mathematical relationships.
                    </p>

                    <div class="flip-formula">
                        Future Age = Present + Years
                    </div>

                </div>

            </div>

        </div>


        <!-- MIXTURE -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🧪
                    </div>

                    <h4>
                        Mixture & Allegation
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🧪 Mixture & Allegation
                    </h5>

                    <p>
                        Mixture problems involve combining
                        quantities having different prices,
                        concentrations or qualities.
                    </p>

                    <div class="flip-formula">
                        Mean = Total Value / Total Quantity
                    </div>

                </div>

            </div>

        </div>


        <!-- ALGEBRA -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        ✏️
                    </div>

                    <h4>
                        Algebra
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        ✏️ Algebra
                    </h5>

                    <p>
                        Algebra uses variables, numbers and
                        mathematical expressions to solve
                        unknown quantities.
                    </p>

                    <div class="flip-formula">
                        (a+b)² = a² + 2ab + b²
                    </div>

                </div>

            </div>

        </div>


        <!-- GEOMETRY -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        📐
                    </div>

                    <h4>
                        Geometry
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        📐 Geometry
                    </h5>

                    <p>
                        Geometry deals with shapes, lines,
                        angles, areas and properties of figures.
                    </p>

                    <div class="flip-formula">
                        Triangle Angles = 180°
                    </div>

                </div>

            </div>

        </div>


        <!-- MENSURATION -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        📏
                    </div>

                    <h4>
                        Mensuration
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        📏 Mensuration
                    </h5>

                    <p>
                        Mensuration deals with calculating
                        perimeter, area, surface area and
                        volume of geometrical shapes.
                    </p>

                    <div class="flip-formula">
                        Circle Area = πr²
                    </div>

                </div>

            </div>

        </div>


    </div>


    <!-- =================================================
         PRACTICE QUESTIONS
    ================================================== -->

    <div class="question-section">

        <div class="question-section-title">

            📝 Practice Questions

        </div>


        <!-- QUESTION 1 -->

        <div class="question-card">

            <h5>
                Question 1
            </h5>

            <div class="question-text">

                What is 25% of 240?

            </div>


            <label class="option">

                <input
                    type="radio"
                    name="q1"
                    value="40">

                A. 40

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q1"
                    value="50">

                B. 50

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q1"
                    value="60">

                C. 60

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q1"
                    value="70">

                D. 70

            </label>


            <button
                class="submit-question"
                onclick="checkAnswer(1, '60')">

                Submit Answer

            </button>


            <div
                id="result1"
                class="answer-result">

            </div>

        </div>


        <!-- QUESTION 2 -->

        <div class="question-card">

            <h5>
                Question 2
            </h5>

            <div class="question-text">

                If CP = ₹500 and SP = ₹600,
                what is the profit?

            </div>


            <label class="option">

                <input
                    type="radio"
                    name="q2"
                    value="50">

                A. ₹50

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q2"
                    value="75">

                B. ₹75

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q2"
                    value="100">

                C. ₹100

            </label>


            <label class="option">

                <input
                    type="radio"
                    name="q2"
                    value="150">

                D. ₹150

            </label>


            <button
                class="submit-question"
                onclick="checkAnswer(2, '100')">

                Submit Answer

            </button>


            <div
                id="result2"
                class="answer-result">

            </div>

        </div>


        <!-- QUESTION 3 -->

        <div class="question-card">

            <h5>
                Question 3
            </h5>

            <div class="question-text">

                What is the HCF of 24 and 36?

            </div>


            <label class="option">


<!-- ==========================================
     BOOTSTRAP JAVASCRIPT
=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>


/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "1/10",

    2: "4 days",

    3: "1/4",

    4: "6 days",

    5: "1/4",

    6: "9 days",

    7: "24 days",

    8: "1/6",

    9: "1/12",

    10: "6.67 days"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "One day's work = 1 / Total days = 1 / 10 = 1/10.",


    2:
        "A's rate = 1/12 and B's rate = 1/6. Combined rate = 1/12 + 1/6 = 3/12 = 1/4. Therefore, they complete the work in 4 days.",


    3:
        "One day's work = 1/20. In 5 days, work completed = 5 × 1/20 = 1/4.",


    4:
        "A's rate = 1/15 and B's rate = 1/10. Combined rate = 1/15 + 1/10 = 5/30 = 1/6. Therefore, they take 6 days.",


    5:
        "A's one-day work = 1/8. In 2 days, work = 2 × 1/8 = 1/4.",


    6:
        "A is twice as efficient as B, so A takes half the time. B takes 18 days, therefore A takes 18/2 = 9 days.",


    7:
        "A+B rate = 1/8. A's rate = 1/12. B's rate = 1/8 − 1/12 = 1/24. Therefore B alone takes 24 days.",


    8:
        "One-hour filling rate = 1 / 6. Therefore, the pipe fills 1/6 of the tank in one hour.",


    9:
        "A's rate = 1/20 and B's rate = 1/30. Combined rate = 1/20 + 1/30 = 5/60 = 1/12.",


    10:
        "B is 50% more efficient than A, so B's efficiency = 150% of A. Therefore B's time = 10 / 1.5 = 6.67 days."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK QUESTION AS ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE CURRENT BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;


    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    /* ---------------------------------------------
       SHOW SCORE
    --------------------------------------------- */

    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    /* ---------------------------------------------
       SCORE MESSAGE
    --------------------------------------------- */

    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Time and Work skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Time and Work questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    /* ---------------------------------------------
       SCROLL TO SCORE
    --------------------------------------------- */

    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    /* ---------------------------------------------
       CORRECT TOPIC NAME
    --------------------------------------------- */

    const topic =
        "Time and Work";


    /* ---------------------------------------------
       ALREADY COMPLETED TODAY
    --------------------------------------------- */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTopics[topic] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE TO LOCAL STORAGE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Time and Work completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}


</script>



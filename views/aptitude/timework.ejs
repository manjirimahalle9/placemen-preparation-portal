           FLIP CARD SECTION
        ============================== */

        .definition-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 20px;
        }

        .flip-card {
            background: transparent;
            width: 100%;
            height: 250px;
            perspective: 1000px;
        }

        .flip-card-inner {
            position: relative;
            width: 100%;
            height: 100%;
            text-align: center;
            transition: transform 0.7s ease;
            transform-style: preserve-3d;
        }

        .flip-card:hover .flip-card-inner {
            transform: rotateY(180deg);
        }

        .flip-card-front,
        .flip-card-back {
            position: absolute;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border: 1px solid #008c70;
            border-radius: 14px;
            padding: 25px;
            box-shadow: 0 0 15px rgba(0, 196, 156, 0.08);
        }

        .flip-card-front {
            background: #07100d;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
        }

        .flip-card-front h4 {
            color: #00c49c !important;
            margin-top: 10px;
            font-weight: 700;
        }

        .flip-card-front p {
            color: #aaa !important;
        }

        .flip-icon {
            font-size: 42px;
        }

        .flip-card-back {
            background: #071d17;
            transform: rotateY(180deg);
            display: flex;
            flex-direction: column;
            justify-content: center;
            overflow-y: auto;
        }

        .flip-card-back h5 {
            color: #00c49c !important;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .flip-card-back p {
            line-height: 1.6;
        }

        .flip-formula {
            background: #050706;
            border: 1px solid #008c70;
            padding: 10px;
            border-radius: 8px;
            color: #00c49c;
            font-weight: 700;
            margin-top: 10px;
        }

        /* ==============================
           QUESTION CARD
        ============================== */

        .question-card {
            background: #050706 !important;
            color: white !important;
            border: 1px solid #008c70 !important;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow:
                0 0 12px rgba(0, 140, 112, 0.10);
        }

        .question-title {
            color: #00c49c !important;
            font-size: 19px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .question-text {
            line-height: 1.7;
            margin-bottom: 18px;
        }

        /* ==============================
           OPTIONS
        ============================== */

        .option {
            display: block;
            background: #0a100e;
            color: white;
            border: 1px solid #285e51;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: 0.25s;
        }

        .option:hover {
            background: #0d1c18;
            border-color: #00c49c;
        }

        .option input {
            margin-right: 10px;
            accent-color: #00c49c;
        }

        /* ==============================
           SUBMIT QUESTION
        ============================== */

        .submit-question {
            background: #008c70;
            border: none;
            color: white;
            padding: 9px 20px;
            border-radius: 7px;
            font-weight: 600;
            cursor: pointer;
        }

        .submit-question:hover {
            background: #00a886;
            color: white;
        }

        .submit-question:disabled {
            opacity: 0.6;

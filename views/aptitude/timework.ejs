<!-- ==========================================
     BOOTSTRAP JS
=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWERS
================================================= */

const answerText = {

    1: "1/10",

    2: "4 days",

    3: "1/4",

    4: "6 days",

    5: "4 days",

    6: "30 days",

    7: "10 days",

    8: "1/6",

    9: "1 : 2",

    10: "7.2 days"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "If A completes the entire work in 10 days, then A's one-day work = 1/10.",


    2:
        "A's rate = 1/12 and B's rate = 1/6. Combined rate = 1/12 + 1/6 = 3/12 = 1/4. Therefore, they complete the work in 4 days.",


    3:
        "One day's work = 1/20. Therefore, work completed in 5 days = 5/20 = 1/4.",


    4:
        "A's rate = 1/15 and B's rate = 1/10. Combined rate = 1/15 + 1/10 = 5/30 = 1/6. Therefore, they take 6 days.",


    5:
        "B is twice as efficient as A, so B takes half the time. 8 ÷ 2 = 4 days.",


    6:
        "A + B rate = 1/12. A's rate = 1/20. B's rate = 1/12 − 1/20 = 1/30. Therefore B takes 30 days.",


    7:
        "Total work = Workers × Days = 10 × 15 = 150 worker-days. For 15 workers, days = 150 ÷ 15 = 10 days.",


    8:
        "If the pipe fills the tank in 6 hours, it fills 1/6 of the tank in one hour.",


    9:
        "Efficiency is inversely proportional to time. A : B efficiency = 1/18 : 1/9 = 1 : 2.",


    10:
        "A's rate = 1/12 and B's rate = 1/18. Combined rate = 5/36. Time = 36/5 = 7.2 days."

};


/* =================================================
   CHECK INDIVIDUAL ANSWER
================================================= */

function checkAnswer(questionNumber, correctAnswer) {

    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE SCORE
================================================= */

function calculateScore() {

    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Time and Work skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Time and Work questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {

    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {}

        };


    const topic =
        "Time and Work";


    /* ---------------------------------------------
       ALREADY COMPLETED
    --------------------------------------------- */

    if (
        progress.completedTopics[topic] === today
    ) {

        alert(
            "✅ You already completed this task today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE TOPIC
    --------------------------------------------- */

    progress.completedTopics[topic] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS
    --------------------------------------------- */

    alert(

        "🎉 Time and Work completed!" +

        "\n🔥 Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}

</script>



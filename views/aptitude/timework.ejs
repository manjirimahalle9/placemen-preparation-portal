             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 8 -->

    <div class="question-card">

        <div class="question-title">
            Question 8
        </div>

        <div class="question-text">

            A pipe can fill a tank in 6 hours.
            What fraction of the tank does it fill
            in one hour?

        </div>

        <label class="option">
            <input type="radio" name="q8" value="1/2">
            1/2
        </label>

        <label class="option">
            <input type="radio" name="q8" value="1/4">
            1/4
        </label>

        <label class="option">
            <input type="radio" name="q8" value="1/5">
            1/5
        </label>

        <label class="option">
            <input type="radio" name="q8" value="1/6">
            1/6
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(8, '1/6')">

            Submit Answer

        </button>

        <div id="result8"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 9 -->

    <div class="question-card">

        <div class="question-title">

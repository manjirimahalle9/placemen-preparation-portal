</head>


<body>


<div class="container mt-5 mb-5">


    <!-- ==========================================
         TITLE
    =========================================== -->

    <h2 class="text-center page-title">

        ⏱️ Time and Work

    </h2>

    <hr>


    <!-- ==========================================
         INTRODUCTION
    =========================================== -->

    <p>

        Time and Work is an important quantitative aptitude
        topic used in placement examinations. It deals with
        the relationship between the amount of work, time
        required and efficiency of workers.

        It is commonly asked in aptitude tests of companies
        and helps improve calculation and problem-solving speed.

    </p>


    <!-- ==========================================
         TOPICS COVERED
    =========================================== -->

    <h4 class="section-title">

        📚 Topics Covered

    </h4>


    <ul class="list-group mb-4">

        <li class="list-group-item">
            Basic Work Concepts
        </li>

        <li class="list-group-item">
            Work Efficiency
        </li>

        <li class="list-group-item">
            Work Rate
        </li>

        <li class="list-group-item">
            Individual Work
        </li>

        <li class="list-group-item">
            Combined Work
        </li>

        <li class="list-group-item">
            Work and Wages
        </li>

        <li class="list-group-item">
            Men and Days
        </li>

        <li class="list-group-item">
            Pipes and Cisterns
        </li>

        <li class="list-group-item">
            Alternate Work
        </li>

    </ul>


    <!-- ==========================================
         FLIP CARDS
    =========================================== -->

    <h4 class="section-title">

        📖 Important Topic Definitions

    </h4>


    <p class="mb-4">

        Hover over a card to see the definition and important formula.

    </p>


    <div class="definition-grid">


        <!-- BASIC WORK -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🛠️
                    </div>

                    <h4>
                        Basic Work
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🛠️ Basic Work
                    </h5>

                    <p>

                        Work represents the task that must be
                        completed by a person or group.

                        If a person completes a work in 10 days,
                        the work done in one day is 1/10.

                    </p>

                    <div class="flip-formula">
                        One Day Work = 1 / Number of Days
                    </div>

                </div>

            </div>

        </div>


        <!-- WORK EFFICIENCY -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        ⚡
                    </div>

                    <h4>
                        Work Efficiency
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        ⚡ Work Efficiency
                    </h5>

                    <p>

                        Efficiency represents the amount of
                        work a person can complete in a given
                        amount of time.

                        A more efficient worker takes less time.

                    </p>

                    <div class="flip-formula">
                        Efficiency ∝ 1 / Time
                    </div>

                </div>

            </div>

        </div>


        <!-- WORK RATE -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        📈
                    </div>

                    <h4>
                        Work Rate
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        📈 Work Rate
                    </h5>

                    <p>

                        Work rate indicates how much work is
                        completed in one unit of time.

                    </p>

                    <div class="flip-formula">
                        Work Rate = Work / Time
                    </div>

                </div>

            </div>

        </div>


        <!-- INDIVIDUAL WORK -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        👷
                    </div>

                    <h4>
                        Individual Work
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        👷 Individual Work
                    </h5>

                    <p>

                        Individual work refers to the work
                        completed by one person working alone.

                        If A completes a job in 5 days,
                        A's one-day work is 1/5.

                    </p>

                    <div class="flip-formula">
                        A's Rate = 1 / A's Time
                    </div>

                </div>

            </div>

        </div>


        <!-- COMBINED WORK -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        👥
                    </div>

                    <h4>
                        Combined Work
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        👥 Combined Work
                    </h5>

                    <p>

                        Combined work occurs when two or more
                        people work together.

                        Their individual work rates are added
                        together.

                    </p>

                    <div class="flip-formula">
                        Combined Rate = A's Rate + B's Rate
                    </div>

                </div>

            </div>

        </div>


        <!-- WORK AND WAGES -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        💰
                    </div>

                    <h4>
                        Work and Wages
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        💰 Work and Wages
                    </h5>

                    <p>

                        Work and wages problems determine
                        payment based on the amount of work
                        completed by each worker.

                    </p>

                    <div class="flip-formula">
                        Wages ∝ Work Done
                    </div>

                </div>

            </div>

        </div>


        <!-- MEN AND DAYS -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        👨‍🔧
                    </div>

                    <h4>
                        Men and Days
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        👨‍🔧 Men and Days
                    </h5>

                    <p>

                        Men and Days problems determine how
                        many workers are required to complete
                        a task in a given number of days.

                    </p>

                    <div class="flip-formula">
                        Men × Days = Constant Work
                    </div>

                </div>

            </div>

        </div>


        <!-- PIPES -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🚰
                    </div>

                    <h4>
                        Pipes and Cisterns
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🚰 Pipes and Cisterns
                    </h5>

                    <p>

                        Pipes and cisterns problems involve
                        filling or emptying a tank.

                        Filling pipes add work while emptying
                        pipes remove work.

                    </p>

                    <div class="flip-formula">
                        Net Rate = Filling Rate − Emptying Rate
                    </div>

                </div>

            </div>

        </div>


        <!-- ALTERNATE WORK -->

        <div class="flip-card">

            <div class="flip-card-inner">

                <div class="flip-card-front">

                    <div class="flip-icon">
                        🔄
                    </div>

                    <h4>
                        Alternate Work
                    </h4>

                    <p>
                        Hover to see definition
                    </p>

                </div>


                <div class="flip-card-back">

                    <h5>
                        🔄 Alternate Work
                    </h5>

                    <p>

                        In alternate work problems, workers
                        work on different days or in a fixed
                        sequence.

                        Their work rates are considered according
                        to the days they work.

                    </p>

                    <div class="flip-formula">
                        Total Work = Sum of Daily Work
                    </div>

                </div>

            </div>

        </div>


    </div>


    <!-- ==========================================
         PRACTICE QUESTIONS
    =========================================== -->

    <h4 class="section-title">

        📝 Practice Questions

    </h4>


    <!-- QUESTION 1 -->

    <div class="question-card">

        <div class="question-title">
            Question 1
        </div>

        <div class="question-text">

            A can complete a work in 10 days.
            How much work does A complete in one day?

        </div>

        <label class="option">
            <input type="radio" name="q1" value="1/5">
            1/5
        </label>

        <label class="option">
            <input type="radio" name="q1" value="1/10">
            1/10
        </label>

        <label class="option">
            <input type="radio" name="q1" value="1/20">
            1/20
        </label>

        <label class="option">
            <input type="radio" name="q1" value="10">
            10
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(1, '1/10')">

            Submit Answer

        </button>

        <div id="result1"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 2 -->

    <div class="question-card">

        <div class="question-title">
            Question 2
        </div>

        <div class="question-text">

            A can complete a work in 12 days and B can
            complete the same work in 6 days.

            How many days will they take together?

        </div>

        <label class="option">
            <input type="radio" name="q2" value="2">
            2 days
        </label>

        <label class="option">
            <input type="radio" name="q2" value="3">
            3 days
        </label>

        <label class="option">
            <input type="radio" name="q2" value="4">
            4 days
        </label>

        <label class="option">
            <input type="radio" name="q2" value="6">
            6 days
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(2, '4')">

            Submit Answer

        </button>

        <div id="result2"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 3 -->

    <div class="question-card">

        <div class="question-title">
            Question 3
        </div>

        <div class="question-text">

            A worker completes a job in 20 days.
            What fraction of the work is completed
            in 5 days?

        </div>

        <label class="option">
            <input type="radio" name="q3" value="1/2">
            1/2
        </label>

        <label class="option">
            <input type="radio" name="q3" value="1/4">
            1/4
        </label>

        <label class="option">
            <input type="radio" name="q3" value="1/5">
            1/5
        </label>

        <label class="option">
            <input type="radio" name="q3" value="1/10">
            1/10
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(3, '1/4')">

            Submit Answer

        </button>

        <div id="result3"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 4 -->

    <div class="question-card">

        <div class="question-title">
            Question 4
        </div>

        <div class="question-text">

            A can complete a work in 15 days and B can
            complete it in 10 days.

            How long will they take together?

        </div>

        <label class="option">
            <input type="radio" name="q4" value="5">
            5 days
        </label>

        <label class="option">
            <input type="radio" name="q4" value="6">
            6 days
        </label>

        <label class="option">
            <input type="radio" name="q4" value="8">
            8 days
        </label>

        <label class="option">
            <input type="radio" name="q4" value="10">
            10 days
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(4, '6')">

            Submit Answer

        </button>

        <div id="result4"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 5 -->

    <div class="question-card">

        <div class="question-title">
            Question 5
        </div>

        <div class="question-text">

            A can complete a work in 8 days.
            B is twice as efficient as A.

            How many days will B take?

        </div>

        <label class="option">
            <input type="radio" name="q5" value="2">
            2 days
        </label>

        <label class="option">
            <input type="radio" name="q5" value="4">
            4 days
        </label>

        <label class="option">
            <input type="radio" name="q5" value="6">
            6 days
        </label>

        <label class="option">
            <input type="radio" name="q5" value="8">
            8 days
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(5, '4')">

            Submit Answer

        </button>

        <div id="result5"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 6 -->

    <div class="question-card">

        <div class="question-title">
            Question 6
        </div>

        <div class="question-text">

            A and B together can complete a work in 12 days.
            A alone can complete it in 20 days.

            How many days will B alone take?

        </div>

        <label class="option">
            <input type="radio" name="q6" value="20">
            20 days
        </label>

        <label class="option">
            <input type="radio" name="q6" value="25">
            25 days
        </label>

        <label class="option">
            <input type="radio" name="q6" value="30">
            30 days
        </label>

        <label class="option">
            <input type="radio" name="q6" value="40">
            40 days
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(6, '30')">

            Submit Answer

        </button>

        <div id="result6"
             class="answer-result">
        </div>

    </div>


    <!-- QUESTION 7 -->

    <div class="question-card">

        <div class="question-title">
            Question 7
        </div>

        <div class="question-text">

            10 workers can complete a work in 15 days.
            How many days will 15 workers take,
            assuming all workers have equal efficiency?

        </div>

        <label class="option">
            <input type="radio" name="q7" value="8">
            8 days
        </label>

        <label class="option">
            <input type="radio" name="q7" value="10">
            10 days
        </label>

        <label class="option">
            <input type="radio" name="q7" value="12">
            12 days
        </label>

        <label class="option">
            <input type="radio" name="q7" value="15">
            15 days
        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(7, '10')">

            Submit Answer

        </button>


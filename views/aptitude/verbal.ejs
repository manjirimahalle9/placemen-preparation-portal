<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Companies - Placement Preparation Portal</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        body {
            background-color: #f4f7fc;
        }

        .header {
            background: linear-gradient(135deg, #0d6efd, #6610f2);
            color: white;
            padding: 45px;
            border-radius: 20px;
        }

        .company-card {
            border: none;
            border-radius: 15px;
            transition: 0.3s;
        }

        .company-card:hover {
            transform: translateY(-5px);
        }

        .company-icon {
            font-size: 45px;
        }

        .section-title {
            margin-top: 40px;
            margin-bottom: 20px;
            font-weight: bold;
        }

    </style>

</head>

<body>


<!-- NAVBAR -->

<nav class="navbar navbar-dark bg-primary">

    <div class="container">

        <span class="navbar-brand fw-bold">
            🎓 Placement Preparation Portal
        </span>

        <a href="/dashboard" class="btn btn-light">
            Dashboard
        </a>

    </div>

</nav>


<div class="container mt-4">


    <!-- HEADER -->

    <div class="header text-center">

        <h1>
            🏢 Placement Companies
        </h1>

        <p class="lead">
            Explore companies and prepare for their placement process.
        </p>

        <p>
            Learn about required skills, interview rounds and
            preparation strategies.
        </p>

    </div>


    <!-- COMPANY LIST -->

    <h2 class="section-title">
        ⭐ Top Companies
    </h2>


    <div class="row g-4">


        <!-- TCS -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    💻
                </div>

                <h4 class="mt-3">
                    TCS
                </h4>

                <p>
                    Tata Consultancy Services
                </p>

                <span class="badge bg-primary mb-3">
                    IT Services
                </span>

                <p>
                    Focus on aptitude, coding, technical knowledge
                    and communication skills.
                </p>

                <button
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#tcsModal">

                    View Details

                </button>

            </div>

        </div>


        <!-- INFOSYS -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    🌐
                </div>

                <h4 class="mt-3">
                    Infosys
                </h4>

                <p>
                    Infosys Limited
                </p>

                <span class="badge bg-success mb-3">
                    IT Services
                </span>

                <p>
                    Candidates should prepare programming,
                    aptitude and technical concepts.
                </p>

                <button
                    class="btn btn-success"
                    data-bs-toggle="modal"
                    data-bs-target="#infosysModal">

                    View Details

                </button>

            </div>

        </div>


        <!-- WIPRO -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    🚀
                </div>

                <h4 class="mt-3">
                    Wipro
                </h4>

                <p>
                    Wipro Limited
                </p>

                <span class="badge bg-warning text-dark mb-3">
                    IT Services
                </span>

                <p>
                    Prepare aptitude, logical reasoning, coding
                    and communication skills.
                </p>

                <button
                    class="btn btn-warning"
                    data-bs-toggle="modal"
                    data-bs-target="#wiproModal">

                    View Details

                </button>

            </div>

        </div>


        <!-- ACCENTURE -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    🏆
                </div>

                <h4 class="mt-3">
                    Accenture
                </h4>

                <p>
                    Accenture
                </p>

                <span class="badge bg-danger mb-3">
                    Consulting & IT
                </span>

                <p>
                    Focus on aptitude, coding, communication
                    and technical fundamentals.
                </p>

                <button
                    class="btn btn-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#accentureModal">

                    View Details

                </button>

            </div>

        </div>


        <!-- COGNIZANT -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    🔥
                </div>

                <h4 class="mt-3">
                    Cognizant
                </h4>

                <p>
                    Cognizant Technology Solutions
                </p>

                <span class="badge bg-info text-dark mb-3">
                    IT Services
                </span>

                <p>
                    Prepare programming, SQL, DBMS and
                    communication skills.
                </p>

                <button
                    class="btn btn-info"
                    data-bs-toggle="modal"
                    data-bs-target="#cognizantModal">

                    View Details

                </button>

            </div>

        </div>


        <!-- CAPGEMINI -->

        <div class="col-md-4">

            <div class="card company-card shadow p-4 text-center">

                <div class="company-icon">
                    ⭐
                </div>

                <h4 class="mt-3">
                    Capgemini
                </h4>

                <p>
                    Capgemini
                </p>

                <span class="badge bg-secondary mb-3">
                    IT Services
                </span>

                <p>
                    Focus on aptitude, coding, technical and
                    HR interview preparation.
                </p>

                <button
                    class="btn btn-secondary"
                    data-bs-toggle="modal"
                    data-bs-target="#capgeminiModal">

                    View Details

                </button>

            </div>

        </div>

    </div>


    <!-- PREPARATION -->

    <h2 class="section-title">
        📚 Company Preparation
    </h2>


    <div class="row">


        <div class="col-md-3">

            <div class="card shadow p-3 text-center">

                <h3>🧮</h3>

                <h5>Aptitude</h5>

                <p>
                    Practice percentage, profit & loss,
                    time & work and reasoning.
                </p>

                <a href="/aptitude"
                   class="btn btn-primary">

                    Practice

                </a>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow p-3 text-center">

                <h3>💻</h3>

                <h5>Coding</h5>

                <p>
                    Practice C, C++, Java, Python
                    and SQL programming.
                </p>

                <a href="/coding"
                   class="btn btn-success">

                    Practice

                </a>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow p-3 text-center">

                <h3>🎤</h3>

                <h5>Interview</h5>

                <p>
                    Prepare HR and technical
                    interview questions.
                </p>

                <a href="/interview"
                   class="btn btn-danger">

                    Practice

                </a>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card shadow p-3 text-center">

                <h3>📄</h3>

                <h5>Resume</h5>

                <p>
                    Create a professional resume
                    for placement applications.
                </p>

                <a href="/resume"
                   class="btn btn-warning">

                    Create Resume

                </a>

            </div>

        </div>

    </div>


    <!-- GENERAL PROCESS -->

    <h2 class="section-title">
        📝 Common Placement Process
    </h2>


    <div class="table-responsive">

        <table class="table table-bordered table-hover bg-white">

            <thead class="table-primary">

                <tr>
                    <th>Round</th>
                    <th>What to Prepare</th>
                    <th>Importance</th>
                </tr>

            </thead>

            <tbody>

                <tr>
                    <td>1. Aptitude Test</td>
                    <td>Quantitative Aptitude, Reasoning, Verbal</td>
                    <td>⭐⭐⭐⭐⭐</td>
                </tr>

                <tr>
                    <td>2. Coding Test</td>
                    <td>C, C++, Java, Python, SQL</td>
                    <td>⭐⭐⭐⭐⭐</td>
                </tr>

                <tr>
                    <td>3. Technical Interview</td>
                    <td>Programming, DBMS, OOP, OS, Networks</td>
                    <td>⭐⭐⭐⭐⭐</td>
                </tr>

                <tr>
                    <td>4. HR Interview</td>
                    <td>Communication, Confidence, Personality</td>
                    <td>⭐⭐⭐⭐</td>
                </tr>

            </tbody>

        </table>

    </div>


    <!-- MODALS -->


    <!-- TCS MODAL -->

    <div class="modal fade" id="tcsModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        💻 TCS Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <p>
                        <strong>Prepare:</strong>
                    </p>

                    <ul>
                        <li>Quantitative Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>Verbal Ability</li>
                        <li>Programming</li>
                        <li>DBMS and SQL</li>
                        <li>Technical Interview</li>
                        <li>HR Interview</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- INFOSYS MODAL -->

    <div class="modal fade" id="infosysModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        🌐 Infosys Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <ul>
                        <li>Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>Programming</li>
                        <li>Problem Solving</li>
                        <li>DBMS</li>
                        <li>Technical Interview</li>
                        <li>HR Interview</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- WIPRO MODAL -->

    <div class="modal fade" id="wiproModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        🚀 Wipro Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <ul>
                        <li>Quantitative Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>Verbal Ability</li>
                        <li>Coding</li>
                        <li>Technical Concepts</li>
                        <li>HR Questions</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- ACCENTURE MODAL -->

    <div class="modal fade" id="accentureModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        🏆 Accenture Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <ul>
                        <li>Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>Verbal Ability</li>
                        <li>Coding</li>
                        <li>Problem Solving</li>
                        <li>Communication</li>
                        <li>Interview Preparation</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- COGNIZANT MODAL -->

    <div class="modal fade" id="cognizantModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        🔥 Cognizant Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <ul>
                        <li>Programming</li>
                        <li>SQL</li>
                        <li>DBMS</li>
                        <li>Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>Technical Interview</li>
                        <li>HR Interview</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- CAPGEMINI MODAL -->

    <div class="modal fade" id="capgeminiModal">

        <div class="modal-dialog">

            <div class="modal-content">

                <div class="modal-header">

                    <h5 class="modal-title">
                        ⭐ Capgemini Preparation
                    </h5>

                    <button
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <div class="modal-body">

                    <ul>
                        <li>Quantitative Aptitude</li>
                        <li>Logical Reasoning</li>
                        <li>English</li>
                        <li>Coding</li>
                        <li>Technical Questions</li>
                        <li>HR Interview</li>
                    </ul>

                </div>

            </div>

        </div>

    </div>


    <!-- BACK BUTTON -->

    <div class="text-center my-5">

        <a href="/dashboard"
           class="btn btn-primary btn-lg">

            ⬅ Back to Dashboard

        </a>

    </div>


</div>


<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


</body>
</html>
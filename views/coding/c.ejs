<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWERS
================================================= */

const answerText = {

    1: "main()",

    2: "int",

    3: "10",

    4: "%",

    5: "11",

    6: "for loop",

    7: "0",

    8: "&",

    9: "*",

    10: "struct",

    11: "Yes",

    12: "1 2 3",

    13: "stdio.h",

    14: "strlen()",

    15: "2",

    16: "return",

    17: "break",

    18: "continue",

    19: "1",

    20: "int *p"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "Execution of a C program begins from the main() function.",

    2:
        "The int data type is used to store integer values.",

    3:
        "The variable a contains the value 10, so printf() displays 10.",

    4:
        "The % operator returns the remainder after division.",

    5:
        "Multiplication has higher precedence than addition. Therefore 3 × 2 = 6 and 5 + 6 = 11.",

    6:
        "A for loop is commonly used when the number of iterations is known.",

    7:
        "C arrays use zero-based indexing, so the first element has index 0.",

    8:
        "The & operator returns the memory address of a variable.",

    9:
        "The * operator is used to dereference a pointer and access its stored value.",

    10:
        "The struct keyword is used to define a structure in C.",

    11:
        "Since 10 is greater than 5, the if condition is true and Yes is printed.",

    12:
        "The loop starts at 1 and continues while i is less than or equal to 3, so it prints 1 2 3.",

    13:
        "printf() is declared in the stdio.h header file.",

    14:
        "strlen() returns the number of characters in a string, excluding the null character.",

    15:
        "Both operands are integers, so integer division is performed. 5 / 2 gives 2.",

    16:
        "The return keyword sends a value back from a function.",

    17:
        "The break statement immediately terminates the loop.",

    18:
        "The continue statement skips the remaining statements in the current iteration.",

    19:
        "10 divided by 3 leaves a remainder of 1, so 10 % 3 is 1.",

    20:
        "int *p declares p as a pointer to an integer."
};


/* =================================================
   CHECK INDIVIDUAL ANSWER
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =

        document.querySelector(

            `input[name="q${questionNumber}"]:checked`

        );


    const result =

        document.getElementById(

            `result${questionNumber}`

        );


    /* ---------------------------------------------
       NO OPTION
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (

        answeredQuestions.has(questionNumber)

    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT
    --------------------------------------------- */

    if (

        selected.value === correctAnswer

    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            selected.parentElement.textContent.trim() +

            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =

        document.querySelectorAll(

            `input[name="q${questionNumber}"]`

        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const currentCard =

        result.closest(".question-card");


    const currentButton =

        currentCard.querySelector(

            ".submit-question"

        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =

        document.getElementById(
            "finalScore"
        );


    const scoreText =

        document.getElementById(
            "scoreText"
        );


    const scoreMessage =

        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display = "block";


    scoreText.innerHTML =

        "Your Score: " +

        score +

        " / 20";


    if (score === 20) {

        scoreMessage.innerHTML =

            "🏆 Excellent! You got all 20 questions correct!";

    }

    else if (score >= 16) {

        scoreMessage.innerHTML =

            "🌟 Great job! Your C programming fundamentals are strong.";

    }

    else if (score >= 10) {

        scoreMessage.innerHTML =

            "👍 Good attempt! Continue practicing C programming.";

    }

    else {

        scoreMessage.innerHTML =

            "📚 Keep practicing. Review the explanations and try again.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =

        new Date().toDateString();


    let progress =

        JSON.parse(

            localStorage.getItem(

                "placementProgress"

            )

        ) || {

            streak: 0,

            lastCompleted: "",

            completedTasks: {}

        };


    const taskName =
        "C Programming";


    /* ---------------------------------------------
       CHECK ALREADY COMPLETED
    --------------------------------------------- */

    if (

        progress.completedTasks &&

        progress.completedTasks[taskName] === today

    ) {

        alert(

            "✅ You already completed C Programming today!"

        );

        return;

    }


    /* ---------------------------------------------
       CREATE OBJECT
    --------------------------------------------- */

    if (!progress.completedTasks) {

        progress.completedTasks = {};

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTasks[taskName] = today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (

        progress.lastCompleted !== today

    ) {

        progress.streak++;

        progress.lastCompleted = today;

    }


    /* ---------------------------------------------
       SAVE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 C Programming completed!\n\n" +

        "🔥 Current Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}

</script>



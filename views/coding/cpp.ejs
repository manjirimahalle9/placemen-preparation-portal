<script>


/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "main()",

    2: "<<",

    3: "char",

    4: "for loop",

    5: "0",

    6: "Inheritance",

    7: "vector",

    8: "30",

    9: "class",

    10: "sort()"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "The main() function is the entry point of a C++ program. Program execution begins from main().",


    2:
        "The insertion operator << is used with cout to display output on the screen.",


    3:
        "The char data type is used to store a single character such as 'A' or 'B'.",


    4:
        "A for loop is commonly used when the number of iterations is known in advance.",


    5:
        "C++ arrays use zero-based indexing. Therefore, the first element is stored at index 0.",


    6:
        "Inheritance allows a derived class to acquire properties and behaviors of a base class.",


    7:
        "vector is an STL container that works like a dynamic array and can grow in size.",


    8:
        "a = 10 and b = 20. Therefore, a + b = 10 + 20 = 30.",


    9:
        "The class keyword is used to define a class in C++.",


    10:
        "The sort() algorithm from the C++ STL is commonly used to arrange elements in sorted order."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK QUESTION AS ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE CURRENT BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;


    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    /* ---------------------------------------------
       SHOW SCORE
    --------------------------------------------- */

    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    /* ---------------------------------------------
       SCORE MESSAGE
    --------------------------------------------- */

    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your C++ fundamentals are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing C++.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    /* ---------------------------------------------
       SCROLL TO SCORE
    --------------------------------------------- */

    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTasks: {}

        };


    const taskName =
        "C++ Programming";


    /* ---------------------------------------------
       CHECK OLD PROGRESS FORMAT
    --------------------------------------------- */

    if (!progress.completedTasks) {

        progress.completedTasks = {};

    }


    /* ---------------------------------------------
       ALREADY COMPLETED TODAY
    --------------------------------------------- */

    if (
        progress.completedTasks[taskName] === today
    ) {

        alert(
            "✅ You already completed C++ Programming today!"
        );

        return;

    }


    /* ---------------------------------------------
       MARK TASK COMPLETED
    --------------------------------------------- */

    progress.completedTasks[taskName] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE PROGRESS
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 C++ Programming completed!" +

        "\n\n🔥 Current Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}


</script>



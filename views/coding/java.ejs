=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "main()",

    2: "class",

    3: "boolean",

    4: "extends",

    5: "//",

    6: "30",

    7: "new",

    8: "try",

    9: "0",

    10: "final"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "The main() method is the starting point of execution for a standard Java application.",

    2:
        "The class keyword is used to define a class in Java.",

    3:
        "The boolean data type stores either true or false.",

    4:
        "The extends keyword is used when one Java class inherits another class.",

    5:
        "The // symbol is used to create a single-line comment in Java.",

    6:
        "10 + 20 = 30, so the output is 30.",

    7:
        "The new keyword is used to create an object or instance of a class.",

    8:
        "The try block contains code that may generate an exception.",

    9:
        "Java arrays use zero-based indexing, so the first element is at index 0.",

    10:
        "The final keyword can be used to make a variable constant so its value cannot be reassigned."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {

    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (answeredQuestions.has(questionNumber)) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT ANSWER
    --------------------------------------------- */

    if (selected.value === correctAnswer) {

        score++;

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG ANSWER
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {

    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display = "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Java fundamentals are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Java.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review Java fundamentals and try again.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {

    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTopics: {},

            completedTasks: {}

        };


    const taskName =
        "Java Programming";


    /* ---------------------------------------------
       SUPPORT OLD DATA FORMAT
    --------------------------------------------- */

    if (!progress.completedTasks) {

        progress.completedTasks = {};

    }


    /* ---------------------------------------------
       ALREADY COMPLETED
    --------------------------------------------- */

    if (
        progress.completedTasks[taskName] === today
    ) {

        alert(
            "✅ You already completed Java Programming today!"
        );

        return;

    }


    /* ---------------------------------------------
       SAVE COMPLETION
    --------------------------------------------- */

    progress.completedTasks[taskName] =
        today;


    /* ---------------------------------------------
       ALSO SAVE TOPIC FORMAT
    --------------------------------------------- */

    if (!progress.completedTopics) {

        progress.completedTopics = {};

    }


    progress.completedTopics[taskName] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Java Programming completed!\n\n" +

        "🔥 Current Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       GO TO DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}

</script>



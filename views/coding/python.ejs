</script>


<script>

/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "30",

    2: "print()",

    3: "Yes",

    4: "0 1 2",

    5: "str",

    6: "10",

    7: "def",

    8: "1",

    9: "Dictionary",

    10: "6"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "x + y = 10 + 20 = 30.",

    2:
        "The print() function is used to display output in Python.",

    3:
        "Since x = 5 and 5 > 3 is true, the program prints Yes.",

    4:
        "range(3) generates 0, 1 and 2.",

    5:
        "The str data type is used to store strings or sequences of characters.",

    6:
        "Python uses zero-based indexing, so numbers[0] refers to the first element, which is 10.",

    7:
        "The def keyword is used to define a function in Python.",

    8:
        "The % operator returns the remainder. 10 divided by 3 leaves a remainder of 1.",

    9:
        "A dictionary stores data using key-value pairs.",

    10:
        "The word Python contains 6 characters, so len('Python') returns 6."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {


    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =

            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =

            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +
            selected.parentElement.textContent.trim() +
            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +
            answerText[questionNumber] +
            "</strong><br><br>" +

            "💡 " +
            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {


    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display =
        "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your Python programming skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing Python coding questions.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {


    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTasks: {}

        };


    const taskName =
        "Python Programming";


    /* ---------------------------------------------
       CREATE completedTasks
    --------------------------------------------- */

    if (!progress.completedTasks) {

        progress.completedTasks = {};

    }


    /* ---------------------------------------------
       CHECK COMPLETION
    --------------------------------------------- */

    if (
        progress.completedTasks[taskName] === today
    ) {

        alert(
            "✅ You already completed Python Programming today!"
        );

        return;

    }


    /* ---------------------------------------------
       MARK COMPLETED
    --------------------------------------------- */

    progress.completedTasks[taskName] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE PROGRESS
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 Python Programming completed!\n\n" +

        "🔥 Current Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}

</script>



            </ol>

        </div>

    </div>


    <!-- ==========================================
         PRACTICE QUESTIONS
    =========================================== -->

    <h4 class="mt-5">

        📝 Python Practice Questions

    </h4>


    <!-- QUESTION 1 -->

    <div class="question-card">

        <div class="question-title">
            Question 1
        </div>

        <div class="question-text">

            What is the output of the following Python code?

<pre>
x = 10
y = 20
print(x + y)
</pre>

        </div>

        <label class="option">

            <input type="radio"
                   name="q1"
                   value="20">

            20

        </label>

        <label class="option">

            <input type="radio"
                   name="q1"
                   value="30">

            30

        </label>

        <label class="option">

            <input type="radio"
                   name="q1"
                   value="10">

            10

        </label>

        <label class="option">

            <input type="radio"
                   name="q1"
                   value="Error">

            Error

        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(1, '30')">

            Submit Answer

        </button>

        <div id="result1"
             class="answer-result"></div>

    </div>


    <!-- QUESTION 2 -->

    <div class="question-card">

        <div class="question-title">
            Question 2
        </div>

        <div class="question-text">

            Which function is used to display output in Python?

        </div>

        <label class="option">

            <input type="radio"
                   name="q2"
                   value="input">

            input()

        </label>

        <label class="option">

            <input type="radio"
                   name="q2"
                   value="print">

            print()

        </label>

        <label class="option">

            <input type="radio"
                   name="q2"
                   value="display">

            display()

        </label>

        <label class="option">

            <input type="radio"
                   name="q2"
                   value="output">

            output()

        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(2, 'print')">

            Submit Answer

        </button>

        <div id="result2"
             class="answer-result"></div>

    </div>


    <!-- QUESTION 3 -->

    <div class="question-card">

        <div class="question-title">
            Question 3
        </div>

        <div class="question-text">

            What is the output?

<pre>
x = 5

if x > 3:
    print("Yes")
else:
    print("No")
</pre>

        </div>

        <label class="option">

            <input type="radio"
                   name="q3"
                   value="Yes">

            Yes

        </label>

        <label class="option">

            <input type="radio"
                   name="q3"
                   value="No">

            No

        </label>

        <label class="option">

            <input type="radio"
                   name="q3"
                   value="Error">

            Error

        </label>

        <label class="option">

            <input type="radio"
                   name="q3"
                   value="Nothing">

            Nothing

        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(3, 'Yes')">

            Submit Answer

        </button>

        <div id="result3"
             class="answer-result"></div>

    </div>


    <!-- QUESTION 4 -->

    <div class="question-card">

        <div class="question-title">
            Question 4
        </div>

        <div class="question-text">

            What is the output?

<pre>
for i in range(3):
    print(i)
</pre>

        </div>

        <label class="option">

            <input type="radio"
                   name="q4"
                   value="1 2 3">

            1 2 3

        </label>

        <label class="option">

            <input type="radio"
                   name="q4"
                   value="0 1 2">

            0 1 2

        </label>

        <label class="option">

            <input type="radio"
                   name="q4"
                   value="0 1 2 3">

            0 1 2 3

        </label>

        <label class="option">

            <input type="radio"
                   name="q4"
                   value="Error">

            Error

        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(4, '0 1 2')">

            Submit Answer

        </button>

        <div id="result4"
             class="answer-result"></div>

    </div>


    <!-- QUESTION 5 -->

    <div class="question-card">

        <div class="question-title">
            Question 5
        </div>

        <div class="question-text">

            Which data type is used to store a sequence
            of characters in Python?

        </div>

        <label class="option">

            <input type="radio"
                   name="q5"
                   value="int">

            int

        </label>

        <label class="option">

            <input type="radio"
                   name="q5"
                   value="float">

            float

        </label>

        <label class="option">

            <input type="radio"
                   name="q5"
                   value="str">

            str

        </label>

        <label class="option">

            <input type="radio"
                   name="q5"
                   value="bool">

            bool

        </label>

        <button
            class="submit-question"
            onclick="checkAnswer(5, 'str')">

            Submit Answer

        </button>

        <div id="result5"
             class="answer-result"></div>

    </div>


    <!-- QUESTION 6 -->

    <div class="question-card">

        <div class="question-title">
            Question 6
        </div>

        <div class="question-text">

            What is the output?

<pre>
numbers = [10, 20, 30]

print(numbers[0])
</pre>

        </div>


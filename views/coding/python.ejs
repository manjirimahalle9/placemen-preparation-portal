 <!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Python Programming | PlacementX</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>

        body {
            background: #050706 !important;
            color: white !important;
            min-height: 100vh;
        }

        .container {
            background: #050706;
            max-width: 1000px;
        }

        p,
        li,
        h2,
        h3,
        h4,
        strong {
            color: white;
        }

        /* ==============================
           NAVBAR
        ============================== */

        .navbar {
            background: #050706 !important;
            border-bottom: 1px solid #008c70;
        }

        .navbar-brand {
            color: #00c49c !important;
            font-weight: 700;
        }

        .dashboard-btn {
            background: #008c70;
            border: none;
            color: white;
        }

        .dashboard-btn:hover {
            background: #00a886;
            color: white;
        }

        /* ==============================
           HEADER
        ============================== */

        .header {
            background: #050706;
            color: white;
            padding: 35px;
            text-align: center;
            border-bottom: 1px solid #008c70;
        }

        .header h1 {
            color: #00c49c;
            font-weight: 700;
        }

        .header p {
            color: white;
        }

        /* ==============================
           TITLE
        ============================== */

        .page-title {
            color: #00c49c !important;
            font-weight: 700;
        }

        hr {
            border-color: #008c70;
            opacity: 1;
        }

        /* ==============================
           TOPIC CARDS
        ============================== */

        .topic-card {
            background: #050706 !important;
            color: white !important;
            border: 1px solid #008c70 !important;
            border-radius: 10px;
            margin-bottom: 20px;
            box-shadow:
                0 0 12px rgba(0, 140, 112, 0.10);
        }

        .topic-card .card-body {
            background: #050706 !important;
            color: white !important;
            padding: 22px;
        }

        .topic-card h3 {
            color: #00c49c !important;
            font-weight: 700;
            margin-bottom: 15px;
        }

        /* ==============================
           CODE
        ============================== */

        pre {
            background: #0a100e !important;
            color: #00e6b5 !important;
            padding: 18px;
            border-radius: 8px;
            border: 1px solid #285e51;
            overflow-x: auto;
            line-height: 1.6;
        }

        code {
            color: #00e6b5 !important;
        }

        /* ==============================
           LIST
        ============================== */

        .list-group-item {
            background: #050706 !important;
            color: white !important;
            border-color: #008c70 !important;
        }

        /* ==============================
           ACCORDION
        ============================== */

        .accordion-item {
            background: #050706 !important;
            border-color: #008c70 !important;
        }

        .accordion-button {
            background: #050706 !important;
            color: white !important;
        }

        .accordion-button:not(.collapsed) {
            background: #008c70 !important;
            color: white !important;
        }

        .accordion-body {
            background: #050706 !important;
            color: white !important;
        }

        .accordion-button::after {
            filter: brightness(0) invert(1);
        }

        /* ==============================
           QUESTION CARD
        ============================== */

        .question-card {
            background: #050706 !important;
            color: white !important;
            border: 1px solid #008c70 !important;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 20px;
            box-shadow:
                0 0 12px rgba(0, 140, 112, 0.10);
        }

        .question-title {
            color: #00c49c !important;
            font-size: 19px;
            font-weight: 700;
            margin-bottom: 12px;
        }

        .question-text {
            line-height: 1.7;
            margin-bottom: 18px;
        }

        /* ==============================
           OPTIONS
        ============================== */

        .option {
            display: block;
            background: #0a100e;
            color: white;
            border: 1px solid #285e51;
            border-radius: 8px;
            padding: 12px 15px;
            margin-bottom: 10px;
            cursor: pointer;
            transition: 0.25s;
        }

        .option:hover {
            background: #0d1c18;
            border-color: #00c49c;
        }

        .option input {
            margin-right: 10px;
            accent-color: #00c49c;
        }

        /* ==============================
           SUBMIT QUESTION
        ============================== */

        .submit-question {
            background: #008c70;
            border: none;
            color: white;
            padding: 9px 20px;
            border-radius: 7px;
            font-weight: 600;
            cursor: pointer;
        }

        .submit-question:hover {
            background: #00a886;
            color: white;
        }

        .submit-question:disabled {
            opacity: 0.6;
            cursor: not-allowed;
        }

        /* ==============================
           ANSWER RESULT
        ============================== */

        .answer-result {
            display: none;
            margin-top: 15px;
            padding: 15px;
            border-radius: 8px;
            line-height: 1.7;
        }

        .correct-result {
            background: #073d2f;
            border: 1px solid #00c49c;
        }

        .wrong-result {
            background: #351414;
            border: 1px solid #dc3545;
        }

        .correct-result strong,
        .wrong-result strong {
            color: white;
        }

        /* ==============================
           FINAL SCORE
        ============================== */

        #finalScore {
            display: none;
            background: #071d17;
            border: 2px solid #00c49c;
            border-radius: 12px;
            padding: 25px;
            margin-top: 30px;
            text-align: center;
        }

        #finalScore h3 {
            color: #00c49c !important;
        }

        #scoreText,
        #scoreMessage {
            color: white !important;
        }

        /* ==============================
           PREPARATION ALERT
        ============================== */

        .alert-success {
            background: #050706 !important;
            color: white !important;
            border: 1px solid #008c70 !important;
        }

        /* ==============================
           TABLE
        ============================== */

        .table {
            background: #050706 !important;
            color: white !important;
        }

        .table tbody tr,
        .table tbody td {
            background: #050706 !important;
            color: white !important;
            border-color: #008c70 !important;
        }

        .table-primary,
        .table-primary th {
            background: #008c70 !important;
            color: white !important;
        }

        /* ==============================
           BUTTONS
        ============================== */

        .main-submit {
            background: #008c70;
            border: none;
            color: white;
        }

        .main-submit:hover {
            background: #00a886;
            color: white;
        }

        .complete-btn {
            background: #198754;
            border: none;
            color: white;
        }

        .complete-btn:hover {
            background: #157347;
            color: white;
        }

        .back-btn {
            background: #008c70;
            border: none;
            color: white;
        }

        .back-btn:hover {
            background: #00a886;
            color: white;
        }

        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 576px) {

            .container {
                padding-left: 15px;
                padding-right: 15px;
            }

            .question-card {
                padding: 16px;
            }

            .topic-card .card-body {
                padding: 17px;
            }

            pre {
                font-size: 13px;
            }

            .bottom-buttons a,
            .bottom-buttons button {
                width: 100%;
                margin: 5px 0 !important;
            }
        }

    </style>

</head>


<body>



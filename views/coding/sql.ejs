</ul>


<!-- ==========================================
     SQL TOPICS
=========================================== -->

<h4>

    📖 SQL Topics and Examples

</h4>


<div class="accordion"
     id="sqlTopics">


<!-- SQL BASICS -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#basicSQL">

            1. Basic SQL Program

        </button>

    </h2>


    <div
        id="basicSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            SQL is used to communicate with relational databases.

<pre>
CREATE DATABASE College;

USE College;

CREATE TABLE Students (
    id INT,
    name VARCHAR(50),
    age INT
);
</pre>

        </div>

    </div>

</div>


<!-- SELECT -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#selectSQL">

            2. SELECT Statement

        </button>

    </h2>


    <div
        id="selectSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            The SELECT statement is used to retrieve data
            from a table.

<pre>
SELECT * FROM Students;

SELECT name, age
FROM Students;
</pre>

        </div>

    </div>

</div>


<!-- WHERE -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#whereSQL">

            3. WHERE Clause

        </button>

    </h2>


    <div
        id="whereSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            WHERE is used to filter records based on a condition.

<pre>
SELECT *
FROM Students
WHERE age > 18;
</pre>

        </div>

    </div>

</div>


<!-- ORDER BY -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#orderSQL">

            4. ORDER BY

        </button>

    </h2>


    <div
        id="orderSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            ORDER BY is used to sort query results.

<pre>
SELECT *
FROM Students
ORDER BY age ASC;

SELECT *
FROM Students
ORDER BY age DESC;
</pre>

        </div>

    </div>

</div>


<!-- INSERT -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#insertSQL">

            5. INSERT Statement

        </button>

    </h2>


    <div
        id="insertSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            INSERT is used to add new records to a table.

<pre>
INSERT INTO Students
(id, name, age)
VALUES
(1, 'Rahul', 20);
</pre>

        </div>

    </div>

</div>


<!-- UPDATE -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#updateSQL">

            6. UPDATE Statement

        </button>

    </h2>


    <div
        id="updateSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            UPDATE is used to modify existing records.

<pre>
UPDATE Students
SET age = 21
WHERE id = 1;
</pre>

        </div>

    </div>

</div>


<!-- DELETE -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#deleteSQL">

            7. DELETE Statement

        </button>

    </h2>


    <div
        id="deleteSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            DELETE is used to remove records from a table.

<pre>
DELETE FROM Students
WHERE id = 1;
</pre>

        </div>

    </div>

</div>


<!-- AGGREGATE -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#aggregateSQL">

            8. Aggregate Functions

        </button>

    </h2>


    <div
        id="aggregateSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            Aggregate functions perform calculations on multiple
            rows.

            <ul>

                <li>COUNT()</li>
                <li>SUM()</li>
                <li>AVG()</li>
                <li>MAX()</li>
                <li>MIN()</li>

            </ul>

<pre>
SELECT COUNT(*)
FROM Students;

SELECT AVG(age)
FROM Students;

SELECT MAX(age)
FROM Students;

SELECT MIN(age)
FROM Students;

SELECT SUM(age)
FROM Students;
</pre>

        </div>

    </div>

</div>


<!-- GROUP BY -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#groupSQL">

            9. GROUP BY

        </button>

    </h2>


    <div
        id="groupSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            GROUP BY groups rows having the same values.

<pre>
SELECT department, COUNT(*)
FROM Students
GROUP BY department;
</pre>

        </div>

    </div>

</div>


<!-- HAVING -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#havingSQL">

            10. HAVING Clause

        </button>

    </h2>


    <div
        id="havingSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            HAVING is used to filter grouped records.

<pre>
SELECT department, COUNT(*)
FROM Students
GROUP BY department
HAVING COUNT(*) > 2;
</pre>

        </div>

    </div>

</div>


<!-- JOINS -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#joinsSQL">

            11. SQL Joins

        </button>

    </h2>


    <div
        id="joinsSQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            Joins are used to combine data from multiple tables.

            <ul>

                <li>INNER JOIN</li>
                <li>LEFT JOIN</li>
                <li>RIGHT JOIN</li>
                <li>FULL JOIN</li>

            </ul>

<pre>
SELECT Students.name,
       Courses.course_name

FROM Students

INNER JOIN Courses

ON Students.course_id =
   Courses.course_id;
</pre>

        </div>

    </div>

</div>


<!-- SUBQUERY -->

<div class="accordion-item">

    <h2 class="accordion-header">

        <button
            class="accordion-button collapsed"
            data-bs-toggle="collapse"
            data-bs-target="#subquerySQL">

            12. Subquery

        </button>

    </h2>


    <div
        id="subquerySQL"
        class="accordion-collapse collapse">

        <div class="accordion-body">

            A subquery is a query inside another SQL query.

<pre>
SELECT name
FROM Students
WHERE age >
(
    SELECT AVG(age)
    FROM Students
);
</pre>

        </div>

    </div>

</div>


</div>



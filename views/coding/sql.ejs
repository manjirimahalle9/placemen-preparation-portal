     BOOTSTRAP JAVASCRIPT
=========================================== -->

<script
    src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
</script>


<script>

/* =================================================
   SCORE VARIABLES
================================================= */

let score = 0;

let answeredQuestions = new Set();


/* =================================================
   ANSWER INFORMATION
================================================= */

const answerText = {

    1: "SELECT",
    2: "WHERE",
    3: "INSERT",
    4: "COUNT()",
    5: "ORDER BY",
    6: "Primary Key",
    7: "GROUP BY",
    8: "UPDATE",
    9: "INNER JOIN",
    10: "MAX()"

};


/* =================================================
   EXPLANATIONS
================================================= */

const explanations = {

    1:
        "SELECT is used to retrieve data from a database table.",

    2:
        "WHERE is used to filter records based on a condition.",

    3:
        "INSERT is used to add new records to a table.",

    4:
        "COUNT() returns the number of rows or records.",

    5:
        "ORDER BY is used to sort query results in ascending or descending order.",

    6:
        "A Primary Key uniquely identifies each record in a table.",

    7:
        "GROUP BY groups rows having the same values.",

    8:
        "UPDATE is used to modify existing records in a table.",

    9:
        "INNER JOIN returns records that have matching values in both tables.",

    10:
        "MAX() returns the highest value from a column."

};


/* =================================================
   CHECK INDIVIDUAL QUESTION
================================================= */

function checkAnswer(questionNumber, correctAnswer) {

    const selected =
        document.querySelector(
            `input[name="q${questionNumber}"]:checked`
        );


    const result =
        document.getElementById(
            `result${questionNumber}`
        );


    /* ---------------------------------------------
       NO OPTION SELECTED
    --------------------------------------------- */

    if (!selected) {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";

        result.innerHTML =
            "⚠️ <strong>Please select an option first.</strong>";

        return;

    }


    /* ---------------------------------------------
       ALREADY ANSWERED
    --------------------------------------------- */

    if (
        answeredQuestions.has(questionNumber)
    ) {

        result.style.display = "block";

        result.className =
            "answer-result correct-result";

        result.innerHTML =
            "ℹ️ <strong>This question has already been submitted.</strong>";

        return;

    }


    /* ---------------------------------------------
       MARK ANSWERED
    --------------------------------------------- */

    answeredQuestions.add(questionNumber);


    /* ---------------------------------------------
       CORRECT
    --------------------------------------------- */

    if (
        selected.value === correctAnswer
    ) {

        score++;


        result.style.display = "block";

        result.className =
            "answer-result correct-result";


        result.innerHTML =
            "✅ <strong>Correct Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* ---------------------------------------------
       WRONG
    --------------------------------------------- */

    else {

        result.style.display = "block";

        result.className =
            "answer-result wrong-result";


        result.innerHTML =
            "❌ <strong>Incorrect Answer!</strong><br><br>" +

            "Your answer: <strong>" +

            selected.parentElement.textContent.trim() +

            "</strong><br><br>" +

            "✅ Correct Answer: <strong>" +

            answerText[questionNumber] +

            "</strong><br><br>" +

            "💡 " +

            explanations[questionNumber];

    }


    /* ---------------------------------------------
       DISABLE OPTIONS
    --------------------------------------------- */

    const options =
        document.querySelectorAll(
            `input[name="q${questionNumber}"]`
        );


    options.forEach(function(option) {

        option.disabled = true;

    });


    /* ---------------------------------------------
       DISABLE BUTTON
    --------------------------------------------- */

    const currentCard =
        result.closest(".question-card");


    const currentButton =
        currentCard.querySelector(
            ".submit-question"
        );


    currentButton.disabled = true;

    currentButton.innerText =
        "✓ Answer Submitted";

}


/* =================================================
   CALCULATE FINAL SCORE
================================================= */

function calculateScore() {

    const finalScore =
        document.getElementById(
            "finalScore"
        );


    const scoreText =
        document.getElementById(
            "scoreText"
        );


    const scoreMessage =
        document.getElementById(
            "scoreMessage"
        );


    finalScore.style.display =
        "block";


    scoreText.innerHTML =
        "Your Score: " +
        score +
        " / 10";


    if (score === 10) {

        scoreMessage.innerHTML =
            "🏆 Excellent! You got all 10 questions correct!";

    }

    else if (score >= 8) {

        scoreMessage.innerHTML =
            "🌟 Great job! Your SQL skills are strong.";

    }

    else if (score >= 5) {

        scoreMessage.innerHTML =
            "👍 Good attempt! Keep practicing SQL queries.";

    }

    else {

        scoreMessage.innerHTML =
            "📚 Keep practicing. Review the explanations and try again.";

    }


    finalScore.scrollIntoView({

        behavior: "smooth",

        block: "center"

    });

}


/* =================================================
   COMPLETE TODAY'S TASK
================================================= */

function completeTopic() {

    const today =
        new Date().toDateString();


    let progress =
        JSON.parse(
            localStorage.getItem(
                "placementProgress"
            )
        ) || {

            streak: 0,

            lastCompleted: "",

            completedTasks: {}

        };


    const taskName =
        "SQL Programming";


    /* ---------------------------------------------
       CREATE completedTasks
    --------------------------------------------- */

    if (!progress.completedTasks) {

        progress.completedTasks = {};

    }


    /* ---------------------------------------------
       CHECK COMPLETION
    --------------------------------------------- */

    if (
        progress.completedTasks[taskName] === today
    ) {

        alert(
            "✅ You already completed SQL Programming today!"
        );

        return;

    }


    /* ---------------------------------------------
       MARK COMPLETED
    --------------------------------------------- */

    progress.completedTasks[taskName] =
        today;


    /* ---------------------------------------------
       UPDATE STREAK
    --------------------------------------------- */

    if (
        progress.lastCompleted !== today
    ) {

        progress.streak++;

        progress.lastCompleted =
            today;

    }


    /* ---------------------------------------------
       SAVE PROGRESS
    --------------------------------------------- */

    localStorage.setItem(

        "placementProgress",

        JSON.stringify(progress)

    );


    /* ---------------------------------------------
       SUCCESS MESSAGE
    --------------------------------------------- */

    alert(

        "🎉 SQL Programming completed!\n\n" +

        "🔥 Current Streak: " +

        progress.streak +

        " day(s)"

    );


    /* ---------------------------------------------
       DASHBOARD
    --------------------------------------------- */

    window.location.href =
        "/dashboard";

}

</script>



        }

        .topic-card .card-body {
            background: #050706 !important;
            color: white !important;
            padding: 22px;
        }

        .topic-card h3 {
            color: #00c49c !important;
            font-weight: 700;
            margin-bottom: 15px;
        }

        /* ==============================
           CODE
        ============================== */

        pre {
            background: #0a100e !important;
            color: #00e6b5 !important;
            padding: 18px;
            border-radius: 8px;
            border: 1px solid #285e51;
            overflow-x: auto;
            line-height: 1.6;
        }

        code {
            color: #00e6b5 !important;
        }

        /* ==============================
           LIST
        ============================== */

        .list-group-item {
            background: #050706 !important;
            color: white !important;

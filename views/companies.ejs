 <!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Companies | PlacementX</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="preconnect"
        href="https://fonts.googleapis.com">

    <link
        rel="preconnect"
        href="https://fonts.gstatic.com"
        crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
        rel="stylesheet">

    <style>

        /* =====================================================
           GLOBAL
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            font-family: "Inter", sans-serif;
            color: #eafff9;
            background:
                radial-gradient(circle at 10% 10%, rgba(0, 196, 156, 0.14), transparent 28%),
                radial-gradient(circle at 90% 20%, rgba(0, 140, 112, 0.14), transparent 28%),
                radial-gradient(circle at 50% 100%, rgba(0, 255, 204, 0.08), transparent 35%),
                #050807;
            min-height: 100vh;
            overflow-x: hidden;
        }


        /* =====================================================
           ANIMATED BACKGROUND
        ===================================================== */

        .background-glow {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: -2;
            overflow: hidden;
        }

        .glow {
            position: absolute;
            width: 350px;
            height: 350px;
            border-radius: 50%;
            filter: blur(90px);
            opacity: .18;
            animation: floatGlow 10s ease-in-out infinite alternate;
        }

        .glow.one {
            background: #00c49c;
            top: 5%;
            left: -100px;
        }

        .glow.two {
            background: #008c70;
            right: -100px;
            top: 35%;
            animation-delay: 2s;
        }

        .glow.three {
            background: #00ffd0;
            bottom: -120px;
            left: 40%;
            animation-delay: 4s;
        }

        @keyframes floatGlow {

            from {
                transform: translate(0, 0) scale(1);
            }

            to {
                transform: translate(50px, -35px) scale(1.15);
            }

        }


        .grid-background {
            position: fixed;
            inset: 0;
            z-index: -3;
            opacity: .12;
            background-image:
                linear-gradient(rgba(0, 196, 156, .16) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 196, 156, .16) 1px, transparent 1px);
            background-size: 55px 55px;
            mask-image: linear-gradient(to bottom, black, transparent);
        }


        /* =====================================================
           NAVBAR
        ===================================================== */

        .navbar {
            background: rgba(5, 12, 10, .78) !important;
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(0, 196, 156, .14);
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar-brand {
            color: #ffffff !important;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: -.4px;
        }

        .brand-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            background: #00c49c;
            border-radius: 50%;
            margin-right: 8px;
            box-shadow: 0 0 15px #00c49c;
        }

        .nav-dashboard {
            color: #d9fff6;
            border: 1px solid rgba(0, 196, 156, .35);
            background: rgba(0, 196, 156, .08);
            border-radius: 10px;
            padding: 9px 18px;
            font-weight: 600;
            transition: .3s;
            text-decoration: none;
        }

        .nav-dashboard:hover {
            color: #ffffff;
            background: #008c70;
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(0, 196, 156, .2);
        }


        /* =====================================================
           MAIN CONTAINER
        ===================================================== */

        .main-container {
            max-width: 1250px;
            margin: auto;
            padding: 35px 20px 60px;
        }


        /* =====================================================
           HERO
        ===================================================== */

        .hero {
            position: relative;
            overflow: hidden;
            padding: 65px 30px;
            text-align: center;
            border-radius: 28px;
            background:
                linear-gradient(
                    135deg,
                    rgba(0, 140, 112, .25),
                    rgba(0, 196, 156, .07)
                );
            border: 1px solid rgba(0, 196, 156, .22);
            box-shadow:
                0 30px 80px rgba(0, 0, 0, .35),
                inset 0 1px rgba(255, 255, 255, .05);
        }

        .hero::before {
            content: "";
            position: absolute;
            width: 500px;
            height: 500px;
            border: 1px solid rgba(0, 196, 156, .08);
            border-radius: 50%;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            animation: pulseRing 5s linear infinite;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            border: 1px solid rgba(0, 196, 156, .04);
            border-radius: 50%;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
        }

        @keyframes pulseRing {

            0% {
                transform: translate(-50%, -50%) scale(.85);
                opacity: .2;
            }

            50% {
                transform: translate(-50%, -50%) scale(1);
                opacity: .7;
            }

            100% {
                transform: translate(-50%, -50%) scale(1.12);
                opacity: 0;
            }

        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 50px;
            background: rgba(0, 196, 156, .10);
            border: 1px solid rgba(0, 196, 156, .25);
            color: #68ffdc;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 20px;
        }

        .hero h1 {
            font-size: clamp(34px, 5vw, 62px);
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 15px;
        }.gradient-text {
    background: linear-gradient(90deg, #00f5c4, #00a8ff);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
}

        .hero p {
            color: #9dbab3;
            max-width: 720px;
            margin: auto;
            line-height: 1.8;
            font-size: 15px;
        }


        /* =====================================================
           STATS
        ===================================================== */

        .stats-row {
            margin-top: 25px;
        }

        .stat-card {
            height: 100%;
            padding: 22px;
            border-radius: 18px;
            background: rgba(11, 22, 19, .72);
            border: 1px solid rgba(0, 196, 156, .14);
            backdrop-filter: blur(15px);
            transition: .3s;
        }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: rgba(0, 196, 156, .35);
            box-shadow: 0 15px 40px rgba(0, 196, 156, .08);
        }

        .stat-icon {
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            background: rgba(0, 196, 156, .10);
            font-size: 22px;
            margin-bottom: 12px;
        }

        .stat-number {
            font-size: 28px;
            font-weight: 800;
        }

        .stat-label {
            color: #78958e;
            font-size: 12px;
            margin-top: 4px;
        }


        /* =====================================================
           SECTION
        ===================================================== */

        .section-title {
            margin-top: 48px;
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .section-title h2 {
            font-size: 25px;
            font-weight: 800;
            margin: 0;
        }

        .section-title p {
            color: #708a84;
            font-size: 13px;
            margin: 5px 0 0;
        }


        /* =====================================================
           SEARCH
        ===================================================== */

        .search-box {
            position: relative;
            margin-bottom: 25px;
        }

        .search-box input {
            width: 100%;
            background: rgba(9, 20, 17, .8);
            border: 1px solid rgba(0, 196, 156, .18);
            border-radius: 14px;
            padding: 15px 20px 15px 48px;
            color: white;
            outline: none;
            transition: .3s;
        }

        .search-box input::placeholder {
            color: #658079;
        }

        .search-box input:focus {
            border-color: #00c49c;
            box-shadow: 0 0 0 4px rgba(0, 196, 156, .08);
        }

        .search-icon {
            position: absolute;
            left: 17px;
            top: 13px;
            font-size: 20px;
            color: #00c49c;
        }


        /* =====================================================
           COMPANY CARD
        ===================================================== */

        .company-card {
            height: 100%;
            position: relative;
            overflow: hidden;
            padding: 26px;
            border-radius: 22px;
            background:
                linear-gradient(
                    145deg,
                    rgba(16, 31, 27, .92),
                    rgba(7, 16, 14, .92)
                );
            border: 1px solid rgba(0, 196, 156, .13);
            transition: .4s cubic-bezier(.2,.8,.2,1);
        }

        .company-card::before {
            content: "";
            position: absolute;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: rgba(0, 196, 156, .08);
            filter: blur(35px);
            right: -50px;
            top: -50px;
        }

        .company-card:hover {
            transform: translateY(-9px);
            border-color: rgba(0, 196, 156, .42);
            box-shadow:
                0 25px 60px rgba(0, 0, 0, .45),
                0 0 30px rgba(0, 196, 156, .06);
        }

        .company-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            position: relative;
            z-index: 2;
        }

        .company-icon {
            width: 62px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            font-size: 30px;
            background:
                linear-gradient(
                    145deg,
                    rgba(0, 196, 156, .18),
                    rgba(0, 140, 112, .05)
                );
            border: 1px solid rgba(0, 196, 156, .20);
            box-shadow: inset 0 1px rgba(255,255,255,.05);
        }

        .company-rank {
            color: #5affd9;
            background: rgba(0, 196, 156, .08);
            border: 1px solid rgba(0, 196, 156, .18);
            border-radius: 50px;
            padding: 6px 10px;
            font-size: 11px;
            font-weight: 700;
        }

        .company-card h4 {
            margin-top: 20px;
            margin-bottom: 5px;
            font-size: 21px;
            font-weight: 800;
        }

        .company-name {
            color: #79958e;
            font-size: 12px;
            margin-bottom: 15px;
        }

        .company-desc {
            color: #9cb3ad;
            line-height: 1.7;
            font-size: 13px;
            min-height: 65px;
        }

        .skill-tag {
            display: inline-block;
            padding: 5px 9px;
            margin: 3px 2px;
            border-radius: 7px;
            font-size: 10px;
            color: #8dfff0;
            background: rgba(0, 196, 156, .07);
            border: 1px solid rgba(0, 196, 156, .12);
        }

        .readiness {
            margin-top: 18px;
        }

        .readiness-header {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            color: #79958e;
            margin-bottom: 7px;
        }

        .progress {
            height: 5px;
            background: rgba(255,255,255,.06);
            border-radius: 10px;
        }

        .progress-bar {
            background: linear-gradient(90deg, #008c70, #00d5a9);
            border-radius: 10px;
        }

        .company-btn {
            width: 100%;
            margin-top: 20px;
            padding: 11px;
            border-radius: 11px;
            border: 1px solid rgba(0, 196, 156, .25);
            background: rgba(0, 196, 156, .08);
            color: #7fffe5;
            font-weight: 700;
            transition: .3s;
        }

        .company-btn:hover {
            background: #008c70;
            color: #ffffff;
            transform: translateY(-2px);
        }


        /* =====================================================
           PREPARATION CARDS
        ===================================================== */

        .prep-card {
            height: 100%;
            padding: 24px;
            border-radius: 18px;
            background: rgba(9, 20, 17, .75);
            border: 1px solid rgba(0, 196, 156, .13);
            transition: .35s;
        }

        .prep-card:hover {
            transform: translateY(-6px);
            border-color: rgba(0, 196, 156, .35);
        }

        .prep-icon {
            width: 52px;
            height: 52px;
            display: flex;
            justify-content: center;
            align-items: center;
            border-radius: 15px;
            background: rgba(0, 196, 156, .10);
            font-size: 25px;
            margin-bottom: 16px;
        }

        .prep-card h5 {
            font-weight: 800;
        }

        .prep-card p {
            color: #819b94;
            font-size: 12px;
            line-height: 1.7;
            min-height: 55px;
        }

        .prep-btn {
            display: block;
            text-align: center;
            text-decoration: none;
            padding: 10px;
            border-radius: 10px;
            color: #8dffea;
            border: 1px solid rgba(0, 196, 156, .18);
            background: rgba(0, 196, 156, .06);
            font-size: 12px;
            font-weight: 700;
            transition: .3s;
        }

        .prep-btn:hover {
            color: #fff;
            background: #008c70;
        }


        /* =====================================================
           PROCESS TIMELINE
        ===================================================== */

        .timeline {
            position: relative;
            margin-top: 30px;
        }

        .timeline::before {
            content: "";
            position: absolute;
            left: 24px;
            top: 10px;
            bottom: 10px;
            width: 2px;
            background: linear-gradient(
                #00c49c,
                rgba(0,196,156,.05)
            );
        }

        .timeline-item {
            position: relative;
            padding-left: 65px;
            margin-bottom: 25px;
        }

        .timeline-number {
            position: absolute;
            left: 0;
            top: 0;
            width: 50px;
            height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 15px;
            background: #091914;
            border: 1px solid rgba(0, 196, 156, .35);
            color: #55ffda;
            font-weight: 800;
            z-index: 2;
        }

        .timeline-content {
            padding: 18px 20px;
            border-radius: 15px;
            background: rgba(10, 22, 19, .7);
            border: 1px solid rgba(0, 196, 156, .11);
        }

        .timeline-content h6 {
            font-weight: 800;
            margin-bottom: 5px;
        }

        .timeline-content p {
            color: #819b94;
            font-size: 12px;
            margin: 0;
        }


        /* =====================================================
           MODAL
        ===================================================== */

        .modal-content {
            background: #0a1713;
            color: #eafff9;
            border: 1px solid rgba(0,196,156,.25);
            border-radius: 20px;
            overflow: hidden;
        }

        .modal-header {
            background:
                linear-gradient(
                    135deg,
                    rgba(0,140,112,.3),
                    rgba(0,196,156,.05)
                );
            border-bottom: 1px solid rgba(0,196,156,.13);
        }

        .modal-title {
            font-weight: 800;
        }

        .modal-body {
            color: #a3bbb5;
        }

        .modal-body li {
            margin-bottom: 10px;
        }

        .modal-body li::marker {
            color: #00c49c;
        }

        .btn-close {
            filter: invert(1);
        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {
            margin-top: 60px;
            padding: 25px;
            text-align: center;
            border-top: 1px solid rgba(0,196,156,.1);
            color: #617b74;
            font-size: 12px;
        }

        .footer strong {
            color: #00c49c;
        }


        /* =====================================================
           RESPONSIVE
        ===================================================== */

        @media(max-width:768px) {

            .main-container {
                padding: 20px 14px 45px;
            }

            .hero {
                padding: 45px 20px;
                border-radius: 20px;
            }

            .hero h1 {
                letter-spacing: -1px;
            }

            .section-title {
                margin-top: 35px;
            }

            .stat-card {
                padding: 18px;
            }

        }

    </style>

</head>


<body>


    <!-- =====================================================
         BACKGROUND
    ===================================================== -->

    <div class="background-glow">

        <div class="glow one"></div>

        <div class="glow two"></div>

        <div class="glow three"></div>

    </div>


    <div class="grid-background"></div>


    <!-- =====================================================
         NAVBAR
    ===================================================== -->

    <nav class="navbar navbar-dark">

        <div class="container">

            <span class="navbar-brand">

                <span class="brand-dot"></span>

                PlacementX

            </span>


            <a
                href="/dashboard"
                class="nav-dashboard">

                ← Dashboard

            </a>

        </div>

    </nav>


    <main class="main-container">


        <!-- =================================================
             HERO
        ================================================= -->

        <section class="hero">

            <div class="hero-content">

                <div class="hero-badge">

                    🚀 CAREER INTELLIGENCE

                </div>


                <h1>

                    <span class="gradient-text">

                        Placement Companies

                    </span>

                </h1>


                <p>

                    Explore top companies, understand their hiring
                    process, identify required skills and prepare
                    strategically for your placement journey.

                </p>

            </div>

        </section>


        <!-- =================================================
             STATS
        ================================================= -->

        <div class="row g-3 stats-row">


            <div class="col-6 col-lg-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        🏢
                    </div>

                    <div class="stat-number">
                        16+
                    </div>

                    <div class="stat-label">
                        Featured Companies
                    </div>

                </div>

            </div>


            <div class="col-6 col-lg-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        💻
                    </div>

                    <div class="stat-number">
                        12+
                    </div>

                    <div class="stat-label">
                        Core Skill Areas
                    </div>

                </div>

            </div>


            <div class="col-6 col-lg-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        🎯
                    </div>

                    <div class="stat-number">
                        04
                    </div>

                    <div class="stat-label">
                        Main Selection Rounds
                    </div>

                </div>

            </div>


            <div class="col-6 col-lg-3">

                <div class="stat-card">

                    <div class="stat-icon">
                        📈
                    </div>

                    <div class="stat-number">
                        360°
                    </div>

                    <div class="stat-label">
                        Preparation Approach
                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             COMPANY SECTION
        ================================================= -->

        <div class="section-title">

            <div>

                <h2>
                    ⭐ Top Companies
                </h2>

                <p>
                    Choose a company and start your preparation.
                </p>

            </div>

        </div>


        <!-- SEARCH -->

        <div class="search-box">

            <span class="search-icon">
                🔍
            </span>


            <input
                type="text"
                id="companySearch"
                placeholder="Search company... e.g. TCS, Infosys, IBM">

        </div>


        <div
            class="row g-4"
            id="companyContainer">


            <!-- =================================================
                 TCS
            ================================================= -->

            <div
                class="col-md-6 col-lg-4 company-item"
                data-company="tcs tata consultancy services">

                <div class="company-card">

                    <div class="company-top">

                        <div class="company-icon">
                            💻
                        </div>

                        <div class="company-rank">
                            TOP PICK
                        </div>

                    </div>

                    <h4>TCS</h4>

                    <div class="company-name">
                        Tata Consultancy Services
                    </div>

                    <p class="company-desc">
                        Focus on aptitude, coding, technical
                        knowledge and communication skills.
                    </p>

                    <div>

                        <span class="skill-tag">Aptitude</span>
                        <span class="skill-tag">Coding</span>
                        <span class="skill-tag">SQL</span>
                        <span class="skill-tag">DBMS</span>

                    </div>

                    <div class="readiness">

                        <div class="readiness-header">
                            <span>Preparation Level</span>
                            <span>90%</span>
                        </div>

                        <div class="progress">

                            <div
                                class="progress-bar"
                                style="width:90%">
                            </div>

                        </div>

                    </div>

                    <button
                        class="company-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#tcsModal">

                        View Preparation →

                    </button>

                </div>

            </div>


            <!-- =================================================
                 INFOSYS
            ================================================= -->

            <div
                class="col-md-6 col-lg-4 company-item"
                data-company="infosys infosys limited">

                <div class="company-card">

                    <div class="company-top">

                        <div class="company-icon">
                            🌐
                        </div>

                        <div class="company-rank">
                            POPULAR
                        </div>

                    </div>

                    <h4>Infosys</h4>

                    <div class="company-name">
                        Infosys Limited
                    </div>

                    <p class="company-desc">
                        Prepare programming, aptitude,
                        problem solving and technical concepts.
                    </p>

                    <div>

                        <span class="skill-tag">Programming</span>
                        <span class="skill-tag">Aptitude</span>
                        <span class="skill-tag">DBMS</span>
                        <span class="skill-tag">Problem Solving</span>

                    </div>

                    <div class="readiness">

                        <div class="readiness-header">
                            <span>Preparation Level</span>
                            <span>85%</span>
                        </div>

                        <div class="progress">

                            <div
                                class="progress-bar"
                                style="width:85%">
                            </div>

                        </div>

                    </div>

                    <button
                        class="company-btn"
                        data-bs-toggle="modal"
                        data-bs-target="#infosysModal">

                        View Preparation →

                    </button>

                </div>

            </div>


            <!-- =================================================
                 WIPRO
            ================================================= -->

            <div
                class="col-md-6 col-lg-4 company-item"
                data-company="wipro wipro limited">

                <div class="company-card">

                    <div class="company-top">

                        <div class="company-icon">
                            🚀
                        </div>

                        <div class="company-rank">
                            TARGET
                        </div>

                    </div>

                    <h4>Wipro</h4>

                    <div class="company-name">
                        Wipro Limited
                    </div>

                    <p class="company-desc">
                        Prepare aptitude, logical reasoning,
                        coding and communication skills.
                    </p>

                    <div>

                        <span class="skill-tag">Reasoning</span>
                        <span class="skill-tag">Coding</span>
                        <span class="skill-tag">Verbal</span>

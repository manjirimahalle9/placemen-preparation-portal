            border-radius: 10px;

            font-size: 14px;

            color:
                rgba(255,255,255,.7);

            transition: .3s;

        }

        .secondary-btn:hover {

            border-color:
                var(--green);

            color:
                var(--green-light);

        }


        /* =========================================================
           HERO 3D OBJECT
        ========================================================= */

        .hero-visual {

            position: absolute;

            right: 4%;

            width: 43%;
            height: 600px;

            display: flex;

            align-items: center;
            justify-content: center;

            perspective: 1200px;

        }

        .scene {

            width: 400px;
            height: 400px;

            position: relative;

            transform-style:
                preserve-3d;

            animation:
                sceneFloat 6s
                ease-in-out infinite;

        }

        @keyframes sceneFloat {

            0%,100% {

                transform:
                    translateY(0)
                    rotateX(0deg)
                    rotateY(0deg);

            }

            50% {

                transform:
                    translateY(-20px)
                    rotateX(5deg)
                    rotateY(10deg);

            }

        }

        .core {

            position: absolute;

            left: 50%;
            top: 50%;

            width: 145px;
            height: 145px;

            transform:
                translate(-50%,-50%)
                rotateX(55deg)
                rotateZ(45deg);

            border:
                1px solid
                rgba(0,245,196,.65);

            border-radius: 30px;

            background:

                linear-gradient(
                    135deg,
                    rgba(0,245,196,.2),
                    rgba(255,255,255,.02)
                );

            box-shadow:

                0 0 70px
                rgba(0,245,196,.25),

                inset 0 0 30px
                rgba(0,245,196,.08);

            animation:
                coreRotate 8s
                linear infinite;

        }

        @keyframes coreRotate {

            from {

                transform:
                    translate(-50%,-50%)
                    rotateX(55deg)
                    rotateZ(0deg);

            }

            to {

                transform:
                    translate(-50%,-50%)
                    rotateX(55deg)
                    rotateZ(360deg);

            }

        }

        .ring {

            position: absolute;

            left: 50%;
            top: 50%;

            border:
                1px solid
                rgba(0,245,196,.25);

            border-radius: 50%;

            transform-style:
                preserve-3d;

        }

        .ring.one {

            width: 350px;
            height: 130px;

            transform:
                translate(-50%,-50%)
                rotateX(65deg);

            animation:
                ringOne 8s
                linear infinite;

        }

        .ring.two {

            width: 300px;
            height: 110px;

            transform:
                translate(-50%,-50%)
                rotateY(65deg);

            animation:
                ringTwo 10s
                linear infinite;

        }

        .ring.three {

            width: 260px;
            height: 260px;

            transform:
                translate(-50%,-50%)
                rotateX(70deg)
                rotateZ(20deg);

            animation:
                ringThree 12s
                linear infinite;

        }

        @keyframes ringOne {

            to {

                transform:
                    translate(-50%,-50%)
                    rotateX(65deg)
                    rotateZ(360deg);

            }

        }

        @keyframes ringTwo {

            to {

                transform:
                    translate(-50%,-50%)
                    rotateY(425deg);

            }

        }

        @keyframes ringThree {

            to {

                transform:
                    translate(-50%,-50%)
                    rotateX(430deg)
                    rotateZ(380deg);

            }

        }


        /* =========================================================
           TOPIC ORBS
        ========================================================= */

        .topic-orb {

            position: absolute;

            width: 72px;
            height: 72px;

            display: flex;

            align-items: center;
            justify-content: center;

            border:
                1px solid
                rgba(0,245,196,.25);

            background:
                rgba(8,18,15,.8);

            backdrop-filter:
                blur(15px);

            border-radius: 20px;

            font-size: 27px;

            box-shadow:

                0 15px 40px
                rgba(0,0,0,.3),

                0 0 30px
                rgba(0,184,148,.12);

        }

        .topic-orb span {

            font-size: 14px;

            position: absolute;

            bottom: -20px;

            color:
                rgba(255,255,255,.4);

            letter-spacing: 1px;

        }

        .topic-one {

            top: 45px;
            left: 30px;

            animation:
                topicFloat 4s
                infinite
                ease-in-out;

        }

        .topic-two {

            top: 110px;
            right: 15px;

            animation:
                topicFloat 5s
                infinite
                ease-in-out
                .5s;

        }

        .topic-three {

            bottom: 70px;
            left: 20px;

            animation:
                topicFloat 4.5s
                infinite
                ease-in-out
                1s;

        }

        .topic-four {

            bottom: 35px;
            right: 50px;

            animation:
                topicFloat 5.5s
                infinite
                ease-in-out
                1.5s;

        }

        @keyframes topicFloat {

            0%,100% {

                transform:
                    translateY(0)
                    rotate(0deg);

            }

            50% {

                transform:
                    translateY(-18px)
                    rotate(6deg);

            }

        }


        /* =========================================================
           SCROLL TEXT
        ========================================================= */

        .scroll-text {

            position: absolute;

            bottom: 30px;
            left: 50%;

            transform:
                translateX(-50%);

            color:
                rgba(255,255,255,.25);

            font-size: 14px;

            letter-spacing: 4px;

        }


        /* =========================================================
           MARQUEE
        ========================================================= */

        .marquee {

            overflow: hidden;

            border-top:
                1px solid
                rgba(255,255,255,.08);

            border-bottom:
                1px solid
                rgba(255,255,255,.08);

            padding: 22px 0;

            background:
                rgba(255,255,255,.015);

        }

        .marquee-track {

            display: flex;

            width: max-content;

            animation:
                marquee 25s
                linear infinite;

        }

        .marquee-item {

            display: flex;

            align-items: center;

            gap: 25px;

            margin-right: 25px;

            font-size: 24px;

            font-weight: 800;

            color:
                rgba(255,255,255,.14);

            white-space: nowrap;

        }

        .marquee-item b {

            color:
                var(--green);

        }

        @keyframes marquee {

            to {
                transform:
                    translateX(-50%);
            }

        }


        /* =========================================================
           SECTION
        ========================================================= */

        .section {

            padding:
                120px 7%;

        }

        .section-head {

            display: flex;

            align-items: end;

            justify-content: space-between;

            margin-bottom: 50px;

        }

        .section-label {

            color:
                var(--green-light);

            font-size: 14px;

            letter-spacing: 3px;

            font-weight: 700;

        }

        .section-title {

            margin-top: 10px;

            font-size:
                clamp(35px,5vw,65px);

            line-height: .95;

            letter-spacing: -3px;

        }

        .section-description {

            max-width: 380px;

            color:
                var(--muted);

            font-size: 14px;

            line-height: 1.7;

        }


        /* =========================================================
           MODULES
        ========================================================= */

        .module-grid {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 18px;

        }

        .module {

            min-height: 390px;

            position: relative;

            padding: 25px;

            overflow: hidden;

            border:
                1px solid
                var(--border);

            border-radius: 25px;

            background:

                linear-gradient(
                    145deg,
                    rgba(255,255,255,.07),
                    rgba(255,255,255,.015)
                );

            transform-style:
                preserve-3d;

            transition:
                transform .4s,
                border .4s;

        }

        .module:hover {

            border-color:
                rgba(0,245,196,.35);

        }

        .module-number {

            color:
                rgba(255,255,255,.25);

            font-size: 14px;

            letter-spacing: 2px;

        }

        .module-icon {

            width: 70px;
            height: 70px;

            margin-top: 45px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 20px;

            background:
                rgba(0,184,148,.12);

            font-size: 30px;

            transform:
                translateZ(40px);

        }

        .module h3 {

            margin-top: 25px;

            font-size: 27px;

            transform:
                translateZ(30px);

        }

        .module p {

            margin-top: 10px;

            color:
                var(--muted);

            font-size: 14px;

            line-height: 1.6;

            transform:
                translateZ(20px);

        }

        .module-bottom {

            position: absolute;

            left: 25px;
            right: 25px;
            bottom: 25px;

        }

        .module-progress {

            height: 4px;

            background:
                rgba(255,255,255,.08);

            border-radius: 10px;

            overflow: hidden;

        }

        .module-progress span {

            display: block;

            height: 100%;

            background:

                linear-gradient(
                    90deg,
                    var(--green),
                    var(--green-light)
                );

        }

        .module-meta {

            display: flex;

            justify-content: space-between;

            margin-top: 10px;

            color:
                var(--muted);

            font-size: 14px;

        }

        .module-meta b {

            color:
                var(--green-light);

        }

        .module-bottom a {

            display: block;

            color:
                var(--green-light);

            transition: .3s;

        }

        .module-bottom a:hover {

            color: white;

        }


        /* =========================================================
           HORIZONTAL TOPICS
        ========================================================= */

        .horizontal-scroll {

            display: flex;

            gap: 18px;

            overflow-x: auto;

            padding:
                10px 2px 30px;

            scrollbar-width: none;

            cursor: grab;

        }

        .horizontal-scroll:active {
            cursor: grabbing;
        }

        .horizontal-scroll::-webkit-scrollbar {
            display: none;
        }

        .topic-card {

            min-width: 260px;

            height: 180px;

            position: relative;

            padding: 25px;

            border:
                1px solid
                var(--border);

            border-radius: 20px;

            overflow: hidden;

            background:

                linear-gradient(
                    135deg,
                    rgba(0,184,148,.13),
                    rgba(255,255,255,.025)
                );

            transition: .4s;

        }

        .topic-card:hover {

            transform:
                translateY(-10px)
                rotateX(4deg);

            border-color:
                rgba(0,245,196,.35);

        }

        .topic-card .big {

            position: absolute;

            right: -10px;
            bottom: -25px;

            font-size: 100px;

            opacity: .08;

        }

        .topic-card h3 {

            font-size: 20px;

        }

        .topic-card p {

            margin-top: 8px;

            color:
                var(--muted);

            font-size: 14px;

            max-width: 180px;

            line-height: 1.5;

        }

        .topic-card a {

            display: inline-block;

            margin-top: 18px;

            color:
                var(--green-light);

            font-size: 14px;

        }


        /* =========================================================
           STATS
        ========================================================= */

        .stats {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 15px;

        }

        .stat {

            padding: 25px;

            border:
                1px solid
                var(--border);

            border-radius: 18px;

            background:
                rgba(255,255,255,.035);

            transition: .3s;

        }

        .stat:hover {

            transform:
                translateY(-6px);

            border-color:
                rgba(0,245,196,.25);

        }

        .stat-value {

            font-size: 35px;

            font-weight: 800;

        }

        .stat-label {

            margin-top: 5px;

            color:
                var(--muted);

            font-size: 14px;

        }

        .stat-icon {

            margin-bottom: 20px;

            font-size: 22px;

        }


        /* =========================================================
           LOWER GRID
        ========================================================= */

        .lower {

            display: grid;

            grid-template-columns:
                1.4fr 1fr;

            gap: 20px;

        }

        .panel {

            padding: 30px;

            border:
                1px solid
                var(--border);

            border-radius: 22px;

            background:
                rgba(255,255,255,.035);

        }

        .panel-title {

            font-size: 20px;

        }

        .panel-label {

            color:
                var(--green-light);

            font-size: 14px;

            letter-spacing: 2px;

            display: block;

            margin-bottom: 7px;

        }


        /* =========================================================
           LEADERBOARD
        ========================================================= */

        .leader {

            display: flex;

            align-items: center;

            gap: 15px;

            padding: 15px 0;

            border-bottom:
                1px solid
                rgba(255,255,255,.07);

        }

        .leader:last-child {

            border-bottom: 0;

        }

        .rank {

            width: 25px;

            color:
                rgba(255,255,255,.3);

            font-size: 14px;

        }

        .avatar {

            width: 40px;
            height: 40px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:
                rgba(0,184,148,.15);

            color:
                var(--green-light);

            font-size: 14px;

            font-weight: 800;

        }

        .leader-info {

            flex: 1;

        }

        .leader-info strong {

            display: block;

            font-size: 11px;

        }

        .leader-info small {

            display: block;

            margin-top: 3px;

            color:
                var(--muted);

            font-size: 14px;

        }

        .leader-xp {

            color:
                var(--green-light);

            font-size: 14px;

        }


        /* =========================================================
           DAILY GOAL
        ========================================================= */

        .goal {

            display: flex;

            align-items: center;

            gap: 25px;

            margin-top: 30px;

        }

        .goal-circle {

            width: 120px;
            height: 120px;

            flex-shrink: 0;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 50%;

            background:

                conic-gradient(
                    var(--green-light) 75%,
                    rgba(255,255,255,.08) 0
                );

            position: relative;

        }

        .goal-circle::before {

            content: "";

            position: absolute;

            width: 92px;
            height: 92px;

            background:
                #080d0b;

            border-radius: 50%;

        }

        .goal-circle strong {

            position: relative;

            z-index: 2;

            font-size: 22px;

        }

        .goal-text strong {

            font-size: 14px;

        }

        .goal-text p {

            margin-top: 7px;

            color:
                var(--muted);

            font-size: 14px;

            line-height: 1.6;

        }


        /* =========================================================
           COMPANIES
        ========================================================= */

        .companies {

            display: grid;

            grid-template-columns:
                repeat(4,1fr);

            gap: 15px;

        }

        .company {

            min-height: 180px;

            padding: 22px;

            border:
                1px solid
                var(--border);

            border-radius: 18px;

            background:
                rgba(255,255,255,.025);

            transition: .35s;

        }

        .company:hover {

            transform:
                translateY(-8px);

            border-color:
                rgba(0,245,196,.35);

        }

        .company-logo {

            width: 50px;
            height: 50px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 13px;

            background:
                rgba(255,255,255,.07);

            font-size: 14px;

            font-weight: 900;

        }

        .company h3 {

            margin-top: 20px;

            font-size: 16px;

        }

        .company p {

            margin-top: 5px;

            color:
                var(--muted);

            font-size: 14px;

        }

        .company span {

            display: inline-block;

            margin-top: 15px;

            padding:
                6px 8px;

            border-radius: 5px;

            background:
                rgba(0,184,148,.10);

            color:
                var(--green-light);

            font-size: 14px;

        }


        /* =========================================================
           CTA
        ========================================================= */

        .cta {

            min-height: 560px;

            margin:
                50px 7% 100px;

            padding: 70px;

            position: relative;

            overflow: hidden;

            display: flex;

            align-items: center;

            border:
                1px solid
                rgba(0,245,196,.2);

            border-radius: 35px;

            background:

                radial-gradient(
                    circle at 75% 50%,
                    rgba(0,245,196,.18),
                    transparent 35%
                ),

                linear-gradient(
                    135deg,
                    rgba(0,184,148,.14),
                    rgba(255,255,255,.025)
                );

        }

        .cta-content {

            position: relative;

            z-index: 20;

            max-width: 650px;

        }

        .cta h2 {

            max-width: 650px;

            font-size:
                clamp(45px,7vw,90px);

            line-height: .9;

            letter-spacing: -5px;

        }

        .cta h2 span {

            color:
                var(--green-light);

            display: block;

        }

        .cta p {

            margin-top: 25px;

            color:
                var(--muted);

            max-width: 480px;

            font-size: 14px;

            line-height: 1.7;

        }

        .cta .primary-btn {

            margin-top: 25px;

        }


        /* =========================================================
           ROCKET SCENE
        ========================================================= */

        .rocket-scene {

            position: absolute;

            right: 3%;

            top: 50%;

            width: 430px;
            height: 430px;

            transform:
                translateY(-50%);

            display: flex;

            align-items: center;
            justify-content: center;

            perspective: 1200px;

            transform-style:
                preserve-3d;

            z-index: 5;

        }


        /* =========================================================
           ROCKET
        ========================================================= */

        .rocket {

            position: relative;

            width: 120px;
            height: 270px;

            transform-style:
                preserve-3d;

            transform:
                rotateZ(-18deg)
                rotateY(-15deg);

            animation:
                rocketFloat 4s
                ease-in-out infinite;

            z-index: 10;

        }


        /* =========================================================
           ROCKET BODY
        ========================================================= */

        .rocket-body {

            position: absolute;

            left: 50%;
            top: 70px;

            width: 82px;
            height: 150px;

            transform:
                translateX(-50%);

            border-radius:
                48% 48% 35% 35%;

            background:

                linear-gradient(
                    90deg,

                    #021f19 0%,
                    #075f50 18%,
                    #00b894 38%,
                    #00f5c4 50%,
                    #00b894 65%,
                    #006f5c 82%,
                    #021f19 100%
                );

            border:
                1px solid
                rgba(0,245,196,.8);

            box-shadow:

                0 0 30px
                rgba(0,245,196,.35),

                0 0 80px
                rgba(0,184,148,.15),

                inset
                10px 0 20px
                rgba(255,255,255,.12),

                inset
                -15px 0 25px
                rgba(0,0,0,.35);

        }


        /* =========================================================
           ROCKET NOSE
        ========================================================= */

        .rocket-nose {

            position: absolute;

            left: 50%;
            top: 18px;

            width: 82px;
            height: 82px;

            transform:
                translateX(-50%);

            background:

                linear-gradient(
                    135deg,
                    #00f5c4,
                    #00b894 45%,
                    #006f5c 75%,
                    #021f19
                );

            clip-path:
                polygon(
                    50% 0%,
                    100% 75%,
                    82% 100%,
                    18% 100%,
                    0% 75%
                );

            border:
                1px solid
                rgba(0,245,196,.7);

            filter:

                drop-shadow(
                    0 0 20px
                    rgba(0,245,196,.4)
                );

        }


        /* =========================================================
           ROCKET WINDOW
        ========================================================= */

        .rocket-window {

            position: absolute;

            left: 50%;
            top: 90px;

            width: 42px;
            height: 42px;

            transform:
                translateX(-50%);

            border-radius: 50%;

            background:

                radial-gradient(
                    circle at 30% 25%,
                    #ffffff 0%,
                    #b8fff0 10%,
                    #00f5c4 28%,
                    #008f78 55%,
                    #021f1a 100%
                );

            border:
                3px solid
                rgba(255,255,255,.3);

            box-shadow:

                0 0 15px
                rgba(255,255,255,.4),

                0 0 35px
                rgba(0,245,196,.7),

                inset
                0 0 12px
                rgba(0,0,0,.6);

            z-index: 20;

            animation:
                windowPulse 2s
                ease-in-out infinite;

        }

        @keyframes windowPulse {

            0%,
            100% {

                box-shadow:
                    0 0 15px
                    rgba(255,255,255,.4),

                    0 0 35px
                    rgba(0,245,196,.6);

            }

            50% {

                box-shadow:
                    0 0 20px
                    rgba(255,255,255,.7),

                    0 0 50px
                    rgba(0,245,196,.9);

            }

        }


        /* =========================================================
           ROCKET FINS
        ========================================================= */

        .rocket-fin {

            position: absolute;

            bottom: 35px;

            width: 48px;
            height: 85px;

            background:

                linear-gradient(
                    135deg,
                    #00b894,
                    #006f5c 50%,
                    #021f19
                );

            border:
                1px solid
                rgba(0,245,196,.5);

            z-index: 1;

        }

        .rocket-fin.left {

            left: -27px;

            clip-path:
                polygon(
                    100% 0,
                    100% 100%,
                    0 100%,
                    20% 55%
                );

        }

        .rocket-fin.right {

            right: -27px;

            clip-path:
                polygon(
                    0 0,
                    100% 55%,
                    100% 100%,
                    0 100%
                );

        }


        /* =========================================================
           ENGINE
        ========================================================= */

        .rocket-engine {

            position: absolute;

            left: 50%;
            bottom: 15px;

            width: 52px;
            height: 35px;

            transform:
                translateX(-50%);

            border-radius:
                0 0 50% 50%;

            background:

                radial-gradient(
                    circle,
                    #00f5c4 0%,
                    #007c65 45%,
                    #001f18 100%
                );

            border:
                1px solid
                rgba(0,245,196,.6);

            box-shadow:
                0 0 20px
                rgba(0,245,196,.5);

            z-index: 10;

        }

        .engine-core {

            position: absolute;

            left: 50%;
            top: 50%;

            width: 25px;
            height: 20px;

            transform:
                translate(-50%,-40%);

            border-radius: 50%;

            background: #ffffff;

            box-shadow:

                0 0 15px
                #00f5c4,

                0 0 30px
                #00f5c4;

        }


        /* =========================================================
           ROCKET FLAMES
        ========================================================= */

        .rocket-flame {

            position: absolute;

            left: 50%;

            bottom: -78px;

            transform:
                translateX(-50%);

            border-radius:
                50% 50% 65% 65%;

            background:

                linear-gradient(
                    180deg,
                    #ffffff 0%,
                    #00f5c4 20%,
                    #00b894 55%,
                    rgba(0,184,148,.1) 100%
                );

            filter:
                drop-shadow(
                    0 0 15px
                    rgba(0,245,196,.9)
                );

            transform-origin:
                top center;

            animation:
                flamePulse .3s
                ease-in-out infinite alternate;

        }

        .flame-one {

            width: 38px;
            height: 85px;

        }

        .flame-two {

            width: 24px;
            height: 70px;

            opacity: .7;

            animation-delay: .08s;

        }

        .flame-three {

            width: 14px;
            height: 55px;

            opacity: .5;

            animation-delay: .15s;

        }

        @keyframes flamePulse {

            0% {

                transform:
                    translateX(-50%)
                    scaleY(.75)
                    scaleX(.9);

                opacity: .7;

            }

            100% {

                transform:
                    translateX(-50%)
                    scaleY(1.15)
                    scaleX(1.1);

                opacity: 1;

            }

        }


        /* =========================================================
           ROCKET FLOAT
        ========================================================= */

        @keyframes rocketFloat {

            0%,
            100% {

                transform:
                    translateY(0)
                    rotateZ(-18deg)
                    rotateY(-15deg);

            }

            50% {

                transform:
                    translateY(-25px)
                    rotateZ(-13deg)
                    rotateY(12deg);

            }

        }


        /* =========================================================
           ROCKET ORBITS
        ========================================================= */

        .rocket-orbit {

            position: absolute;

            left: 50%;
            top: 50%;

            border:
                1px solid
                rgba(0,245,196,.25);

            border-radius: 50%;

            transform-style:
                preserve-3d;

            pointer-events: none;

        }

        .orbit-one {

            width: 370px;
            height: 115px;

            transform:
                translate(-50%,-50%)
                rotateX(65deg)
                rotateZ(-20deg);

            animation:
                orbitOne 8s
                linear infinite;

        }

        .orbit-two {

            width: 300px;
            height: 95px;

            transform:
                translate(-50%,-50%)
                rotateY(65deg)
                rotateZ(20deg);

            animation:
                orbitTwo 10s
                linear infinite;

        }

        .orbit-three {

            width: 250px;
            height: 250px;

            transform:
                translate(-50%,-50%)
                rotateX(70deg)
                rotateZ(20deg);

            animation:
                orbitThree 12s
                linear infinite;

        }

        @keyframes orbitOne {

            from {

                transform:
                    translate(-50%,-50%)
                    rotateX(65deg)
                    rotateZ(0deg);

            }

            to {

                transform:
                    translate(-50%,-50%)
                    rotateX(65deg)
                    rotateZ(360deg);

            }

        }

        @keyframes orbitTwo {

            from {

                transform:
                    translate(-50%,-50%)
                    rotateY(65deg)
                    rotateZ(0deg);

            }

            to {

                transform:
                    translate(-50%,-50%)
                    rotateY(65deg)
                    rotateZ(-360deg);

            }

        }

        @keyframes orbitThree {

            from {

                transform:
                    translate(-50%,-50%)
                    rotateX(70deg)
                    rotateZ(0deg);

            }

            to {

                transform:
                    translate(-50%,-50%)
                    rotateX(70deg)
                    rotateZ(360deg);

            }

        }


        /* =========================================================
           EXHAUST PARTICLES
        ========================================================= */

        .exhaust-particle {

            position: absolute;

            left: 50%;

            width: 5px;
            height: 5px;

            border-radius: 50%;

            background:
                var(--green-light);

            box-shadow:
                0 0 12px
                rgba(0,245,196,.9);

            opacity: 0;

            animation:
                exhaustParticle
                1.2s
                infinite
                ease-out;

        }

        .p1 {

            bottom: -85px;
            margin-left: -35px;

            animation-delay: .1s;

        }

        .p2 {

            bottom: -95px;
            margin-left: 30px;

            animation-delay: .3s;

        }

        .p3 {

            bottom: -110px;
            margin-left: -15px;

            animation-delay: .5s;

        }

        .p4 {

            bottom: -90px;
            margin-left: 18px;

            animation-delay: .7s;

        }

        .p5 {

            bottom: -125px;
            margin-left: -5px;

            animation-delay: .9s;

        }

        @keyframes exhaustParticle {

            0% {

                transform:
                    translateY(0)
                    scale(.4);

                opacity: 0;

            }

            20% {
                opacity: 1;
            }

            100% {

                transform:
                    translateY(100px)
                    scale(0);

                opacity: 0;

            }

        }


        /* =========================================================
           ROCKET STARS
        ========================================================= */

        .rocket-star {

            position: absolute;

            color:
                var(--green-light);

            font-size: 14px;

            text-shadow:
                0 0 15px
                var(--green-light);

            animation:
                starFloat 3s
                ease-in-out infinite;

        }

        .star-one {

            top: 45px;
            left: 45px;

        }

        .star-two {

            top: 80px;
            right: 30px;

            animation-delay: .7s;

        }

        .star-three {

            bottom: 60px;
            left: 35px;

            animation-delay: 1.2s;

        }

        .star-four {

            bottom: 35px;
            right: 60px;

            animation-delay: 1.8s;

        }

        @keyframes starFloat {

            0%,
            100% {

                transform:
                    translateY(0)
                    scale(1);

                opacity: .4;

            }

            50% {

                transform:
                    translateY(-15px)
                    scale(1.4);

                opacity: 1;

            }

        }

        .cta::after {

            content: "";

            position: absolute;

            width: 450px;
            height: 450px;

            right: -80px;
            top: 50%;

            transform:
                translateY(-50%);

            border-radius: 50%;

            background:

                radial-gradient(
                    circle,
                    rgba(0,245,196,.18),
                    transparent 70%
                );

            pointer-events: none;

        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {

            padding:
                30px 7%;

            border-top:
                1px solid
                rgba(255,255,255,.08);

            display: flex;

            justify-content:
                space-between;

            color:
                rgba(255,255,255,.35);

            font-size: 14px;

        }

        footer strong {

            color: white;

        }


        /* =========================================================
           REVEAL
        ========================================================= */

        .reveal {

            opacity: 0;

            transform:
                translateY(50px);

            transition:
                opacity .8s ease,
                transform .8s ease;

        }

        .reveal.show {

            opacity: 1;

            transform:
                translateY(0);

        }


        /* =========================================================
           RESPONSIVE
        ========================================================= */

        @media(max-width:1100px) {

            .hero-content {
                width: 65%;
            }

            .hero-visual {

                opacity: .45;

                right: -10%;

            }

            .module-grid,
            .companies {

                grid-template-columns:
                    repeat(2,1fr);

            }

            .stats {

                grid-template-columns:
                    repeat(2,1fr);

            }

            .rocket-scene {

                right: -30px;

                opacity: .65;

                transform:
                    translateY(-50%)
                    scale(.85);

            }

        }


        @media(max-width:750px) {

            .cursor,
            .cursor-ring {

                display: none;

            }

            .navbar {

                width:
                    calc(100% - 25px);

            }

            .nav-links {

                display: none;

            }

            .hero {


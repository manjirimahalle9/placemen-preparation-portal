<script>

/* =========================================================
   CODING HINT
========================================================= */

function showCodingHint() {

    const hint =
        document.getElementById("codingHint");

    if (hint.style.display === "block") {

        hint.style.display = "none";

    } else {

        hint.style.display = "block";

    }

}


/* =========================================================
   APTITUDE OPTION
========================================================= */

let selectedAnswer = null;

let correctAnswer = true;


function selectOption(button, isCorrect) {

    const options =
        document.querySelectorAll(
            ".options button"
        );

    options.forEach(btn => {

        btn.classList.remove("selected");

    });

    button.classList.add("selected");

    selectedAnswer = button;

    button.dataset.correct =
        isCorrect;

}


/* =========================================================
   SUBMIT
========================================================= */

function submitAptitude() {

    const result =
        document.getElementById(
            "answerResult"
        );


    if (!selectedAnswer) {

        result.innerHTML =
            "⚠️ Please select an answer first.";

        result.style.color =
            "#ffbe46";

        return;

    }


    const isCorrect =
        selectedAnswer.dataset.correct === "true";


    if (isCorrect) {

        selectedAnswer.classList.remove(
            "selected"
        );

        selectedAnswer.classList.add(
            "correct"
        );

        result.innerHTML =
            "🎉 Correct! You earned +10 points.";

        result.style.color =
            "#00c49c";

    } else {

        selectedAnswer.classList.remove(
            "selected"
        );

        selectedAnswer.classList.add(
            "wrong"
        );

        result.innerHTML =
            "❌ Incorrect. Try the next question.";

        result.style.color =
            "#dc5050";

    }

}


/* =========================================================
   APTITUDE HINT
========================================================= */

function showAptitudeHint() {

    const hint =
        document.getElementById(
            "aptitudeHint"
        );

    hint.style.display =
        hint.style.display === "block"
            ? "none"
            : "block";

}


/* =========================================================
   NEXT QUESTION
========================================================= */

function nextQuestion() {

    alert(
        "Next aptitude question will be loaded here."
    );

}


/* =========================================================
   TIMER
========================================================= */

let time = 120;

const timer =
    document.getElementById("timer");


const countdown =
    setInterval(function () {

        let minutes =
            Math.floor(time / 60);

        let seconds =
            time % 60;


        seconds =
            seconds < 10
                ? "0" + seconds
                : seconds;


        timer.innerText =
            "0" + minutes + ":" + seconds;


        time--;


        if (time < 0) {

            clearInterval(countdown);

            timer.innerText =
                "Time Up";

        }

    }, 1000);

</script>





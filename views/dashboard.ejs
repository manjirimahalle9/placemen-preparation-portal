<script>
    


/* =========================================================
   PAGE LOADER
========================================================= */

window.addEventListener(
    "load",
    function () {

        setTimeout(
            function () {

                const loader =
                    document.getElementById("loader");

                if (loader) {

                    loader.classList.add("hide");

                }

            },
            900
        );

    }
);


/* =========================================================
   CUSTOM CURSOR
========================================================= */



/* =========================================================
   3D CARD TILT
========================================================= */

const tiltCards =
    document.querySelectorAll(".tilt");


tiltCards.forEach(
    function (card) {

        card.addEventListener(
            "mousemove",
            function (e) {

                const rect =
                    card.getBoundingClientRect();

                const x =
                    e.clientX - rect.left;

                const y =
                    e.clientY - rect.top;

                const centerX =
                    rect.width / 2;

                const centerY =
                    rect.height / 2;

                const rotateX =
                    ((y - centerY) /
                        centerY) * -5;

                const rotateY =
                    ((x - centerX) /
                        centerX) * 5;

                card.style.transform =

                    `perspective(900px)
                     rotateX(${rotateX}deg)
                     rotateY(${rotateY}deg)
                     translateY(-5px)`;

            }
        );


        card.addEventListener(
            "mouseleave",
            function () {

                card.style.transform =
                    "";

            }
        );

    }
);


/* =========================================================
   HERO PARALLAX
========================================================= */

const scene =
    document.querySelector(".scene");


document.addEventListener(
    "mousemove",
    function (e) {

        if (!scene)
            return;

        if (window.innerWidth < 750)
            return;

        const x =
            (e.clientX /
                window.innerWidth - .5) * 20;

        const y =
            (e.clientY /
                window.innerHeight - .5) * 20;

        scene.style.transform =
            `translate(${x}px,${y}px)`;

    }
);


/* =========================================================
   SCROLL REVEAL
========================================================= */

const revealElements =
    document.querySelectorAll(".reveal");


const observer =
    new IntersectionObserver(

        function (entries) {

            entries.forEach(
                function (entry) {

                    if (
                        entry.isIntersecting
                    ) {

                        entry.target
                            .classList
                            .add("show");

                    }

                }
            );

        },

        {
            threshold: .15
        }

    );


revealElements.forEach(
    function (element) {

        observer.observe(element);

    }
);


/* =========================================================
   COUNTERS
========================================================= */

const counters =
    document.querySelectorAll(
        ".stat-value"
    );


let countersStarted = false;


function startCounters() {

    if (countersStarted)
        return;

    countersStarted = true;


    counters.forEach(
        function (counter) {

            const target =
                Number(
                    counter.dataset.target
                );

            let current = 0;


            const increment =
                Math.max(
                    1,
                    Math.ceil(target / 80)
                );


            const timer =
                setInterval(
                    function () {

                        current += increment;


                        if (
                            current >= target
                        ) {

                            current =
                                target;

                            clearInterval(timer);

                        }


                        counter.textContent =
                            current.toLocaleString();

                    },
                    20
                );

        }
    );

}


const statsSection =
    document.querySelector(".stats");


if (statsSection) {

    const statsObserver =
        new IntersectionObserver(

            function (entries) {

                if (
                    entries[0].isIntersecting
                ) {

                    startCounters();

                }

            },

            {
                threshold: .4
            }

        );


    statsObserver.observe(
        statsSection
    );

}


/* =========================================================
   ACTIVE NAVIGATION
========================================================= */

const navLinks =
    document.querySelectorAll(
        ".nav-links a"
    );


navLinks.forEach(
    function (link) {

        link.addEventListener(
            "click",
            function () {

                navLinks.forEach(
                    function (item) {

                        item.style.color =
                            "rgba(255,255,255,.55)";

                    }
                );


                this.style.color =
                    "var(--green-light)";

            }
        );

    }
);


/* =========================================================
   RANDOM PARTICLES
========================================================= */

for (
    let i = 0;
    i < 25;
    i++
) {

    const particle =
        document.createElement("div");


    particle.style.position =
        "fixed";


    particle.style.width =
        Math.random() * 3 + 1 + "px";


    particle.style.height =
        particle.style.width;


    particle.style.borderRadius =
        "50%";


    particle.style.background =
        "rgba(0,245,196,.5)";


    particle.style.left =
        Math.random() * 100 + "%";


    particle.style.top =
        Math.random() * 100 + "%";


    particle.style.pointerEvents =
        "none";


    particle.style.zIndex =
        "-1";


    particle.style.boxShadow =
        "0 0 10px rgba(0,245,196,.4)";


    document.body.appendChild(
        particle
    );

}


/* =========================================================
   HORIZONTAL DRAG
========================================================= */

const horizontal =
    document.querySelector(
        ".horizontal-scroll"
    );


let isDown = false;

let startX;

let scrollLeft;


if (horizontal) {


    horizontal.addEventListener(
        "mousedown",
        function (e) {

            isDown = true;

            startX =
                e.pageX -
                horizontal.offsetLeft;

            scrollLeft =
                horizontal.scrollLeft;

        }
    );


    horizontal.addEventListener(
        "mouseleave",
        function () {

            isDown = false;

        }
    );


    horizontal.addEventListener(
        "mouseup",
        function () {

            isDown = false;

        }
    );


    horizontal.addEventListener(
        "mousemove",
        function (e) {

            if (!isDown)
                return;

            e.preventDefault();


            const x =
                e.pageX -
                horizontal.offsetLeft;


            const walk =
                (x - startX) * 1.5;


            horizontal.scrollLeft =
                scrollLeft - walk;

        }
    );

}


/* =========================================================
   ROCKET MOUSE PARALLAX
========================================================= */

const rocketScene =
    document.querySelector(
        ".rocket-scene"
    );


document.addEventListener(
    "mousemove",
    function (e) {

        if (
            !rocketScene ||
            window.innerWidth < 750
        )
            return;


        const rect =
            rocketScene.getBoundingClientRect();


        const mouseX =
            e.clientX -
            (rect.left + rect.width / 2);


        const mouseY =
            e.clientY -
            (rect.top + rect.height / 2);


        const rotateY =
            mouseX / 35;


        const rotateX =
            mouseY / -35;


        rocketScene.style.transform =
            `translateY(-50%)
             rotateX(${rotateX}deg)
             rotateY(${rotateY}deg)`;

    }
);


/* =========================================================
   RESET ROCKET POSITION
========================================================= */

document.addEventListener(
    "mouseleave",
    function () {

        if (
            !rocketScene ||
            window.innerWidth < 750
        )
            return;


        rocketScene.style.transform =
            "translateY(-50%)";

    }
);


/* =========================================================
   REDUCE MOTION SUPPORT
========================================================= */

const reduceMotion =
    window.matchMedia(
        "(prefers-reduced-motion: reduce)"
    );


if (reduceMotion.matches) {

    document.documentElement.style
        .scrollBehavior = "auto";

}


        /* =========================================================
           HERO
        ========================================================= */

        .hero {

            min-height: 100vh;

            padding:
                150px 7% 80px;

            display: flex;

            align-items: center;

            position: relative;

            overflow: hidden;

        }

        .hero-content {

            width: 55%;

            position: relative;

            z-index: 10;

        }

        .eyebrow {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding:
                8px 13px;

            border:
                1px solid
                rgba(0,245,196,.25);

            border-radius: 50px;

            background:
                rgba(0,184,148,.08);

            color:
                var(--green-light);

            font-size: 9px;

            letter-spacing: 2px;

            font-weight: 700;

        }

        .eyebrow::before {

            content: "";

            width: 6px;
            height: 6px;

            border-radius: 50%;

            background:
                var(--green-light);

            box-shadow:
                0 0 12px
                var(--green-light);

        }

        .hero h1 {

            margin-top: 25px;

            font-size:
                clamp(60px, 8vw, 125px);

            line-height: .82;

            letter-spacing: -6px;

            font-weight: 900;

        }

        .hero h1 span {

            color: transparent;

            -webkit-text-stroke:
                1px
                rgba(255,255,255,.7);

        }

        .hero-description {

            max-width: 510px;

            margin-top: 30px;

            color:
                var(--muted);

            font-size: 14px;

            line-height: 1.7;

        }

        .hero-actions {

            display: flex;

            gap: 12px;

            margin-top: 30px;

        }

        .primary-btn {


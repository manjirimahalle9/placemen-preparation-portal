<script>

document.addEventListener(
    "DOMContentLoaded",
    function () {


        /* =================================================
           QUESTIONS
        ================================================= */

        const questions = [

            {

                topic: "Percentage",

                question:
                "A number is increased by 20%. By what percentage should the increased number be decreased to get the original number?",

                options: [
                    "15%",
                    "16.67%",
                    "18%",
                    "20%"
                ],

                answer: 1,

                hint:
                "Take the original number as 100. After increasing it by 20%, what does it become?",

                solution:
                "Take the original number as 100. A 20% increase makes it 120. We need to reduce 20 to return to 100. Now calculate 20 ÷ 120 × 100 = 16.67%. Therefore, the answer is 16.67%."

            },


            {

                topic: "Profit & Loss",

                question:
                "A shopkeeper buys a bag for ₹500 and sells it for ₹600. What is the profit percentage?",

                options: [
                    "10%",
                    "15%",
                    "20%",
                    "25%"
                ],

                answer: 2,

                hint:
                "First find the profit by subtracting the Cost Price from the Selling Price.",

                solution:
                "Cost Price = ₹500. Selling Price = ₹600. Profit = ₹600 − ₹500 = ₹100. Profit percentage = 100 ÷ 500 × 100 = 20%. Therefore, the answer is 20%."

            },


            {

                topic: "Ratio",

                question:
                "The ratio of boys to girls in a class is 3 : 2. If there are 30 boys, how many girls are there?",

                options: [
                    "15",
                    "20",
                    "25",
                    "30"
                ],

                answer: 1,

                hint:
                "3 parts represent 30 boys. Find the value of one part.",

                solution:
                "3 parts = 30 boys. So 1 part = 30 ÷ 3 = 10. Girls represent 2 parts. Therefore, 2 × 10 = 20 girls. The answer is 20."

            },


            {

                topic: "Average",

                question:
                "What is the average of 10, 20, 30, 40 and 50?",

                options: [
                    "20",
                    "25",
                    "30",
                    "35"
                ],

                answer: 2,

                hint:
                "Add all the numbers and divide by how many numbers are present.",

                solution:
                "Add the numbers: 10 + 20 + 30 + 40 + 50 = 150. There are 5 numbers. Average = 150 ÷ 5 = 30. Therefore, the answer is 30."

            },


            {

                topic: "Time & Work",

                question:
                "A person can complete a work in 10 days. What part of the work can the person complete in one day?",

                options: [
                    "1/5",
                    "1/10",
                    "1/15",
                    "1/20"
                ],

                answer: 1,

                hint:
                "If complete work takes 10 days, divide 1 by 10.",

                solution:
                "The complete work is considered as 1. It takes 10 days to finish. Therefore, work completed in one day = 1 ÷ 10 = 1/10. The answer is 1/10."

            }

        ];


        /* =================================================
           VARIABLES
        ================================================= */

        let currentQuestion = 0;

        let selectedAnswer = null;

        let hasSubmitted = false;

        let score = 0;

        let correct = 0;

        let wrong = 0;

        let timeLeft = 60;

        let timerInterval = null;


        /* =================================================
           ELEMENTS
        ================================================= */

        const questionNumber =
            document.getElementById(
                "quizQuestionNumber"
            );

        const questionTopic =
            document.getElementById(
                "quizTopic"
            );

        const questionText =
            document.getElementById(
                "quizQuestion"
            );

        const optionsContainer =
            document.getElementById(
                "quizOptions"
            );

        const message =
            document.getElementById(
                "quizMessage"
            );

        const hint =
            document.getElementById(
                "quizHint"
            );

        const solution =
            document.getElementById(
                "quizSolution"
            );

        const submitButton =
            document.getElementById(
                "submitButton"
            );

        const nextButton =
            document.getElementById(
                "nextButton"
            );

        const hintButton =
            document.getElementById(
                "hintButton"
            );

        const timer =
            document.getElementById(
                "quizTimer"
            );

        const progress =
            document.getElementById(
                "quizProgress"
            );


        /* =================================================
           LOAD QUESTION
        ================================================= */

        function loadQuestion() {

            clearInterval(timerInterval);


            const q =
                questions[currentQuestion];


            /* NUMBER */

            questionNumber.innerText =
                "Question " +
                (currentQuestion + 1) +
                " / " +
                questions.length;


            /* TOPIC */

            questionTopic.innerText =
                q.topic;


            /* QUESTION */

            questionText.innerText =
                q.question;


            /* OPTIONS */

            optionsContainer.innerHTML =
                "";


            q.options.forEach(
                function (option, index) {

                    const button =
                        document.createElement(
                            "button"
                        );


                    button.type =
                        "button";


                    button.className =
                        "quiz-option";


                    button.innerHTML =

                        '<span class="option-letter">' +

                        String.fromCharCode(
                            65 + index
                        ) +

                        '</span>' +

                        option;


                    button.addEventListener(
                        "click",
                        function () {

                            selectAnswer(
                                index,
                                button
                            );

                        }
                    );


                    optionsContainer.appendChild(
                        button
                    );

                }
            );


            /* RESET */

            selectedAnswer = null;

            hasSubmitted = false;

            message.innerText = "";

            message.style.color = "";


            hint.style.display =
                "none";

            hint.innerHTML =
                "";


            solution.style.display =
                "none";

            solution.innerHTML =
                "";


            submitButton.disabled =
                false;


            nextButton.disabled =
                true;


            if (
                currentQuestion ===
                questions.length - 1
            ) {

                nextButton.innerText =
                    "🏆 Finish Quiz";

            }

            else {

                nextButton.innerText =
                    "Next Question →";

            }


            /* PROGRESS */

            const percent =
                (
                    (currentQuestion + 1) /
                    questions.length
                ) * 100;


            progress.style.width =
                percent + "%";


            /* TIMER */

            startTimer();

        }


        /* =================================================
           SELECT ANSWER
        ================================================= */

        function selectAnswer(
            index,
            button
        ) {

            if (hasSubmitted) {
                return;
            }


            selectedAnswer =
                index;


            const allOptions =
                document.querySelectorAll(
                    ".quiz-option"
                );


            allOptions.forEach(
                function (option) {

                    option.classList.remove(
                        "selected"
                    );

                }
            );


            button.classList.add(
                "selected"
            );


            message.innerText =
                "Answer selected. Click Submit Answer.";

            message.style.color =
                "#82958f";

        }


        /* =================================================
           SUBMIT ANSWER
        ================================================= */

        function submitAnswer() {

            if (hasSubmitted) {
                return;
            }


            if (selectedAnswer === null) {

                message.innerText =
                    "⚠️ Please select an option first.";

                message.style.color =
                    "#ffbe46";

                return;

            }


            hasSubmitted = true;


            clearInterval(timerInterval);


            const q =
                questions[currentQuestion];


            const allOptions =
                document.querySelectorAll(
                    ".quiz-option"
                );


            /* CORRECT */

            if (
                selectedAnswer ===
                q.answer
            ) {

                allOptions[
                    selectedAnswer
                ].classList.add(
                    "correct"
                );


                message.innerText =
                    "🎉 Correct! You earned 10 points.";

                message.style.color =
                    "#00c49c";


                score += 10;

                correct++;

            }


            /* WRONG */

            else {

                allOptions[
                    selectedAnswer
                ].classList.add(
                    "wrong"
                );


                allOptions[
                    q.answer
                ].classList.add(
                    "correct"
                );


                message.innerText =
                    "❌ Incorrect. The correct answer is " +
                    String.fromCharCode(
                        65 + q.answer
                    ) +
                    ".";

                message.style.color =
                    "#e05252";


                wrong++;

            }


            /* DISABLE */

            allOptions.forEach(
                function (option) {

                    option.disabled =
                        true;

                }
            );


            /* UPDATE SCORE */

            document.getElementById(
                "quizScore"
            ).innerText =
                score;


            /* SHOW SOLUTION */

            solution.innerHTML =

                '<div class="quiz-solution-title">' +
                '📖 Easy Solution' +
                '</div>' +

                '<div class="quiz-solution-answer">' +

                'Correct Answer: ' +

                String.fromCharCode(
                    65 + q.answer
                ) +

                ". " +

                q.options[
                    q.answer
                ] +

                '</div>' +

                '<div>' +

                q.solution +

                '</div>';


            solution.style.display =
                "block";


            /* ENABLE NEXT */

            nextButton.disabled =
                false;

        }


        /* =================================================
           NEXT QUESTION
        ================================================= */

        function nextQuestion() {

            if (!hasSubmitted) {

                message.innerText =
                    "Please submit your answer first.";

                message.style.color =
                    "#ffbe46";

                return;

            }


            if (
                currentQuestion <
                questions.length - 1
            ) {

                currentQuestion++;

                loadQuestion();

            }

            else {

                showFinalResult();

            }

        }


        /* =================================================
           HINT
        ================================================= */

        function showHint() {

            const q =
                questions[currentQuestion];


            if (
                hint.style.display ===
                "block"
            ) {

                hint.style.display =
                    "none";

                return;

            }


            hint.innerHTML =
                "<strong>💡 Hint:</strong><br>" +
                q.hint;


            hint.style.display =
                "block";

        }


        /* =================================================
           TIMER
        ================================================= */

        function startTimer() {

            timeLeft = 60;

            timer.innerText =
                timeLeft;


            timerInterval =
                setInterval(
                    function () {

                        timeLeft--;

                        timer.innerText =
                            timeLeft;


                        if (
                            timeLeft <= 0
                        ) {

                            clearInterval(
                                timerInterval
                            );


                            if (
                                !hasSubmitted
                            ) {

                                message.innerText =
                                    "⏰ Time is over. Please submit your answer.";

                                message.style.color =
                                    "#ffbe46";

                            }

                        }

                    },
                    1000
                );

        }


        /* =================================================
           FINAL RESULT
        ================================================= */

        function showFinalResult() {

            clearInterval(
                timerInterval
            );


            document.getElementById(
                "aptitudeQuizArea"
            ).style.display =
                "none";


            document.getElementById(
                "aptitudeFinalResult"
            ).style.display =
                "block";


            document.getElementById(
                "finalScore"
            ).innerText =
                correct;


            document.getElementById(
                "finalCorrect"
            ).innerText =
                correct;


            document.getElementById(
                "finalWrong"
            ).innerText =
                wrong;


            const accuracy =
                Math.round(
                    (
                        correct /
                        questions.length
                    ) * 100
                );


            document.getElementById(
                "finalAccuracy"
            ).innerText =
                accuracy + "%";

        }


        /* =================================================
           RESTART
        ================================================= */

        function restartQuiz() {

            clearInterval(
                timerInterval
            );


            currentQuestion = 0;

            selectedAnswer = null;

            hasSubmitted = false;

            score = 0;

            correct = 0;

            wrong = 0;


            document.getElementById(
                "quizScore"
            ).innerText =
                "0";


            document.getElementById(
                "aptitudeQuizArea"
            ).style.display =
                "block";


            document.getElementById(
                "aptitudeFinalResult"
            ).style.display =
                "none";


            loadQuestion();

        }


        /* =================================================
           BUTTON EVENTS
        ================================================= */

        submitButton.addEventListener(
            "click",
            submitAnswer
        );


        nextButton.addEventListener(
            "click",
            nextQuestion
        );


        hintButton.addEventListener(
            "click",
            showHint
        );


        document.getElementById(
            "restartQuizButton"
        ).addEventListener(
            "click",
            restartQuiz
        );


        /* =================================================
           START
        ================================================= */

        loadQuestion();

    }

);

</script>



        



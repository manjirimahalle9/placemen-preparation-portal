            bottom: -180px;
            left: -100px;

        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .navbar {

            position: fixed;

            top: 18px;
            left: 50%;

            transform:
                translateX(-50%);

            width:
                calc(100% - 50px);

            max-width: 1250px;


}


.question-list li {

    padding: 10px 0;

    border-bottom:
        1px solid rgba(0,196,156,.07);

    font-size: 13px;
}


.question-list li:last-child {

    border-bottom: none;
}


/* =========================================================
   STAR METHOD
========================================================= */

.star-card {

    padding: 27px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(0,140,112,.18),
            rgba(10,22,19,.85)
        );

    border:
        1px solid rgba(0,196,156,.20);
}


.star-step {

    display: flex;

    gap: 15px;

    margin-bottom: 18px;
}


.star-letter {

    min-width: 42px;

    height: 42px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 12px;

    background:
        rgba(0,196,156,.11);

    border:
        1px solid rgba(0,196,156,.18);

    color: #64ffdd;

    font-weight: 800;
}


.star-step h6 {

    font-weight: 800;

    margin-bottom: 4px;
}


.star-step p {

    color: #809a93;

    font-size: 12px;

    margin: 0;

    line-height: 1.6;
}


/* =========================================================
   CHECKLIST
========================================================= */

.check-card {

    height: 100%;

    padding: 25px;

    border-radius: 19px;

    background:
        rgba(10,22,19,.76);

    border:
        1px solid rgba(0,196,156,.13);
}


.check-card h5 {

    font-weight: 800;

    margin-bottom: 18px;
}


.check-item {

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 10px 0;

    border-bottom:
        1px solid rgba(0,196,156,.07);

    color: #8ea9a1;

    font-size: 12px;
}


.check-item i {

    color: #00c49c;

    font-size: 16px;
}


/* =========================================================
   READINESS
========================================================= */

.readiness-card {

    padding: 28px;

    border-radius: 22px;

    background:
        linear-gradient(
            135deg,
            rgba(0,140,112,.20),
            rgba(10,22,19,.85)
        );

    border:
        1px solid rgba(0,196,156,.18);
}


.readiness-title {

    display: flex;

    justify-content: space-between;

    margin-bottom: 10px;

    font-size: 12px;

    color: #8ba69e;
}


.progress {

    height: 7px;

    background:
        rgba(255,255,255,.05);

    border-radius: 10px;

    overflow: hidden;
}


.progress-bar {

    background:
        linear-gradient(
            90deg,
            #008c70,
            #00d5a9
        );

    border-radius: 10px;
}


/* =========================================================
   TIPS
========================================================= */

.tip-card {

    padding: 24px;

    border-radius: 18px;

    height: 100%;

    background:
        rgba(10,22,19,.75);

    border:
        1px solid rgba(0,196,156,.12);
}


.tip-card h6 {

    font-weight: 800;

    margin-bottom: 10px;
}


.tip-card p {

    color: #819b94;

    font-size: 12px;

    line-height: 1.7;

    margin: 0;
}


/* =========================================================
   DO DON'T
========================================================= */

.do-card,
.dont-card {

    height: 100%;

    padding: 25px;

    border-radius: 19px;

    background:
        rgba(10,22,19,.78);
}


.do-card {

    border:
        1px solid rgba(0,196,156,.20);
}


.dont-card {

    border:
        1px solid rgba(255,90,100,.17);
}


.do-card h5 {

    color: #5fffdc;

    font-weight: 800;
}


.dont-card h5 {

    color: #ff8790;

    font-weight: 800;
}


.do-card li,
.dont-card li {

    color: #8ea8a1;

    font-size: 12px;

    margin-bottom: 11px;
}


/* =========================================================
   MOCK INTERVIEW
========================================================= */

.mock-card {

    position: relative;

    overflow: hidden;

    padding: 35px;

    border-radius: 23px;

    text-align: center;

    background:
        linear-gradient(
            135deg,
            rgba(0,140,112,.24),
            rgba(0,196,156,.06)
        );

    border:
        1px solid rgba(0,196,156,.20);
}


.mock-icon {

    width: 70px;

    height: 70px;

    margin:
        0 auto 18px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 20px;

    background:
        rgba(0,196,156,.11);

    border:
        1px solid rgba(0,196,156,.20);

    font-size: 31px;
}


.mock-card h3 {

    font-weight: 800;
}


.mock-card p {

    max-width: 650px;

    margin:
        10px auto 22px;

    color: #829d95;

    font-size: 13px;

    line-height: 1.7;
}


.mock-btn {

    display: inline-block;

    padding: 11px 22px;

    border-radius: 11px;

    text-decoration: none;

    color: white;

    background: #008c70;

    font-size: 12px;

    font-weight: 700;

    transition: .3s;
}


.mock-btn:hover {

    background: #00a985;

    color: white;

    transform: translateY(-2px);

    box-shadow:
        0 12px 30px
        rgba(0,196,156,.18);
}


/* =========================================================
   FOOTER
========================================================= */

.footer {

    text-align: center;

    padding: 28px;

    border-top:
        1px solid rgba(0,196,156,.10);

    color: #607a73;

    font-size: 11px;
}


.footer strong {

    color: #00c49c;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media(max-width:768px) {

    .main-container {

        padding:
            20px 14px 50px;
    }

    .hero {

        padding: 45px 20px;

        border-radius: 21px;
    }

    .hero h1 {

        letter-spacing: -1px;
    }

    .section-title {

        margin-top: 35px;
    }

}

</style>

</head>



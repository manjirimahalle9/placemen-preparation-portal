<script>

/* =========================================================
   MOCK INTERVIEW
========================================================= */

function startMockInterview() {

    const questions = [

        "Tell me about yourself.",

        "What are your strengths?",

        "Why should we hire you?",

        "Explain your final year project.",

        "What is OOP?",

        "What is DBMS?",

        "What is SQL?",

        "Where do you see yourself in five years?"

    ];


    let index = 0;


    function askQuestion() {

        if (index >= questions.length) {

            alert(
                "🎉 Mock Interview Completed!\n\n" +
                "Great job! Review your answers and improve the areas where you felt less confident."
            );

            return;

        }


        const answer = prompt(

            "Question " +
            (index + 1) +
            " of " +
            questions.length +
            ":\n\n" +
            questions[index]

        );


        if (answer !== null) {

            index++;

            setTimeout(
                askQuestion,
                100
            );

        }

    }


    askQuestion();

}

</script>



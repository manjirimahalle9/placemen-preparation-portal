<style>

/* =========================================================
   GLOBAL
========================================================= */

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {

    margin: 0;

    font-family: "Inter", sans-serif;

    color: #eafff9;

    background:
        radial-gradient(
            circle at 10% 10%,
            rgba(0,196,156,.14),
            transparent 28%
        ),
        radial-gradient(
            circle at 90% 20%,
            rgba(0,140,112,.13),
            transparent 28%
        ),
        radial-gradient(
            circle at 50% 100%,
            rgba(0,255,204,.07),
            transparent 35%
        ),
        #050807;

    min-height: 100vh;

    overflow-x: hidden;
}


/* =========================================================
   BACKGROUND
========================================================= */

.grid-bg {

    position: fixed;

    inset: 0;

    z-index: -3;

    opacity: .11;

    background-image:
        linear-gradient(
            rgba(0,196,156,.16) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0,196,156,.16) 1px,
            transparent 1px
        );

    background-size: 55px 55px;

    mask-image:
        linear-gradient(
            to bottom,
            black,
            transparent
        );
}


.glow {

    position: fixed;

    width: 350px;

    height: 350px;

    border-radius: 50%;

    filter: blur(100px);

    opacity: .16;

    pointer-events: none;

    z-index: -2;

    animation: floatingGlow 10s ease-in-out infinite alternate;
}

.glow-1 {

    background: #00c49c;

    top: 5%;

    left: -120px;
}

.glow-2 {

    background: #008c70;

    right: -120px;

    top: 40%;

    animation-delay: 2s;
}

.glow-3 {

    background: #00ffd0;

    bottom: -150px;

    left: 40%;

    animation-delay: 4s;
}


@keyframes floatingGlow {

    from {
        transform: translate(0,0) scale(1);
    }

    to {
        transform: translate(45px,-35px) scale(1.15);
    }
}


/* =========================================================
   NAVBAR
========================================================= */

.navbar {

    background:
        rgba(5,12,10,.80) !important;

    backdrop-filter: blur(18px);

    border-bottom:
        1px solid rgba(0,196,156,.14);

    padding: 14px 0;

    position: sticky;

    top: 0;

    z-index: 1000;
}


.navbar-brand {

    color: white !important;

    font-weight: 800;

    font-size: 20px;
}


.brand-dot {

    display: inline-block;

    width: 9px;

    height: 9px;

    border-radius: 50%;

    background: #00c49c;

    margin-right: 8px;

    box-shadow:
        0 0 15px #00c49c;
}


.dashboard-btn {

    color: #dffff7;

    border:
        1px solid rgba(0,196,156,.30);

    background:
        rgba(0,196,156,.07);

    padding: 9px 17px;

    border-radius: 10px;

    text-decoration: none;

    font-size: 13px;

    font-weight: 700;

    transition: .3s;
}


.dashboard-btn:hover {

    color: white;

    background: #008c70;

    transform: translateY(-2px);

    box-shadow:
        0 10px 30px rgba(0,196,156,.18);
}


/* =========================================================
   CONTAINER
========================================================= */

.main-container {

    max-width: 1250px;

    margin: auto;

    padding:
        35px 20px 70px;
}


/* =========================================================
   HERO
========================================================= */

.hero {

    position: relative;

    overflow: hidden;

    text-align: center;

    padding: 65px 25px;

    border-radius: 28px;

    background:
        linear-gradient(
            135deg,
            rgba(0,140,112,.26),
            rgba(0,196,156,.05)
        );

    border:
        1px solid rgba(0,196,156,.22);

    box-shadow:
        0 30px 80px rgba(0,0,0,.40);
}


.hero::before {

    content: "";

    position: absolute;

    width: 500px;

    height: 500px;

    border-radius: 50%;

    border:
        1px solid rgba(0,196,156,.09);

    left: 50%;

    top: 50%;

    transform:
        translate(-50%,-50%);

    animation:
        heroPulse 5s linear infinite;
}


.hero::after {

    content: "";

    position: absolute;

    width: 700px;

    height: 700px;

    border-radius: 50%;

    border:
        1px solid rgba(0,196,156,.04);

    left: 50%;

    top: 50%;

    transform:
        translate(-50%,-50%);
}


@keyframes heroPulse {

    0% {

        transform:
            translate(-50%,-50%)
            scale(.8);

        opacity: .1;
    }

    50% {

        opacity: .7;
    }

    100% {

        transform:
            translate(-50%,-50%)
            scale(1.15);

        opacity: 0;
    }
}


.hero-content {

    position: relative;

    z-index: 2;
}


.hero-badge {

    display: inline-flex;

    align-items: center;

    gap: 8px;

    padding: 8px 15px;

    border-radius: 50px;

    color: #68ffdc;

    background:
        rgba(0,196,156,.08);

    border:
        1px solid rgba(0,196,156,.22);

    font-size: 12px;

    font-weight: 800;

    margin-bottom: 18px;
}


.hero h1 {

    font-size:
        clamp(35px,5vw,62px);

    font-weight: 800;

    letter-spacing: -2px;

    margin-bottom: 15px;
}


.gradient-text {

    background:
        linear-gradient(
            90deg,
            #ffffff,
            #65ffdc,
            #00c49c
        );

    -webkit-background-clip: text;

    -webkit-text-fill-color: transparent;
}


.hero p {

    max-width: 750px;

    margin: auto;

    color: #9bb8b0;

    line-height: 1.8;

    font-size: 14px;
}


/* =========================================================
   STATS
========================================================= */

.stats {

    margin-top: 25px;
}


.stat-card {

    height: 100%;

    padding: 22px;

    border-radius: 18px;

    background:
        rgba(10,23,19,.75);

    border:
        1px solid rgba(0,196,156,.13);

    backdrop-filter: blur(15px);

    transition: .3s;
}


.stat-card:hover {

    transform: translateY(-5px);

    border-color:
        rgba(0,196,156,.35);

    box-shadow:
        0 15px 40px
        rgba(0,196,156,.08);
}


.stat-icon {

    width: 45px;

    height: 45px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 13px;

    background:
        rgba(0,196,156,.10);

    color: #63ffdd;

    font-size: 20px;

    margin-bottom: 12px;
}


.stat-number {

    font-size: 27px;

    font-weight: 800;
}


.stat-label {

    color: #708d85;

    font-size: 11px;

    margin-top: 4px;
}


/* =========================================================
   SECTION TITLE
========================================================= */

.section-title {

    margin-top: 50px;

    margin-bottom: 22px;
}


.section-title h2 {

    font-size: 25px;

    font-weight: 800;

    margin-bottom: 5px;
}


.section-title p {

    color: #708a83;

    font-size: 12px;

    margin: 0;
}


/* =========================================================
   INFO CARD
========================================================= */

.info-card {

    padding: 27px;

    border-radius: 20px;

    background:
        rgba(10,22,19,.78);

    border:
        1px solid rgba(0,196,156,.13);

    line-height: 1.8;

    color: #9bb4ad;

    box-shadow:
        0 15px 40px rgba(0,0,0,.18);
}


.info-card strong {

    color: #69ffdc;
}


/* =========================================================
   ROUND CARDS
========================================================= */

.round-card {

    height: 100%;

    padding: 25px;

    border-radius: 20px;

    background:
        linear-gradient(
            145deg,
            rgba(15,31,27,.90),
            rgba(7,16,14,.90)
        );

    border:
        1px solid rgba(0,196,156,.13);

    transition: .35s;
}


.round-card:hover {

    transform: translateY(-8px);

    border-color:
        rgba(0,196,156,.38);

    box-shadow:
        0 25px 55px rgba(0,0,0,.40);
}


.round-icon {

    width: 58px;

    height: 58px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 17px;

    background:
        rgba(0,196,156,.10);

    border:
        1px solid rgba(0,196,156,.18);

    font-size: 25px;

    margin-bottom: 18px;
}


.round-card h5 {

    font-weight: 800;

    margin-bottom: 9px;
}


.round-card p {

    color: #7e9992;

    font-size: 12px;

    line-height: 1.7;
}


.round-status {

    display: inline-block;

    padding: 5px 9px;

    border-radius: 50px;

    color: #69ffdc;

    background:
        rgba(0,196,156,.07);

    border:
        1px solid rgba(0,196,156,.15);

    font-size: 10px;

    font-weight: 700;
}


/* =========================================================
   ACCORDION
========================================================= */

.accordion {

    --bs-accordion-bg: transparent;

    --bs-accordion-border-color:
        rgba(0,196,156,.12);

    --bs-accordion-color: #dffcf5;

    --bs-accordion-btn-color: #e8fff9;

    --bs-accordion-btn-bg:
        rgba(10,22,19,.72);

    --bs-accordion-active-color: #72ffdf;

    --bs-accordion-active-bg:
        rgba(0,196,156,.08);

    --bs-accordion-btn-focus-box-shadow: none;
}


.accordion-item {

    margin-bottom: 10px;

    border-radius: 14px !important;

    overflow: hidden;

    border:
        1px solid rgba(0,196,156,.12) !important;
}


.accordion-button {

    padding: 17px 20px;

    font-size: 13px;

    font-weight: 700;
}


.accordion-button::after {

    filter:
        brightness(0)
        saturate(100%)
        invert(79%)
        sepia(28%)
        saturate(1000%);
}


.accordion-body {

    background:
        rgba(6,14,12,.85);

    color: #91aaa3;

    font-size: 12px;

    line-height: 1.8;

    padding: 22px;
}


.accordion-body strong {

    color: #65ffdc;
}


/* =========================================================
   QUESTION CARD
========================================================= */

.question-card {

    padding: 25px;

    border-radius: 20px;

    background:
        rgba(10,22,19,.76);

    border:
        1px solid rgba(0,196,156,.13);


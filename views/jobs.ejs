        /* ================= DATABASE JOBS ================= */

        let databaseJobs = [];

        if (
            typeof jobs !== "undefined" &&
            Array.isArray(jobs)
        ) {

            databaseJobs = jobs;

        }


        /* ================= SEARCH VALUES ================= */

        let currentRole =
            typeof searchRole !== "undefined"
                ? String(searchRole || "").trim().toLowerCase()
                : "";

        let currentLocation =
            typeof searchLocation !== "undefined"
                ? String(searchLocation || "").trim().toLowerCase()
                : "";


        /* ================= DISPLAY JOBS ================= */

        let displayJobs = databaseJobs;


        /*
         * If database has no jobs,
         * use fallback jobs.
         */

        if (displayJobs.length === 0) {

            displayJobs = fallbackJobs.filter(function(job) {

                const roleText = (

                    job.title + " " +
                    job.company + " " +
                    (job.skills || []).join(" ") + " " +
                    job.description

                ).toLowerCase();


                const locationText =
                    String(job.location || "").toLowerCase();


                const roleMatches =
                    !currentRole ||
                    roleText.includes(currentRole);


                let locationMatches = true;


                if (currentLocation) {

                    if (
                        currentLocation === "maharashtra"
                    ) {

                        locationMatches =
                            locationText.includes(
                                "maharashtra"
                            );

                    } else {

                        locationMatches =
                            locationText.includes(
                                currentLocation
                            );

                    }

                }


                return roleMatches && locationMatches;

            });

        }


        /*
         * If specific search returns no results,
         * show fallback jobs.
         */

        if (
            displayJobs.length === 0 &&
            (currentRole || currentLocation)
        ) {

            displayJobs = fallbackJobs;

        }

    %>


    <!-- =================================================
         JOB HEADING
    ================================================= -->

    <div class="section-heading">

        <h2>

            <i class="bi bi-lightning-charge-fill"></i>

            Latest Opportunities

        </h2>

        <span class="job-count">

            <%= displayJobs.length %> jobs found

        </span>

    </div>


    <!-- =================================================
         JOB LIST
    ================================================= -->

    <% if (displayJobs.length > 0) { %>


        <% displayJobs.forEach(function(job) { %>


            <div class="job-card">


                <div class="row align-items-center">


                    <!-- COMPANY LOGO -->

                    <div class="col-auto">

                        <div class="company-logo">

                            <%= job.company
                                ? String(job.company)
                                    .charAt(0)
                                    .toUpperCase()
                                : "J"
                            %>

                        </div>

                    </div>


                    <!-- JOB DETAILS -->

                    <div class="col">

                        <span class="latest-badge">

                            <i class="bi bi-lightning-fill"></i>

                            LATEST

                        </span>


                        <% if (
                            job.experience &&
                            String(job.experience)
                                .toLowerCase()
                                .includes("fresher")
                        ) { %>

                            <span class="fresher-badge">

                                <i class="bi bi-person-check"></i>

                                FRESHER

                            </span>

                        <% } %>


                        <div class="job-title">

                            <%= job.title || "Job Position" %>

                        </div>


                        <div class="company-name">

                            <i class="bi bi-building"></i>

                            <%= job.company || "Company" %>

                        </div>

                    </div>


                    <!-- APPLY -->

                    <div
                        class="col-md-auto
                               mt-3
                               mt-md-0">

                 <a
                    href="<%= job.applyLink && /^https?:\/\//i.test(job.applyLink) ? job.applyLink : '#' %>"
           target="_blank"
            rel="noopener noreferrer"
                 class="apply-btn">

    Apply Now
    <i class="bi bi-arrow-up-right"></i>

</a>

                    </div>

                </div>


                <!-- JOB INFORMATION -->

                <div class="job-info">


                    <span>

                        <i class="bi bi-geo-alt-fill"></i>

                        <%= job.location || "Maharashtra" %>

                    </span>


                    <span>

                        <i class="bi bi-clock-fill"></i>

                        <%= job.type || "Full Time" %>

                    </span>


                    <span>

                        <i class="bi bi-currency-rupee"></i>

                        <%= job.salary || "Competitive Salary" %>

                    </span>


                    <% if (job.experience) { %>

                        <span>

                            <i class="bi bi-person-workspace"></i>

                            <%= job.experience %>

                        </span>

                    <% } %>


                </div>


                <!-- SKILLS -->

                <% if (
                    job.skills &&
                    Array.isArray(job.skills) &&
                    job.skills.length > 0
                ) { %>


                    <div class="mt-3">

                        <% job.skills.forEach(function(skill) { %>

                            <span class="skill-tag">

                                <%= skill %>

                            </span>

                        <% }) %>

                    </div>


                <% } %>


                <!-- DESCRIPTION -->

                <% if (job.description) { %>

                    <div class="job-description">

                        <%= job.description %>

                    </div>

                <% } %>


                <!-- SOURCE -->

                <div class="source-badge">

                    <i class="bi bi-shield-check"></i>

                    PlacementX Vacancy

                </div>


            </div>


        <% }) %>


    <% } else { %>


        <!-- EMPTY STATE -->

        <div class="empty-message">

            <i class="bi bi-search"></i>

            <h4 class="mt-3">

                No vacancies available

            </h4>

            <p>

                Try another job role or Maharashtra
                location.

            </p>

        </div>


    <% } %>


</div>


<!-- =====================================================
     FOOTER
===================================================== -->

<div class="footer">

    © 2026 PlacementX

    <br>

    Find your opportunity. Build your career. 🚀

</div>


<!-- =====================================================
     JAVASCRIPT
===================================================== -->

<script>

    function quickSearch(role) {

        const roleInput =
            document.getElementById("roleSearch");

        const locationInput =
            document.getElementById("locationSearch");

        roleInput.value = role;

        locationInput.value = "";

        document
            .querySelector(".search-box form")
            .submit();

    }


    function quickLocation(location) {

        const roleInput =
            document.getElementById("roleSearch");

        const locationInput =
            document.getElementById("locationSearch");

        locationInput.value = location;

        roleInput.value = "";

        document
            .querySelector(".search-box form")
            .submit();

    }


    /* ================= ENTER KEY SEARCH ================= */

    document
        .getElementById("roleSearch")
        .addEventListener(
            "keypress",
            function(event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    document
                        .querySelector(".search-box form")
                        .submit();

                }

            }
        );


    document
        .getElementById("locationSearch")
        .addEventListener(
            "keypress",
            function(event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    document
                        .querySelector(".search-box form")
                        .submit();

                }

            }
        );

</script>


</body>


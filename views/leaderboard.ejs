<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Leaderboard | Placement Preparation Portal</title>


    <!-- Bootstrap -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">


    <style>

        /* ================= BODY ================= */

        body {

            margin: 0;

            background: #f4f7fb;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

        }


        /* ================= NAVBAR ================= */

        .navbar-brand {

            font-weight: 600;

        }


        /* ================= HEADER ================= */

        .leaderboard-header {

            background:
                linear-gradient(
                    135deg,
                    #0d6efd,
                    #6610f2
                );

            color: white;

            padding: 45px 20px;

            text-align: center;

        }


        .leaderboard-header h1 {

            font-size: 36px;

            font-weight: 700;

            margin-bottom: 10px;

        }


        .leaderboard-header p {

            margin: 0;

            font-size: 16px;

            opacity: 0.9;

        }


        /* ================= MAIN CONTAINER ================= */

        .main-container {

            width: 100%;

            max-width: 1200px;

            margin: 30px auto;

            padding: 0 15px;

        }


        /* ================= CARDS ================= */

        .custom-card {

            background: white;

            border-radius: 15px;

            border: none;

            box-shadow:
                0 5px 20px
                rgba(0, 0, 0, 0.08);

        }


        /* ================= DAILY CHALLENGE ================= */

        .challenge-card {

            padding: 25px;

            margin-bottom: 25px;

        }


        .challenge-title {

            font-weight: 700;

            color: #212529;

        }


        .challenge-btn {

            background: #dc3545;

            color: white;

            border: none;

            border-radius: 8px;

            padding: 10px 20px;

            font-weight: 600;

        }


        .challenge-btn:hover {

            background: #bb2d3b;

            color: white;

        }


        /* ================= STAT CARDS ================= */

        .stat-card {

            background: white;

            border-radius: 15px;

            border: none;

            padding: 20px;

            text-align: center;

            height: 100%;

            box-shadow:
                0 5px 15px
                rgba(0, 0, 0, 0.07);

            transition: 0.3s;

        }


        .stat-card:hover {

            transform: translateY(-4px);

        }


        .stat-icon {

            font-size: 35px;

            margin-bottom: 5px;

        }


        .stat-number {

            font-size: 25px;

            font-weight: 700;

            margin: 5px 0;

        }


        .stat-label {

            color: #6c757d;

            font-size: 14px;

        }


        .streak {

            color: #dc3545;

        }


        .points {

            color: #198754;

        }


        /* ================= TASK CARD ================= */

        .task-card {

            padding: 25px;

            margin-top: 25px;

        }


        .task-table {

            margin-bottom: 0;

        }


        .task-table th {

            background: #212529;

            color: white;

            padding: 12px;

        }


        .task-table td {

            padding: 12px;

            vertical-align: middle;

        }


        /* ================= LEADERBOARD ================= */

        .leaderboard-card {

            width: 100%;

            max-width: 1200px;

            margin: 25px auto;

            background: white;

            border-radius: 15px;

            border: none;

            box-shadow:
                0 5px 20px
                rgba(0, 0, 0, 0.08);

        }


        .leaderboard-card .card-body {

            padding: 25px;

        }


        .leaderboard-table {

            width: 100%;

            font-size: 14px;

            margin-bottom: 0;

        }


        .leaderboard-table th {

            background: #212529;

            color: white;

            padding: 10px 8px;

            vertical-align: middle;

            text-align: center;

        }


        .leaderboard-table td {

            padding: 10px 8px;

            vertical-align: middle;

            text-align: center;

            white-space: normal;

        }


        /* ================= RANK COLORS ================= */

        .rank-one {

            background: #fff3cd;

        }


        .rank-two {

            background: #f1f3f5;

        }


        .rank-three {

            background: #ffe5e5;

        }


        /* ================= POINTS ================= */

        .points-text {

            color: #198754;

            font-weight: 700;

        }


        /* ================= STREAK ================= */

        .streak-text {

            color: #dc3545;

            font-weight: 700;

        }


        /* ================= BADGES ================= */

        .level-badge {

            font-size: 12px;

            padding: 6px 9px;

        }


        /* ================= PROGRESS ================= */

        .progress {

            height: 7px;

            min-width: 70px;

        }


        .progress-text {

            font-size: 11px;

            color: #6c757d;

        }


        /* ================= BACK BUTTON ================= */

        .back-button {

            margin: 25px 0 40px;

            text-align: center;

        }


        /* ================= MOBILE ================= */

        @media (max-width: 768px) {

            .leaderboard-header h1 {

                font-size: 28px;

            }


            .leaderboard-header {

                padding: 35px 15px;

            }


            .main-container {

                margin-top: 20px;

            }


            .challenge-card {

                text-align: center;

            }


            .challenge-button-container {

                margin-top: 15px;

            }


            .leaderboard-card .card-body {

                padding: 15px;

            }


            .leaderboard-table {

                font-size: 12px;

            }


            .leaderboard-table th,
            .leaderboard-table td {

                padding: 8px 5px;

            }

        }

    </style>

</head>


<body>


<!-- ================================================= -->

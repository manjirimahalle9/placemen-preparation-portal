<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Login | Placement Preparation Portal</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <style>



        * {
            box-sizing: border-box;
        }


        /* ================= BODY ================= */

        body {

            margin: 0;

            min-height: 100vh;

            font-family: Arial, Helvetica, sans-serif;

            background:
                linear-gradient(
                    135deg,
                    #003f35,
                    #006f5a,
                    #008c70
                );

            display: flex;

            align-items: center;

            justify-content: center;

            padding: 30px;

        }


        /* ================= CONTAINER ================= */

        .login-container {

            width: 100%;

            max-width: 460px;

        }


        /* ================= LOGIN CARD ================= */

        .login-box {

            background: rgba(255, 255, 255, 0.98);

            border-radius: 28px 10px 28px 10px;

            padding: 45px;

            box-shadow:
                0 25px 60px
                rgba(0, 0, 0, 0.30);

            position: relative;

            overflow: hidden;

        }


        /* ================= TOP DESIGN ================= */

        .login-box::before {

            content: "";

            position: absolute;

            top: 0;

            left: 0;

            width: 100%;

            height: 7px;

            background:
                linear-gradient(
                    90deg,
                    #006f5a,
                    #008c70,
                    #32b89d
                );

        }


        /* ================= LOGO ================= */

        .logo {

            width: 80px;

            height: 80px;

            margin: 0 auto 22px;

            border-radius: 22px;

            background:
                linear-gradient(
                    135deg,
                    #008c70,
                    #006f5a
                );

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 40px;

            box-shadow:
                0 10px 25px
                rgba(0, 140, 112, 0.30);

            transform: rotate(-3deg);

        }


        /* ================= TITLE ================= */

        .login-title {

            text-align: center;

            font-size: 30px;

            font-weight: 700;

            color: #16332e;

            margin-bottom: 8px;

        }


        .login-subtitle {

            text-align: center;

            color: #64746f;

            font-size: 14px;

            margin-bottom: 32px;

        }


        /* ================= LABEL ================= */

        .form-label {

            font-weight: 600;

            color: #33413e;

            margin-bottom: 8px;

        }


        /* ================= INPUT ================= */

        .form-control {

            height: 52px;

            border-radius: 0 12px 12px 0;

            border: 1px solid #c9ddd8;

            font-size: 15px;

            background: #f7fbfa;

        }


        .form-control:focus {

            border-color: #008c70;

            box-shadow:
                0 0 0 3px
                rgba(0, 140, 112, 0.12);

            background: white;

        }


        /* ================= INPUT ICON ================= */

        .input-group-text {

            height: 52px;

            background: #f7fbfa;

            border: 1px solid #c9ddd8;

            border-right: none;

            border-radius: 12px 0 0 12px;

            font-size: 18px;

        }


        /* ================= PASSWORD BUTTON ================= */

        .password-button {

            height: 52px;

            background: #f7fbfa;

            border: 1px solid #c9ddd8;

            border-left: none;

            border-radius: 0 12px 12px 0;

        }


        .password-button:hover {

            background: #e6f3f0;

        }


        /* ================= REMEMBER ================= */

        .remember {

            display: flex;

            justify-content: space-between;

            align-items: center;

            margin: 20px 0 25px;

            font-size: 14px;

        }


        .form-check-input:checked {

            background-color: #008c70;

            border-color: #008c70;

        }


        .form-check-input:focus {

            border-color: #008c70;

            box-shadow:
                0 0 0 3px
                rgba(0, 140, 112, 0.12);

        }


        /* ================= FORGOT ================= */

        .forgot {

            color: #008c70;

            text-decoration: none;

            font-weight: 600;

        }


        .forgot:hover {

            color: #006f5a;

            text-decoration: underline;

        }


        /* ================= LOGIN BUTTON ================= */

        .login-btn {

            width: 100%;

            height: 54px;

            border: none;

            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    #008c70,
                    #006f5a
                );

            color: white;

            font-size: 17px;

            font-weight: 600;

            transition: all 0.3s ease;

        }


        .login-btn:hover {

            background:
                linear-gradient(
                    135deg,
                    #006f5a,
                    #005747
                );

            transform: translateY(-2px);

            box-shadow:
                0 10px 25px
                rgba(0, 140, 112, 0.30);

        }


        /* ================= REGISTER ================= */

        .register-text {

            text-align: center;

            margin-top: 25px;

            color: #64746f;

            font-size: 14px;

        }


        .register-text a {

            color: #008c70;

            font-weight: 700;

            text-decoration: none;

        }


        .register-text a:hover {

            color: #006f5a;

            text-decoration: underline;

        }


        /* ================= FOOTER ================= */

        .footer-text {

            text-align: center;

            color: #94a8a3;

            font-size: 12px;

            margin-top: 25px;

        }


        /* ================= DECORATIONS ================= */

        .circle-one {

            position: fixed;

            width: 250px;

            height: 250px;

            border-radius: 50%;

            background:
                rgba(0, 140, 112, 0.15);

            top: -80px;

            left: -80px;

            z-index: -1;

        }


        .circle-two {

            position: fixed;

            width: 300px;

            height: 300px;

            border-radius: 50%;

            background:
                rgba(50, 184, 157, 0.12);

            bottom: -120px;

            right: -100px;

            z-index: -1;

        }


        /* ================= MOBILE ================= */

        @media (max-width: 500px) {

            body {

                padding: 15px;

            }


            .login-box {

                padding: 35px 25px;

                border-radius:
                    25px 8px 25px 8px;

            }


            .login-title {

                font-size: 26px;

            }


            .logo {

                width: 70px;

                height: 70px;

                font-size: 35px;

            }

        }

    </style>

</head>


<body>


<!-- ================= BACKGROUND DECORATIONS ================= -->

<div class="circle-one"></div>

<div class="circle-two"></div>



<!-- ================= LOGIN ================= -->

<div class="login-container">

    <div class="login-box">


        <!-- ================= LOGO ================= -->

        <div class="logo">

            🎓

        </div>



        <!-- ================= TITLE ================= -->

        <h1 class="login-title">

            Welcome Back!

        </h1>


        <p class="login-subtitle">

            Login to continue your placement preparation

        </p>



        <!-- ================= LOGIN FORM ================= -->

        <form action="/login" method="POST">


            <!-- ================= EMAIL ================= -->

            <div class="mb-3">

                <label
                    for="email"
                    class="form-label">

                    Email Address

                </label>


                <div class="input-group">

                    <span class="input-group-text">

                        📧

                    </span>


                    <input
                        type="email"
                        id="email"
                        name="email"
                        class="form-control"
                        placeholder="Enter your email"
                        autocomplete="email"
                        required>

                </div>

            </div>



            <!-- ================= PASSWORD ================= -->

            <div class="mb-3">

                <label
                    for="password"
                    class="form-label">

                    Password

                </label>


                <div class="input-group">

                    <span class="input-group-text">

                        🔒

                    </span>


                    <input
                        type="password"
                        id="password"
                        name="password"
                        class="form-control"
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required>


                    <button
                        type="button"
                        class="btn password-button"
                        onclick="togglePassword()">

                        👁️

                    </button>

                </div>

            </div>



            <!-- ================= OPTIONS ================= -->

            <div class="remember">


                <div>

                    <input
                        type="checkbox"
                        id="remember"
                        name="remember"
                        class="form-check-input">


                    <label
                        for="remember"
                        class="ms-1">

                        Remember me

                    </label>

                </div>



                <a
                    href="/forgot-password"
                    class="forgot">

                    Forgot Password?

                </a>

            </div>



            <!-- ================= LOGIN BUTTON ================= -->

            <button
                type="submit"
                class="login-btn">

                🔐 Login

            </button>


        </form>



        <!-- ================= REGISTER ================= -->

        <div class="register-text">

            Don't have an account?

            <a href="/register">

                Create Account

            </a>

        </div>



        <!-- ================= FOOTER ================= -->

        <div class="footer-text">

            © 2026 Placement Preparation Portal

        </div>


    </div>

</div>



<!-- ================= JAVASCRIPT ================= -->

<script>

function togglePassword() {

    const password =
        document.getElementById("password");

    const button =
        document.querySelector(".password-button");


    if (password.type === "password") {

        password.type = "text";

        button.innerHTML = "🙈";

    }

    else {

        password.type = "password";

        button.innerHTML = "👁️";

    }

}

</script>


</body>

</html>
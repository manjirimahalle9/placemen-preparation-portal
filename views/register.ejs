<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Student Registration | Placement Portal</title>

    <!-- Bootstrap -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        font-family: Arial, sans-serif;
        background: #f3f8f7;
        color: #1f2937;
    }

    /* ================= NAVBAR ================= */

    .navbar-custom {
        background: #ffffff;
        border-bottom: 1px solid #d9ebe7;
        padding: 15px 0;
    }

    .brand {
        font-size: 22px;
        font-weight: 700;
        color: #008c70;
        text-decoration: none;
    }

    .brand span {
        color: #172b2b;
    }

    .login-btn {
        border: 1px solid #008c70;
        color: #008c70;
        padding: 8px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
        transition: 0.3s;
    }

    .login-btn:hover {
        background: #008c70;
        color: white;
    }


    /* ================= MAIN ================= */

    .register-wrapper {
        min-height: calc(100vh - 70px);
        padding: 50px 15px;
    }

    .register-container {
        max-width: 1050px;
        margin: auto;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 40px rgba(0, 80, 65, 0.10);
    }


    /* ================= LEFT SIDE ================= */

    .register-left {
        background: linear-gradient(
            135deg,
            #008c70,
            #006f5a
        );

        color: white;
        padding: 50px 35px;
        height: 100%;
    }

    .register-left h1 {
        font-size: 32px;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .register-left p {
        color: #d9fff6;
        line-height: 1.7;
    }


    /* ================= BENEFITS ================= */

    .benefit {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 25px;
    }

    .benefit-icon {
        width: 44px;
        height: 44px;
        border-radius: 11px;

        background: rgba(255,255,255,0.15);

        display: flex;
        justify-content: center;
        align-items: center;

        font-size: 20px;

        border: 1px solid rgba(255,255,255,0.15);
    }


    /* ================= FORM ================= */

    .register-form {
        padding: 45px;
    }

    .form-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 5px;
        color: #172b2b;
    }

    .form-subtitle {
        color: #6b7280;
        margin-bottom: 30px;
    }


    /* ================= SECTION TITLE ================= */

    .section-title {
        font-size: 17px;
        font-weight: 700;

        margin: 25px 0 18px;

        color: #008c70;

        border-bottom: 1px solid #d9ebe7;

        padding-bottom: 10px;
    }


    /* ================= LABEL ================= */

    .form-label {
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 7px;
        color: #374151;
    }


    /* ================= INPUT ================= */

    .form-control,
    .form-select {

        min-height: 46px;

        border: 1px solid #cbded9;

        border-radius: 9px;

        padding: 10px 13px;

        background: #ffffff;

        transition: 0.2s;
    }


    .form-control:hover,
    .form-select:hover {
        border-color: #72b9aa;
    }


    .form-control:focus,
    .form-select:focus {

        border-color: #008c70;

        box-shadow:
            0 0 0 3px rgba(0, 140, 112, 0.12);

    }


    /* ================= PLACEHOLDER ================= */

    .form-control::placeholder {
        color: #9ca3af;
    }


    /* ================= RESUME ================= */

    .resume-box {

        border: 2px dashed #9ccfc3;

        border-radius: 10px;

        padding: 20px;

        background: #f3faf8;

        transition: 0.3s;
    }

    .resume-box:hover {
        border-color: #008c70;
        background: #edf8f5;
    }

    .resume-box small {
        color: #6b7280;
    }


    /* ================= TERMS ================= */

    .terms {
        margin-top: 25px;
    }

    .terms label {
        font-size: 14px;
        color: #4b5563;
    }

    .terms a {
        color: #008c70;
        text-decoration: none;
        font-weight: 600;
    }

    .terms a:hover {
        text-decoration: underline;
    }


    /* ================= CHECKBOX ================= */

    .form-check-input:checked {
        background-color: #008c70;
        border-color: #008c70;
    }

    .form-check-input:focus {
        border-color: #008c70;
        box-shadow: 0 0 0 3px rgba(0, 140, 112, 0.12);
    }


    /* ================= REGISTER BUTTON ================= */

    .register-btn {

        width: 100%;

        border: none;

        background: #008c70;

        color: white;

        padding: 13px;

        border-radius: 9px;

        font-size: 16px;

        font-weight: 700;

        margin-top: 22px;

        transition: 0.3s;

        box-shadow: 0 5px 15px rgba(0, 140, 112, 0.20);
    }


    .register-btn:hover {

        background: #006f5a;

        transform: translateY(-2px);

        box-shadow:
            0 8px 20px rgba(0, 140, 112, 0.25);
    }


    /* ================= LOGIN ================= */

    .already-account {

        text-align: center;

        margin-top: 20px;

        color: #6b7280;

        font-size: 14px;
    }

    .already-account a {

        color: #008c70;

        font-weight: 600;

        text-decoration: none;
    }

    .already-account a:hover {
        text-decoration: underline;
    }


    /* ================= ICON COLOR ================= */

    .section-title i {
        margin-right: 6px;
    }


    /* ================= MOBILE ================= */

    @media(max-width: 768px) {

        .register-left {
            padding: 35px 25px;
        }

        .register-form {
            padding: 30px 20px;
        }

        .register-left h1 {
            font-size: 26px;
        }

        .register-wrapper {
            padding: 25px 12px;
        }

    }

</style>

</head>


<body>


<!-- ================= NAVBAR ================= -->

<nav class="navbar-custom">

    <div class="container d-flex justify-content-between align-items-center">

        <a href="#" class="brand">
            Placement<span>Portal</span>
        </a>

        <a href="login.html" class="login-btn">
            Login
        </a>

    </div>

</nav>



<!-- ================= REGISTER ================= -->

<section class="register-wrapper">

    <div class="register-container">

        <div class="row g-0">


            <!-- ================= LEFT SIDE ================= -->

            <div class="col-lg-5">

                <div class="register-left">

                    <h1>
                        Start Your Career Journey 🚀
                    </h1>

                    <p>
                        Create your student account and get access
                        to placement opportunities, coding practice,
                        aptitude preparation and interview resources.
                    </p>


                    <div class="benefit">

                        <div class="benefit-icon">
                            <i class="bi bi-briefcase"></i>
                        </div>

                        <div>
                            <strong>Latest Job Opportunities</strong>

                            <br>

                            <small>
                                Find jobs and internships
                            </small>
                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            <i class="bi bi-code-slash"></i>
                        </div>

                        <div>
                            <strong>Coding Preparation</strong>

                            <br>

                            <small>
                                Practice programming questions
                            </small>
                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            <i class="bi bi-bar-chart"></i>
                        </div>

                        <div>
                            <strong>Aptitude Preparation</strong>

                            <br>

                            <small>
                                Improve your aptitude skills
                            </small>
                        </div>

                    </div>


                    <div class="benefit">

                        <div class="benefit-icon">
                            <i class="bi bi-person-check"></i>
                        </div>

                        <div>
                            <strong>Interview Preparation</strong>

                            <br>

                            <small>
                                Prepare for technical interviews
                            </small>
                        </div>

                    </div>

                </div>

            </div>



            <!-- ================= RIGHT SIDE ================= -->

            <div class="col-lg-7">

                <div class="register-form">


                    <h2 class="form-title">
                        Student Registration
                    </h2>

                    <p class="form-subtitle">
                        Create your account to access the placement portal.
                    </p>


                    <form
                        id="studentRegisterForm"
                        action="/register"
                        method="POST"></form>
                   


                        <!-- ================= PERSONAL INFORMATION ================= -->

                        <div class="section-title">

                            <i class="bi bi-person"></i>

                            Personal Information

                        </div>


                        <div class="row g-3">


                            <!-- FULL NAME -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Full Name *
                                </label>

                                <input
                                    type="text"
                                    name="name"
                                    class="form-control"
                                    placeholder="Enter your full name"
                                    required>

                            </div>


                            <!-- EMAIL -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Email Address *
                                </label>

                                <input
                                    type="email"
                                    name="email"
                                    class="form-control"
                                    placeholder="student@example.com"
                                    required>

                            </div>


                            <!-- MOBILE -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Mobile Number *
                                </label>

                                <input
                                    type="tel"
                                    name="mobile"
                                    class="form-control"
                                    placeholder="Enter mobile number"
                                    pattern="[0-9]{10}"
                                    required>

                            </div>


                            <!-- ROLL NUMBER -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Roll Number *
                                </label>

                                <input
                                    type="text"
                                    name="rollNumber"
                                    class="form-control"
                                    placeholder="Enter roll number"
                                    required>

                            </div>

                        </div>



                        <!-- ================= ACADEMIC INFORMATION ================= -->

                        <div class="section-title">

                            <i class="bi bi-mortarboard"></i>

                            Academic Information

                        </div>


                        <div class="row g-3">


                            <!-- COLLEGE -->

                            <div class="col-12">

                                <label class="form-label">
                                    College Name *
                                </label>

                                <input
                                    type="text"
                                    name="college"
                                    class="form-control"
                                    placeholder="Enter your college name"
                                    required>

                            </div>


                            <!-- DEGREE -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Degree *
                                </label>

                                <select
                                    name="degree"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Select Degree
                                    </option>

                                    <option>
                                        B.E.
                                    </option>

                                    <option>
                                        B.Tech
                                    </option>

                                    <option>
                                        BCA
                                    </option>

                                    <option>
                                        B.Sc
                                    </option>

                                    <option>
                                        MCA
                                    </option>

                                    <option>
                                        M.Tech
                                    </option>

                                </select>

                            </div>


                            <!-- BRANCH -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Branch *
                                </label>

                                <select
                                    name="branch"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Select Branch
                                    </option>

                                    <option>
                                        Computer Science
                                    </option>

                                    <option>
                                        Information Technology
                                    </option>

                                    <option>
                                        Artificial Intelligence
                                    </option>

                                    <option>
                                        Artificial Intelligence & Data Science
                                    </option>

                                    <option>
                                        Data Science
                                    </option>

                                    <option>
                                        Electronics & Telecommunication
                                    </option>

                                    <option>
                                        Mechanical Engineering
                                    </option>

                                    <option>
                                        Civil Engineering
                                    </option>

                                </select>

                            </div>


                            <!-- GRADUATION YEAR -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Graduation Year *
                                </label>

                                <select
                                    name="graduationYear"
                                    class="form-select"
                                    required>

                                    <option value="">
                                        Select Year
                                    </option>

                                    <option>2026</option>
                                    <option>2027</option>
                                    <option>2028</option>
                                    <option>2029</option>
                                    <option>2030</option>

                                </select>

                            </div>


                            <!-- CGPA -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    CGPA / Percentage
                                </label>

                                <input
                                    type="text"
                                    name="cgpa"
                                    class="form-control"
                                    placeholder="Example: 8.2 CGPA">

                            </div>


                        </div>



                        <!-- ================= SKILLS ================= -->

                        <div class="section-title">

                            <i class="bi bi-code-square"></i>

                            Skills

                        </div>


                        <div class="mb-3">

                            <label class="form-label">
                                Technical Skills
                            </label>

                            <input
                                type="text"
                                name="skills"
                                class="form-control"
                                placeholder="Example: Python, Java, SQL, HTML, CSS, Power BI">

                            <small class="text-muted">
                                Separate multiple skills using commas.
                            </small>

                        </div>



                        <!-- ================= RESUME ================= -->

                        <div class="section-title">

                            <i class="bi bi-file-earmark-text"></i>

                            Resume

                        </div>


                        <div class="resume-box">

                            <label class="form-label">
                                Upload Resume
                            </label>

                            <input
                                type="file"
                                name="resume"
                                class="form-control"
                                accept=".pdf,.doc,.docx">

                            <small>
                                Accepted formats: PDF, DOC, DOCX
                            </small>

                        </div>



                        <!-- ================= SECURITY ================= -->

                        <div class="section-title">

                            <i class="bi bi-shield-lock"></i>

                            Account Security

                        </div>


                        <div class="row g-3">


                            <!-- PASSWORD -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Password *
                                </label>

                                <input
                                    type="password"
                                    name="password"
                                    id="password"
                                    class="form-control"
                                    placeholder="Create password"
                                    minlength="6"
                                    required>

                            </div>


                            <!-- CONFIRM PASSWORD -->

                            <div class="col-md-6">

                                <label class="form-label">
                                    Confirm Password *
                                </label>

                                <input
                                    type="password"
                                    name="confirmPassword"
                                    id="confirmPassword"
                                    class="form-control"
                                    placeholder="Confirm password"
                                    minlength="6"
                                    required>

                            </div>

                        </div>



                        <!-- ================= TERMS ================= -->

                        <div class="terms form-check">

                            <input
                                type="checkbox"
                                class="form-check-input"
                                id="terms"
                                required>

                            <label
                                class="form-check-label"
                                for="terms">

                                I agree to the
                                <a href="#">
                                    Terms & Conditions
                                </a>
                                and
                                <a href="#">
                                    Privacy Policy
                                </a>.

                            </label>

                        </div>



                        <!-- ================= BUTTON ================= -->

                        <button
                            type="submit"
                            class="register-btn">

                            <i class="bi bi-person-plus"></i>

                            Create Student Account

                        </button>


                        <div class="already-account">

                            Already have an account?

                            <a href="login.html">
                                Login here
                            </a>

                        </div>


                    </form>

                </div>

            </div>

        </div>

    </div>

</section>



<!-- ================= JAVASCRIPT ================= -->

<script>

document
    .getElementById("studentRegisterForm")
    .addEventListener("submit", function(event) {

        const password =
            document.getElementById("password").value;

        const confirmPassword =
            document.getElementById("confirmPassword").value;


        if (password !== confirmPassword) {

            event.preventDefault();

            alert("Passwords do not match!");

            return;

        }

    });

</script>


</body>

</html>
 
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Resume Builder | Placement</title>

    <!-- ================= BOOTSTRAP ================= -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- ================= BOOTSTRAP ICONS ================= -->

    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        /* =====================================================
           GENERAL
        ===================================================== */

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {

            margin: 0;

            font-family:
                Arial,
                Helvetica,
                sans-serif;

            background: #050706 !important;

            color: white !important;

            min-height: 100vh;

        }

        .container {
            max-width: 1250px;
        }


        /* =====================================================
           NAVBAR
        ===================================================== */

        .navbar-custom {

            background: #050706 !important;

            border-bottom:
                1px solid #008c70;

            padding: 14px 0;

            position: sticky;

            top: 0;

            z-index: 1000;

        }

        .brand {

            text-decoration: none;

            font-size: 22px;

            font-weight: 700;

            color: #00c49c;

        }

        .brand span {
            color: white;
        }

        .nav-link {

            color: rgba(255,255,255,.8) !important;

            font-weight: 600;

            transition: .3s;

            text-decoration: none;

        }

        .nav-link:hover {

            color: #00c49c !important;

        }
.profile-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;

    background: #008c70;
    color: white !important;

    border: none;
    padding: 8px 16px;

    border-radius: 8px;

    font-weight: 600;
    text-decoration: none;

    transition: .3s;
}

.profile-btn:hover {
    background: #00a886;
    color: white !important;
    transform: translateY(-2px);
}


        /* =====================================================
           PAGE HEADER
        ===================================================== */

        .page-header {

            background:
                linear-gradient(
                    135deg,
                    #050706,
                    #071d17,
                    #050706
                );

            color: white;

            padding: 45px 20px;

            border-bottom:
                1px solid #008c70;

            text-align: center;

            box-shadow:
                0 5px 25px
                rgba(0,140,112,.10);

        }

        .page-header h1 {

            font-size: 32px;

            font-weight: 700;

            margin-bottom: 8px;

            color: #00c49c;

        }

        .page-header p {

            margin: 0;

            color: rgba(255,255,255,.75);

        }


        /* =====================================================
           MAIN
        ===================================================== */

        .main-container {

            max-width: 1250px;

            margin: 35px auto;

            padding: 0 15px;

        }


        /* =====================================================
           BUILDER CARD
        ===================================================== */

        .builder-card {

            background: #050706 !important;

            border-radius: 18px;

            padding: 30px;

            box-shadow:
                0 0 20px
                rgba(0,140,112,.08);

            border:
                1px solid #008c70 !important;

        }


        /* =====================================================
           SECTION TITLE
        ===================================================== */

        .section-title {

            display: flex;

            align-items: center;

            gap: 10px;

            font-size: 18px;

            font-weight: 700;

            color: #ffffff;

            border-bottom:
                1px solid #285e51;

            padding-bottom: 12px;

            margin-bottom: 20px;

        }

        .section-title i {

            color: #00c49c;

        }


        /* =====================================================
           FORM
        ===================================================== */

        .form-label {

            font-size: 14px;

            font-weight: 600;

            color: rgba(255,255,255,.9);

        }

        .form-control,
        .form-select {

            min-height: 45px;

            border:
                1px solid #285e51;

            border-radius: 8px;

            padding: 10px 12px;

            background: #0a100e !important;

            color: white !important;

        }

        .form-control::placeholder {

            color:
                rgba(255,255,255,.40);

        }

        .form-control:focus,
        .form-select:focus {

            border-color: #00c49c;

            box-shadow:
                0 0 0 3px
                rgba(0,196,156,.12);

            background: #0a100e !important;

            color: white !important;

        }

        textarea.form-control {

            min-height: 100px;

            resize: vertical;

        }

        .text-muted {

            color:
                rgba(255,255,255,.50) !important;

        }


        /* =====================================================
           CERTIFICATE UPLOAD
        ===================================================== */

        .resume-upload-box {

            border:
                2px dashed #285e51;

            background: #0a100e;

            padding: 20px;

            border-radius: 12px;

            transition: .3s;

        }

        .resume-upload-box:hover {

            border-color: #00c49c;

            background: #0d1c18;

        }

        input[type="file"] {

            color: white;

            background: #0a100e;

        }

        input[type="file"]::file-selector-button {

            background: #008c70;

            color: white;

            border: none;

            padding: 8px 14px;

            margin-right: 10px;

            border-radius: 6px;

            cursor: pointer;

        }

        input[type="file"]::file-selector-button:hover {

            background: #00a886;

        }


        /* =====================================================
           CERTIFICATE PREVIEW
        ===================================================== */

        .certificate-preview {

            display: grid;

            grid-template-columns:
                repeat(
                    auto-fit,
                    minmax(150px, 1fr)
                );

            gap: 15px;

            margin-top: 20px;

        }

        .certificate-card {

            background: #0a100e;

            border:
                1px solid #285e51;

            border-radius: 10px;

            padding: 8px;

            box-shadow:
                0 0 12px
                rgba(0,140,112,.10);

        }

        .certificate-card img {

            width: 100%;

            height: 120px;

            object-fit: cover;

            border-radius: 7px;

        }

        .certificate-name {

            font-size: 12px;

            font-weight: 600;

            color: #00c49c;

            margin-top: 7px;

            word-break: break-word;

        }


        /* =====================================================
           GENERATE BUTTON
        ===================================================== */

        .generate-btn {

            width: 100%;

            border: none;

            background: #008c70;

            color: white;

            padding: 13px;

            border-radius: 9px;

            font-weight: 700;

            margin-top: 20px;

            transition: .3s;

        }

        .generate-btn:hover {

            background: #00a886;

            color: white;

            transform: translateY(-2px);

            box-shadow:
                0 5px 20px
                rgba(0,196,156,.20);

        }


        /* =====================================================
           PREVIEW
        ===================================================== */

        .preview-container {

            position: sticky;

            top: 90px;

        }

        .preview-header {

            display: flex;

            justify-content:
                space-between;

            align-items: center;

            margin-bottom: 15px;

        }

        .preview-title {

            font-size: 20px;

            font-weight: 700;

            color: #00c49c;

        }


        /* =====================================================
           PRINT BUTTON
        ===================================================== */

        .print-btn {

            background: #008c70;

            border: none;

            color: white;

            padding: 8px 15px;

            border-radius: 7px;

            font-weight: 600;

            transition: .3s;

        }

        .print-btn:hover {

            background: #00a886;

            color: white;

        }


        /* =====================================================
           RESUME PAPER
        ===================================================== */

        .resume-paper {

            background: #ffffff;

            width: 100%;

            min-height: 1120px;

            padding: 40px;

            box-shadow:
                0 8px 30px
                rgba(0,0,0,.40);

            border-radius: 5px;

            color: #222222;

        }


        /* =====================================================
           RESUME HEADER
        ===================================================== */

        .resume-name {

            font-size: 30px;

            font-weight: 800;

            color: #006f5a;

            margin-bottom: 5px;

        }

        .resume-role {

            font-size: 15px;

            color: #333333;

            font-weight: 600;

            margin-bottom: 12px;

        }

        .contact-line {

            font-size: 12px;

            color: #333333;

            border-bottom:
                2px solid #008c70;

            padding-bottom: 15px;

            margin-bottom: 20px;

            line-height: 1.8;

        }

        .contact-line a {

            color: #006f5a;

            text-decoration: none;

            font-weight: 600;

        }

        .contact-line a:hover {

            text-decoration: underline;

        }


        /* =====================================================
           RESUME SECTIONS
        ===================================================== */

        .resume-section {

            margin-bottom: 20px;

        }

        .resume-section h4 {

            font-size: 15px;

            text-transform: uppercase;

            letter-spacing: 1px;

            color: #006f5a;

            border-bottom:
                2px solid #b8d8d0;

            padding-bottom: 6px;

            margin-bottom: 10px;

            font-weight: 800;

        }

        .resume-section p {

            font-size: 12px;

            line-height: 1.6;

            margin-bottom: 5px;

            color: #333333;

        }

        .resume-item {

            margin-bottom: 12px;

        }

        .resume-item strong {

            font-size: 13px;

            color: #111111;

            font-weight: 700;

        }

        .resume-item small {

            color: #555555;

        }


        /* =====================================================
           SKILLS
        ===================================================== */

        .skill-list {

            display: flex;

            flex-wrap: wrap;

            gap: 6px;

        }

        .skill {

            background: #e8f5f2;

            color: #006f5a;

            padding: 5px 9px;

            border-radius: 5px;

            font-size: 11px;

            font-weight: 700;

            border:
                1px solid #c8e5dd;

        }


        /* =====================================================
           RESUME CERTIFICATES
        ===================================================== */

        .resume-certificate {

            width: 100%;

            max-height: 230px;

            object-fit: contain;

            border:
                1px solid #dceae6;

            border-radius: 6px;

            margin-bottom: 10px;

            display: block;

        }


        /* =====================================================
           LATEST JOBS SECTION
        ===================================================== */

        .latest-jobs-section {

            margin-top: 60px;

            padding: 40px 0;

            border-top:
                1px solid #285e51;

        }

        .jobs-heading {

            text-align: center;

            margin-bottom: 10px;

        }

        .jobs-heading h2 {

            font-size: 28px;

            font-weight: 800;

            color: #00c49c;

            margin-bottom: 8px;

        }

        .jobs-heading p {

            color:
                rgba(255,255,255,.65);

            margin-bottom: 30px;

        }


        /* =====================================================
           JOB CARD
        ===================================================== */

        .job-card {

            background:
                linear-gradient(
                    145deg,
                    #07100d,
                    #0a1713
                );

            border:
                1px solid #285e51;

            border-radius: 15px;

            padding: 22px;

            height: 100%;

            transition:
                transform .3s ease,
                border-color .3s ease,
                box-shadow .3s ease;

            position: relative;

            overflow: hidden;

        }

        .job-card::before {

            content: "";

            position: absolute;

            top: 0;

            left: 0;

            width: 100%;

            height: 3px;

            background:
                linear-gradient(
                    90deg,
                    #008c70,
                    #00c49c
                );

        }

        .job-card:hover {

            transform:
                translateY(-6px);

            border-color:
                #00c49c;

            box-shadow:
                0 10px 30px
                rgba(0,196,156,.12);

        }


        /* =====================================================
           JOB COMPANY ICON
        ===================================================== */

        .company-icon {

            width: 48px;

            height: 48px;

            border-radius: 12px;

            display: flex;

            align-items: center;

            justify-content: center;

            background:
                rgba(0,196,156,.12);

            border:
                1px solid
                rgba(0,196,156,.25);

            color: #00c49c;

            font-size: 22px;

            margin-bottom: 15px;

        }


        .job-title {

            color: #ffffff;

            font-size: 18px;

            font-weight: 700;

            margin-bottom: 5px;

        }

        .company-name {

            color: #00c49c;

            font-size: 14px;

            font-weight: 600;

            margin-bottom: 14px;

        }


        .job-info {

            display: flex;

            flex-wrap: wrap;

            gap: 8px;

            margin-bottom: 15px;

        }

        .job-info span {

            background:
                #101d19;

            border:
                1px solid #285e51;

            color:
                rgba(255,255,255,.75);

            border-radius: 6px;

            padding: 5px 8px;

            font-size: 11px;

        }

        .job-info i {

            color: #00c49c;

            margin-right: 3px;

        }


        .job-description {

            font-size: 12px;

            line-height: 1.6;

            color:
                rgba(255,255,255,.62);

            min-height: 58px;

        }


        .job-skills {

            display: flex;

            flex-wrap: wrap;

            gap: 5px;

            margin: 14px 0;

        }

        .job-skill {

            color: #00c49c;

            background:
                rgba(0,196,156,.08);

            border:
                1px solid
                rgba(0,196,156,.18);

            padding: 4px 7px;

            border-radius: 5px;

            font-size: 10px;

            font-weight: 600;

        }


        .apply-btn {

            display: block;

            width: 100%;

            text-align: center;

            text-decoration: none;

            background: #008c70;

            color: white;

            border-radius: 8px;

            padding: 9px 12px;

            font-size: 13px;

            font-weight: 700;

            margin-top: 15px;

            transition: .3s;

        }

        .apply-btn:hover {

            background: #00a886;

            color: white;

            transform: translateY(-2px);

        }


        /* =====================================================
           JOB STATUS
        ===================================================== */

        .job-status {

            position: absolute;

            top: 15px;

            right: 15px;

            background:
                rgba(0,196,156,.12);

            color: #00c49c;

            border:
                1px solid
                rgba(0,196,156,.25);

            padding: 4px 8px;

            border-radius: 20px;

            font-size: 10px;

            font-weight: 700;

        }


        /* =====================================================
           VIEW ALL JOBS
        ===================================================== */

        .view-all-jobs {

            display: inline-flex;

            align-items: center;

            gap: 7px;

            margin-top: 30px;

            color: #00c49c;

            text-decoration: none;

            font-weight: 700;

            border:
                1px solid #285e51;

            padding: 10px 18px;

            border-radius: 8px;

            transition: .3s;

        }

        .view-all-jobs:hover {

            color: white;

            background: #008c70;

            border-color: #008c70;

        }


        /* =====================================================
           FOOTER
        ===================================================== */

        .footer {

            text-align: center;

            padding: 30px;

            color:
                rgba(255,255,255,.45);

            font-size: 13px;

            border-top:
                1px solid #285e51;

            margin-top: 30px;

        }


        /* =====================================================
           MOBILE
        ===================================================== */

        @media(max-width: 992px) {

            .preview-container {

                position: static;

                margin-top: 30px;

            }

        }


        @media(max-width: 576px) {

            .builder-card {

                padding: 20px;

            }

            .resume-paper {

                padding: 25px;

            }

            .page-header h1 {

                font-size: 26px;

            }

            .preview-header {

                flex-direction: column;

                align-items: stretch;

                gap: 10px;

            }

            .print-btn {

                width: 100%;

            }

            .resume-name {

                font-size: 24px;

            }

            .jobs-heading h2 {

                font-size: 24px;

            }

        }


        /* =====================================================
           PRINT
        ===================================================== */

        @media print {

            body {

                background: white !important;

            }

            .navbar-custom,
            .page-header,
            .builder-section,
            .preview-header,
            .latest-jobs-section,
            .footer {

                display: none !important;

            }

            .main-container {

                margin: 0;

                padding: 0;

                max-width: 100%;

            }

            .preview-container {

                position: static;

            }

            .resume-paper {

                background: white !important;

                box-shadow: none;

                border: none;

                min-height: auto;

                width: 100%;

                border-radius: 0;

                color: #222222 !important;

            }

            .resume-name {

                color: #006f5a !important;

            }

            .resume-role,
            .contact-line,
            .resume-section p {

                color: #333333 !important;

            }

            .resume-section h4 {

                color: #006f5a !important;

            }

            .resume-item strong {

                color: #111111 !important;

            }

            .resume-item small {

                color: #555555 !important;

            }

            .contact-line a {

                color: #006f5a !important;

            }

        }

    </style>

</head>


<body>


<!-- =====================================================
     NAVBAR
===================================================== -->

<nav class="navbar-custom">

    <div class="container">

        <div
            class="d-flex
                   justify-content-between
                   align-items-center">

            <a
                href="/dashboard"
                class="brand">

                Placement<span></span>

            </a>


            <div
                class="d-flex
                       gap-3
                       align-items-center">

                <a
                    href="/dashboard"
                    class="nav-link d-none d-md-block">

                    Dashboard

                </a>

                <a
                    href="#latestJobs"
                    class="nav-link d-none d-md-block">

                    Latest Jobs

                </a>

                <a
                    href="/coding"
                    class="nav-link d-none d-md-block">

                    Coding

                </a>
<a
    href="/profile"
    class="profile-btn">

    <i class="bi bi-person-circle"></i>
    Profile

</a>
  

            </div>

        </div>

    </div>

</nav>


<!-- =====================================================
     PAGE HEADER
===================================================== -->

<section class="page-header">

    <div class="container">

        <h1>

            📄 Professional Resume Builder

        </h1>

        <p>

            Create a professional resume for your
            placement and job applications.

        </p>

    </div>

</section>


<!-- =====================================================
     MAIN
===================================================== -->

<div class="main-container">

    <div class="row g-4">


        <!-- =================================================
             LEFT FORM
        ================================================= -->

        <div class="col-lg-6">

            <div
                class="builder-card
                       builder-section">


                <!-- PERSONAL -->

                <div class="section-title">

                    <i class="bi bi-person"></i>

                    Personal Information

                </div>


                <div class="row g-3">


                    <div class="col-md-6">

                        <label class="form-label">

                            Full Name *

                        </label>

                        <input
                            type="text"
                            id="name"
                            class="form-control"
                            placeholder="Your full name">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            Professional Title

                        </label>

                        <input
                            type="text"
                            id="role"
                            class="form-control"
                            placeholder="Software Engineer">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            Email *

                        </label>

                        <input
                            type="email"
                            id="email"
                            class="form-control"
                            placeholder="your@email.com">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            Phone *

                        </label>

                        <input
                            type="text"
                            id="phone"
                            class="form-control"
                            placeholder="+91 XXXXX XXXXX">

                    </div>


                    <div class="col-12">

                        <label class="form-label">

                            Location

                        </label>

                        <input
                            type="text"
                            id="location"
                            class="form-control"
                            placeholder="City, State, India">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            <i class="bi bi-linkedin"></i>

                            LinkedIn Profile

                        </label>

                        <input
                            type="url"
                            id="linkedin"
                            class="form-control"
                            placeholder="https://linkedin.com/in/yourname">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            <i class="bi bi-github"></i>

                            GitHub Profile

                        </label>

                        <input
                            type="url"
                            id="github"
                            class="form-control"
                            placeholder="https://github.com/yourusername">

                        <small class="text-muted">

                            Add your GitHub profile link

                        </small>

                    </div>

                </div>


                <!-- OBJECTIVE -->

                <div class="section-title mt-4">

                    <i class="bi bi-bullseye"></i>

                    Career Objective

                </div>


                <textarea
                    id="objective"
                    class="form-control"
                    placeholder="Write a short professional career objective..."></textarea>


                <!-- EDUCATION -->

                <div class="section-title mt-4">

                    <i class="bi bi-mortarboard"></i>

                    Education

                </div>


                <div class="mb-3">

                    <label class="form-label">

                        Degree

                    </label>

                    <input
                        type="text"
                        id="degree"
                        class="form-control"
                        placeholder="B.E. Computer Science">

                </div>


                <div class="row g-3">


                    <div class="col-md-6">

                        <label class="form-label">

                            College

                        </label>

                        <input
                            type="text"
                            id="college"
                            class="form-control"
                            placeholder="College Name">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            Graduation Year

                        </label>

                        <input
                            type="text"
                            id="year"
                            class="form-control"
                            placeholder="2027">

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">

                            CGPA / Percentage

                        </label>

                        <input
                            type="text"
                            id="cgpa"
                            class="form-control"
                            placeholder="8.5 CGPA">

                    </div>

                </div>


                <!-- SKILLS -->

                <div class="section-title mt-4">

                    <i class="bi bi-code-slash"></i>

                    Technical Skills

                </div>


                <label class="form-label">

                    Skills

                </label>


                <input
                    type="text"
                    id="skills"
                    class="form-control"
                    placeholder="Python, Java, SQL, HTML, CSS, Power BI">


                <small class="text-muted">

                    Separate skills using commas.

                </small>


                <!-- EXPERIENCE -->

                <div class="section-title mt-4">

                    <i class="bi bi-briefcase"></i>

                    Internship / Experience

                </div>


                <input
                    type="text"
                    id="experienceTitle"
                    class="form-control mb-3"
                    placeholder="Software Development Intern">


                <input
                    type="text"
                    id="experienceCompany"
                    class="form-control mb-3"
                    placeholder="Company Name">


                <textarea
                    id="experienceDescription"
                    class="form-control"
                    placeholder="Describe your work, responsibilities and achievements..."></textarea>


                <!-- PROJECT -->

                <div class="section-title mt-4">

                    <i class="bi bi-folder"></i>

                    Projects

                </div>


                <input
                    type="text"
                    id="projectName"
                    class="form-control mb-3"
                    placeholder="Project Name">


                <textarea

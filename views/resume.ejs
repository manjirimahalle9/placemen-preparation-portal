<script>


/* =====================================================
   GET VALUE
===================================================== */

function getValue(id, defaultValue = "") {

    const element =
        document.getElementById(id);

    if (!element) {

        return defaultValue;

    }

    return (
        element.value.trim()
        || defaultValue
    );

}


/* =====================================================
   GENERATE / UPDATE RESUME
===================================================== */

function generateResume() {


    /* =================================================
       PERSONAL INFORMATION
    ================================================= */

    document.getElementById(
        "previewName"
    ).textContent =

        getValue(
            "name",
            "Your Name"
        );


    document.getElementById(
        "previewRole"
    ).textContent =

        getValue(
            "role",
            "Your Professional Title"
        );


    document.getElementById(
        "previewEmail"
    ).textContent =

        getValue(
            "email",
            "your@email.com"
        );


    document.getElementById(
        "previewPhone"
    ).textContent =

        getValue(
            "phone",
            "+91 XXXXX XXXXX"
        );


    document.getElementById(
        "previewLocation"
    ).textContent =

        getValue(
            "location",
            "City, India"
        );


    /* =================================================
       LINKEDIN
    ================================================= */

    const linkedin =
        getValue(
            "linkedin",
            ""
        );


    const linkedinElement =
        document.getElementById(
            "previewLinkedin"
        );


    if (linkedin) {

        linkedinElement.href =
            linkedin;

        linkedinElement.textContent =
            "LinkedIn Profile";

    }

    else {

        linkedinElement.removeAttribute(
            "href"
        );

        linkedinElement.textContent =
            "LinkedIn";

    }


    /* =================================================
       GITHUB
    ================================================= */

    const github =
        getValue(
            "github",
            ""
        );


    const githubElement =
        document.getElementById(
            "previewGithub"
        );


    if (github) {

        githubElement.href =
            github;

        githubElement.textContent =
            "GitHub Profile";

    }

    else {

        githubElement.removeAttribute(
            "href"
        );

        githubElement.textContent =
            "GitHub";

    }


    /* =================================================
       CAREER OBJECTIVE
    ================================================= */

    document.getElementById(
        "previewObjective"
    ).textContent =

        getValue(
            "objective",
            "A motivated student seeking opportunities to apply technical and problem-solving skills in a professional environment."
        );


    /* =================================================
       EDUCATION
    ================================================= */

    document.getElementById(
        "previewDegree"
    ).textContent =

        getValue(
            "degree",
            "B.E. / B.Tech"
        );


    document.getElementById(
        "previewCollege"
    ).textContent =

        getValue(
            "college",
            "College Name"
        );


    document.getElementById(
        "previewYear"
    ).textContent =

        getValue(
            "year",
            "2027"
        );


    document.getElementById(
        "previewCgpa"
    ).textContent =

        getValue(
            "cgpa",
            "CGPA"
        );


    /* =================================================
       SKILLS
    ================================================= */

    const skills =
        getValue(
            "skills",
            "Python, SQL, HTML, CSS"
        );


    const skillArray =
        skills
            .split(",")
            .map(
                skill =>
                    skill.trim()
            )
            .filter(
                skill =>
                    skill !== ""
            );


    const skillContainer =
        document.getElementById(
            "previewSkills"
        );


    skillContainer.innerHTML =
        "";


    skillArray.forEach(
        skill => {

            const span =
                document.createElement(
                    "span"
                );

            span.className =
                "skill";

            span.textContent =
                skill;

            skillContainer.appendChild(
                span
            );

        }
    );


    /* =================================================
       EXPERIENCE
    ================================================= */

    document.getElementById(
        "previewExperienceTitle"
    ).textContent =

        getValue(
            "experienceTitle",
            "Internship / Experience"
        );


    document.getElementById(
        "previewExperienceCompany"
    ).textContent =

        getValue(
            "experienceCompany",
            "Company Name"
        );


    document.getElementById(
        "previewExperienceDescription"
    ).textContent =

        getValue(
            "experienceDescription",
            "Describe your professional experience here."
        );


    /* =================================================
       PROJECT
    ================================================= */

    document.getElementById(
        "previewProjectName"
    ).textContent =

        getValue(
            "projectName",
            "Project Name"
        );


    document.getElementById(
        "previewProjectDescription"
    ).textContent =

        getValue(
            "projectDescription",
            "Describe your project and technologies used."
        );


    /* =================================================
       CERTIFICATIONS
    ================================================= */

    const certifications =
        getValue(
            "certifications",
            "Add your certifications here."
        );


    const certificationContainer =
        document.getElementById(
            "previewCertifications"
        );


    certificationContainer.innerHTML =
        "";


    certifications
        .split("\n")
        .filter(
            item =>
                item.trim() !== ""
        )
        .forEach(
            item => {

                const p =
                    document.createElement(
                        "p"
                    );

                p.textContent =
                    "• " +
                    item.trim();

                certificationContainer
                    .appendChild(p);

            }
        );


    /* =================================================
       ACHIEVEMENTS
    ================================================= */

    const achievements =
        getValue(
            "achievements",
            "Add your achievements here."
        );


    const achievementContainer =
        document.getElementById(
            "previewAchievements"
        );


    achievementContainer.innerHTML =
        "";


    achievements
        .split("\n")
        .filter(
            item =>
                item.trim() !== ""
        )
        .forEach(
            item => {

                const p =
                    document.createElement(
                        "p"
                    );

                p.textContent =
                    "• " +
                    item.trim();

                achievementContainer
                    .appendChild(p);

            }
        );

}


/* =====================================================
   LIVE RESUME PREVIEW
===================================================== */

const formFields = [

    "name",
    "role",
    "email",
    "phone",
    "location",
    "linkedin",
    "github",
    "objective",
    "degree",
    "college",
    "year",
    "cgpa",
    "skills",
    "experienceTitle",
    "experienceCompany",
    "experienceDescription",
    "projectName",
    "projectDescription",
    "certifications",
    "achievements"

];


formFields.forEach(
    id => {

        const element =
            document.getElementById(id);

        if (element) {

            element.addEventListener(
                "input",
                generateResume
            );

        }

    }
);


/* =====================================================
   CERTIFICATE IMAGE PREVIEW
===================================================== */

function previewCertificates() {

    const input =
        document.getElementById(
            "certificateImages"
        );


    const uploadPreview =
        document.getElementById(
            "certificatePreview"
        );


    const resumePreview =
        document.getElementById(
            "resumeCertificatePreview"
        );


    uploadPreview.innerHTML =
        "";


    resumePreview.innerHTML =
        "";


    const files =
        input.files;


    if (
        !files ||
        files.length === 0
    ) {

        return;

    }


    for (
        let i = 0;
        i < files.length;
        i++
    ) {


        const file =
            files[i];


        if (
            !file.type.startsWith(
                "image/"
            )
        ) {

            continue;

        }


        const reader =
            new FileReader();


        reader.onload =
            function(event) {


                /* =====================================
                   UPLOAD PREVIEW CARD
                ===================================== */

                const uploadCard =
                    document.createElement(
                        "div"
                    );


                uploadCard.className =
                    "certificate-card";


                const image =
                    document.createElement(
                        "img"
                    );


                image.src =
                    event.target.result;


                image.alt =
                    "Certificate";


                const name =
                    document.createElement(
                        "div"
                    );


                name.className =
                    "certificate-name";


                name.textContent =
                    file.name;


                uploadCard.appendChild(
                    image
                );


                uploadCard.appendChild(
                    name
                );


                uploadPreview.appendChild(
                    uploadCard
                );


                /* =====================================
                   RESUME PREVIEW IMAGE
                ===================================== */

                const resumeImage =
                    document.createElement(
                        "img"
                    );


                resumeImage.src =
                    event.target.result;


                resumeImage.alt =
                    "Certificate";


                resumeImage.className =
                    "resume-certificate";


                resumePreview.appendChild(
                    resumeImage
                );

            };


        reader.readAsDataURL(
            file
        );

    }

}


/* =====================================================
   INITIAL RESUME PREVIEW
===================================================== */

document.addEventListener(
    "DOMContentLoaded",
    function() {

        generateResume();

    }
);

</script>


